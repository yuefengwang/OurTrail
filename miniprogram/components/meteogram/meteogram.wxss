/* meteogram：天气时间坐标图。canvas 是原生组件，宽度由数据算出并横向滚动。 */
.meteogram { width: 100%; }
.meteogram-scroll {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
}
.meteogram-canvas { display: block; }

.meteogram-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 10px;
  margin-top: 8px;
}
/* 图例 = 色块 + 中性色文字。
   原来整条 pill 都用语义色当文字色，"黄金" #D6A33C 压在 --forest-soft 上
   对比度不足（截图里那两个字几乎没了）；改成色块承担颜色、文字保持 --ink。 */
.lg {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  color: var(--ink);
}
.lg-dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  flex: none;
}
.lg-text { line-height: 16px; }
.lg-tip {
  margin-left: auto;
  font-size: 10px;
  color: var(--muted);
}

<view class="meteogram">
  <scroll-view class="meteogram-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <canvas
      type="2d"
      id="meteo"
      class="meteogram-canvas"
      style="width:{{chartW}}px;height:{{chartH}}px;"
      bindtap="onTap"
    ></canvas>
  </scroll-view>
  <view class="meteogram-legend">
    <view class="lg" wx:for="{{legend}}" wx:key="k">
      <view class="lg-dot" style="background:{{item.c}};"></view>
      <text class="lg-text">{{item.t}}</text>
    </view>
    <text class="lg-tip">{{legendTip}}</text>
  </view>
</view>

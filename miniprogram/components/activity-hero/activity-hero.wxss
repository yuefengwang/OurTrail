/* 活动详情首屏组件：只做「封面全出血 + 标题抬进照片下沿」这几条页面级微调。
   全局 .hero-cover 仍由 app.wxss 定义（路线库详情等页共用），这里只加作用域覆盖。 */
.act-hero.hero-cover {
  border-radius: 0;
}

.act-hero.hero-cover .hero-cover-media {
  height: 216px;
}

.act-hero.hero-cover .hero-cover-body {
  margin-top: -72px;
  padding-bottom: 28px;
  gap: 8px;
}

.act-hero__meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.act-hero__route {
  font-size: var(--text-body);
  line-height: 20px;
  color: var(--on-forest-muted);
}
.act-hero .display { font-size: 24px; line-height: 32px; }

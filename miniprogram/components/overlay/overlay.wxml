<view wx:if="{{rendered}}" class="overlay-root {{open ? 'open' : ''}}">
  <view class="overlay-mask" catchtap="onMaskTap" catchtouchmove="noop"></view>
  <view class="overlay {{kind === 'sheet' ? 'overlay--sheet' : 'overlay--dialog'}}" catchtap="noop" catchtouchmove="noop" animation-end="noop">
    <view wx:if="{{kind === 'sheet'}}" class="overlay__handle"></view>
    <view class="overlay__header">
      <text class="overlay__title">{{title}}</text>
      <view class="icon-button" hover-class="button-hover" bindtap="onCloseTap">
        <icon name="close" size="22" color="#163E35" />
      </view>
    </view>
    <scroll-view class="overlay__body" scroll-y enhanced show-scrollbar="{{false}}">
      <slot />
    </scroll-view>
  </view>
</view>

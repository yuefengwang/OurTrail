.route-profile {
  width: 100%;
}
.profile-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}
.profile-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
}
.profile-range {
  font-size: 12px;
  color: var(--muted);
  flex: 0 0 auto;
}
.profile-img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
  background: var(--surface);
}
.profile-foot {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-top: 8px;
}
.profile-empty {
  padding: 12px 0;
}

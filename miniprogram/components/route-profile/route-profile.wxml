<view class="route-profile" aria-label="路线海拔剖面">
  <view wx:if="{{src}}" class="profile-head">
    <text wx:if="{{title}}" class="profile-title">{{title}}</text>
    <text class="profile-range tabular">{{rangeText}}</text>
  </view>
  <image wx:if="{{src}}" class="profile-img" src="{{src}}" mode="widthFix" />
  <view wx:if="{{src}}" class="profile-foot">
    <text class="small muted tabular">{{distanceText}}</text>
    <text class="small muted">{{note}}</text>
  </view>
  <view wx:else class="profile-empty">
    <text class="small muted">{{emptyText}}</text>
  </view>
</view>

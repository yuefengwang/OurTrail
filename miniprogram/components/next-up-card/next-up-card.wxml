<!-- 有未来活动：眉题 + 活动名 + 一行事实（日期 · 剩余 · 人数）；整卡可点，卡内无实心按钮。 -->
<view wx:if="{{empty}}" class="next-up-card next-up-card--invite">
  <text class="next-up-card__kicker">还没有安排</text>
  <text class="next-up-card__title">从一场短途开始。</text>
  <text class="next-up-card__detail">选一条路线、定好时间，把同行的朋友叫上。</text>
  <view class="button primary next-up-card__cta" hover-class="button-hover" bindtap="onCreate">
    <text>发起活动</text>
  </view>
</view>
<view wx:else class="next-up-card" hover-class="next-up-card--pressed" bindtap="onOpen">
  <text class="next-up-card__kicker">下一次同行</text>
  <text class="next-up-card__title">{{title}}</text>
  <view wx:if="{{facts.length}}" class="next-up-card__facts">
    <block wx:for="{{facts}}" wx:key="*this">
      <text wx:if="{{index}}" class="next-up-card__dot">·</text>
      <text class="next-up-card__fact">{{item}}</text>
    </block>
  </view>
</view>

/* 「下一次同行」卡：照片 hero + 压底文字（2026-10-26 style-B）。
   照片是场景氛围图（utils/covers.js 按活动 id 稳定选取），非活动实拍。
   反向的空态卡退回白卡 + 细线：它邀请的是「还没有安排」这件事，不该抢列表卡片的焦点。
   全部色值走既有 token，零新增。 */
.next-up-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 16px 18px;
  border-radius: var(--radius-card);
  background: var(--forest-deep);
  color: var(--white);
}
.next-up-card--pressed { opacity: 0.9; }

/* 照片分支：定高 hero（320），文字压在下沿；图片与 scrim 绝对定位，正文 relative 叠在上面。
   图片失败由模板整个摘掉（coverFailed），露出下面的森林底，文字仍然可读。 */
.next-up-card--photo {
  position: relative;
  justify-content: flex-end;
  min-height: 320px;
  padding: 20px;
  overflow: hidden;
}
.next-up-card__cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: block;
  width: 100%;
  height: 100%;
}
.next-up-card__scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--scrim-hero);
  pointer-events: none;
}
.next-up-card__body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.next-up-card__kicker {
  font-size: 11px;
  line-height: 16px;
  font-weight: 600;
  letter-spacing: 1.2px;
  color: var(--on-forest-muted);
}
.next-up-card__title {
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
  letter-spacing: -0.3px;
  overflow-wrap: anywhere;
}
.next-up-card__facts {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--on-forest-muted);
}
.next-up-card__fact { flex: 0 0 auto; }
.next-up-card__dot { padding: 0 6px; color: var(--on-forest-line); }

.next-up-card--invite {
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
}
.next-up-card--invite .next-up-card__kicker { color: var(--muted); }
.next-up-card__detail { font-size: var(--text-body); line-height: 22px; color: var(--muted); }
.next-up-card__cta { margin-top: 8px; }

.next-up-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 16px 18px;
  border-radius: var(--radius-card);
  background: var(--forest-deep);
  color: var(--white);
}
.next-up-card--pressed { opacity: 0.9; }

.next-up-card--photo {
  position: relative;
  justify-content: flex-end;
  min-height: 280px;
  padding: 100px 20px 32px;
  box-sizing: border-box;
  overflow: hidden;
}
.next-up-card__cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: block;
  width: 100%;
  height: 100%;
}
.next-up-card__scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--scrim-hero);
  pointer-events: none;
}
.next-up-card__body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.next-up-card__kicker {
  font-size: var(--text-caption);
  line-height: 18px;
  font-weight: 600;
  letter-spacing: 1.2px;
  color: var(--on-forest-muted);
}
.next-up-card__title {
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
  letter-spacing: -0.3px;
  overflow-wrap: anywhere;
}
.next-up-card__facts {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--on-forest-muted);
}
.next-up-card__fact { flex: 0 0 auto; }
.next-up-card__dot { padding: 0 6px; color: var(--on-forest-line); }

.next-up-card--invite {
  padding: 0;
  gap: 0;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
}
.next-up-card--invite .next-up-card__kicker { color: var(--muted); }
.next-up-card--invite .next-up-card__title { font-size: 22px; line-height: 30px; }
.next-up-card__detail { font-size: var(--text-body); line-height: 22px; color: var(--muted); }
.next-up-card__invite-media { position: relative; height: 180px; background: var(--forest-deep); }
.next-up-card__invite-caption { position: absolute; left: 20px; right: 20px; bottom: 16px; display: flex; justify-content: space-between; align-items: baseline; gap: 8px; color: var(--white); font-size: var(--text-title); font-weight: 600; }
.next-up-card__photo-note { color: var(--on-forest-muted); font-size: var(--text-caption); font-weight: 400; }
.next-up-card__invite-content { display: flex; flex-direction: column; gap: 8px; padding: 20px; }
.next-up-card__invite-actions { display: flex; gap: 8px; margin-top: 8px; }
.next-up-card__invite-actions .button { flex: 1; min-width: 0; padding-left: 8px; padding-right: 8px; }
.next-up-card__invite-note { display: flex; align-items: flex-start; gap: 8px; margin-top: 12px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-caption); line-height: 20px; }
.next-up-card__invite-note icon { flex-shrink: 0; }
.next-up-card__eyeline { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.next-up-card__link { color: var(--on-forest-muted); font-size: var(--text-caption); line-height: 18px; }

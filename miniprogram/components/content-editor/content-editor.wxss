/* 连续正文 + 图片组：不再为每个段落/图片生成一张常驻操作卡。 */
.ce {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ce-body {
  min-height: 168px;
  border: 1px solid var(--line);
  line-height: 1.7;
}

.ce-body.is-focused {
  border-color: var(--forest);
}

.ce-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}

.ce-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--paper);
}

.ce-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.ce-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ce-cell {
  position: relative;
  width: 100%;
}

.ce-grid.double .ce-cell { width: calc((100% - 8px) / 2); }
.ce-grid.triple .ce-cell { width: calc((100% - 16px) / 3); }

.ce-thumb {
  display: block;
  width: 100%;
  height: 180px;
  border-radius: 8px;
  background: var(--stone);
}

.ce-grid.double .ce-thumb { height: 120px; }
.ce-grid.triple .ce-thumb { height: 96px; }

/* 删除是低频动作，但入口必须可见：36px 内联控件（缩略图角标），不占用常驻工具条。 */
.ce-remove {
  position: absolute;
  top: 6px;
  right: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--forest);
  color: var(--paper);
  font-size: 22px;
  font-weight: 600;
  line-height: 1;
}

.ce-cover-mark {
  position: absolute;
  left: 6px;
  bottom: 6px;
  padding: 2px 8px;
  border-radius: var(--radius-tag);
  background: var(--forest);
  color: var(--paper);
  font-size: var(--text-caption);
  line-height: 18px;
  font-weight: 600;
}

.ce-manage {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding-top: 4px;
  border-top: 1px solid var(--line);
}

.ce-cover-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}

.ce-cover-thumb {
  width: 48px;
  height: 48px;
  border-radius: 8px;
  background: var(--stone);
  flex: 0 0 auto;
}

.ce-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--line);
  color: var(--muted);
  font-size: var(--text-caption);
  font-weight: 600;
  background: var(--paper);
  box-sizing: border-box;
}

.ce-cover-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}

.ce-cover-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ce-cover-choice {
  width: calc((100% - 16px) / 3);
  height: 96px;
  padding: 2px;
  border: 2px solid transparent;
  border-radius: 10px;
  box-sizing: border-box;
}

.ce-cover-choice.on {
  border-color: var(--forest);
}

.ce-cover-choice-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 6px;
  background: var(--stone);
}

.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex; align-items: flex-end; justify-content: center;
  z-index: 9999;
}
.sheet {
  width: 100%;
  background: #fffdf7;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.title { font-size: 34rpx; font-weight: 800; color: #164f3d; }
.body { font-size: 27rpx; color: #17231d; line-height: 1.7; margin: 24rpx 0 32rpx; }
.link { color: #466b7f; }
.row { display: flex; gap: 16rpx; }
.btn {
  display: flex; align-items: center; justify-content: center;
  min-height: 80rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 700;
  box-sizing: border-box; padding: 0 24rpx;
}
.btn::after { border: none; }
.btn-primary { background: #164f3d; color: #fff; }
.btn-ghost { background: transparent; color: #164f3d; border: 1rpx solid #164f3d; }
.grow { flex: 1; }

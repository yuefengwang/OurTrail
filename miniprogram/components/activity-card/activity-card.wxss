/* 活动卡：图 + 标题 / chips / foot 三槽（2026-10-26 style-B）。
   全局 token 在 app.wxss；这里只放卡片自身布局，色值一律引用 token，不抄字面量。 */
.card-hover { opacity: 0.9; }

/* ---- featured：定高媒体盒（文档流图片，最稳的绘制路径）+ 森林底信息区 ---- */
.activity-card--featured {
  position: relative;
  overflow: hidden;
  padding: 0;
  background: var(--forest-deep);
  border-color: var(--forest-deep);
}
.activity-card__media {
  position: relative;
  height: 152px;
  overflow: hidden;
  background: var(--forest-deep);
}
.activity-card__cover {
  display: block;
  width: 100%;
  height: 100%;
}
.activity-card__scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--scrim-hero);
  pointer-events: none;
}
.activity-card__cover-body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 16px;
  box-sizing: border-box;
}
.activity-card--featured .activity-card__title { font-size: 22px; line-height: 1.35; letter-spacing: -0.3px; }
.activity-card--featured .activity-card__date { color: var(--on-forest-muted); }
.activity-card--featured .activity-card__sub { color: var(--on-forest-muted); }
.activity-card--featured .activity-card__chips { color: var(--on-forest-muted); }
.activity-card--featured .activity-card__foot { color: var(--on-forest-muted); }

/* ---- 普通卡：完整照片形态（未传 compact 的旧消费者） ---- */
.activity-card.activity-card--plain { padding: 0; gap: 0; overflow: hidden; }
/* 普通卡媒体 200（2026-10-26 style-B，168→200）：与 featured 同一个「图占上半」的比例语言 */
.activity-card--plain .activity-card__media { height: 200px; background: var(--stone); }
.activity-card__plain { display: flex; flex-direction: column; gap: 8px; padding: 12px 16px 16px; }

.activity-card.activity-card--compact { padding: 12px; gap: 10px; }
.activity-card--compact .activity-card__plain { padding: 0; gap: 10px; }
.activity-card__head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
}
.activity-card__thumb {
  position: relative;
  flex: 0 0 64px;
  width: 64px;
  height: 76px;
  overflow: hidden;
  border-radius: var(--radius-button);
  background: var(--stone);
}
.activity-card__thumb .activity-card__cover { width: 100%; height: 100%; }
.activity-card__heading {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 0;
}
/* 标题保持全局 18px/600（style-B 不降档）：紧凑列只有 ~250px，行高从 1.5 收到 24px
   换一行字的空间，字重与字号不动。 */
.activity-card__heading .activity-card__title { font-size: var(--text-title); line-height: 24px; letter-spacing: -0.2px; }
.activity-card__titlebar {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  min-width: 0;
}
.activity-card__titlebar .activity-card__title { flex: 1; min-width: 0; }
.activity-card__status { flex: 0 0 auto; margin-top: 0; }

.activity-card.activity-card--flat {
  border: 0;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  padding: 16px 0;
}
.activity-card--flat .activity-card__head { align-items: stretch; }
.activity-card--flat .activity-card__thumb {
  flex-basis: 104px;
  width: 104px;
  height: auto;
  min-height: 128px;
  border-radius: var(--radius-card);
}
.activity-card--flat .activity-card__thumb .activity-card__cover {
  position: absolute;
  top: 0;
  left: 0;
}

.activity-card__chips {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 2px 0;
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--muted);
}
.activity-card__chip { flex: 0 0 auto; }
.activity-card__dot { flex: 0 0 auto; padding: 0 6px; color: var(--line); }
.activity-card--featured .activity-card__dot { color: var(--on-forest-line); }

/* sub 行：路线名；长文本断行不截断（与标题同款策略）。 */
.activity-card__sub { overflow-wrap: anywhere; }

/* foot：左「与活动的关系」细字，右人数。两边都缺时整行不出现（由模板判）。 */
.activity-card__foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--muted);
}
.activity-card__role { flex: 0 0 auto; }
.activity-card__count { margin-left: auto; text-align: right; }

/* ---- 协作入口 ----
   卡片整体可点，不再在卡内重复「查看活动安排」实心入口；leaf 只留给这些卡内子目的地。
   触控目标读 token（44px），不硬编码。 */
.activity-card__affordance { flex-wrap: wrap; }
.collab-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.collab-leaf { flex: 0 0 auto; min-height: var(--touch-target); }

/* ---- 照片加载失败：藏起照片，退回纯色/纯文字形态 ---- */
.activity-card.cover-failed .activity-card__cover { display: none; }
/* 普通卡整块媒体消失 ⇒ 退回纯文字卡（不留 168px 空洞）；featured 仍留森林底纯色 hero */
.activity-card--plain.cover-failed .activity-card__media { display: none; }
/* 紧凑卡则连缩略图一起收起，让标题列占满整行。 */
.activity-card--compact.cover-failed .activity-card__thumb { display: none; }

<article class="card activity-card {{featured ? 'hero activity-card--featured' : ''}} {{coverFailed ? 'cover-failed' : ''}}" bindtap="onTap" hover-class="card-hover">
  <!-- 编辑式卡片（2026-10-16）：featured 用大幅封面照 + 压底，普通卡用左侧缩略图。
       照片是场景氛围图（utils/covers.js 按活动 id 稳定选取），非活动实拍；
       加载失败根节点加 cover-failed：featured 藏起照片退回纯色 hero，
       普通卡隐藏缩略图退回纯文字，都不出破图。 -->
  <block wx:if="{{featured}}">
    <view class="activity-card__media">
      <image class="activity-card__cover" src="{{coverSrc}}" mode="aspectFill" binderror="onCoverError" />
      <view class="activity-card__scrim" />
    </view>
    <view class="activity-card__cover-body hero-body">
      <view class="card-header activity-card__header">
        <text class="activity-card__date small tabular" id="date">{{date}}{{when ? ' · 出发 ' + when : ''}}</text>
        <text class="badge on-forest" id="status">{{status}}</text>
      </view>
      <view class="activity-card__title hero-body">{{title}}</view>
      <text class="activity-card__meta muted hero-body" id="meta">{{meta}}</text>
      <view wx:if="{{info}}" class="activity-card__info hero-body">{{info}}</view>
      <view class="activity-card__affordance">
        <view class="button leaf affordance-leaf affordance-open hero-body" aria-hidden="true">
          <text>查看活动安排</text>
          <icon name="arrow" size="18" color="#163E35" />
        </view>
        <!-- 协作入口：这个人在这场活动上欠下的事，一个角色一枚。用 catchtap 而不是 bindtap——
             卡片根节点自己 bindtap 打开活动，冒泡上去会变成「点车辆联络却进了详情页」。
             与主入口同一套 leaf 浅底样式：真机首轮实测 .button.text 的 --forest 深绿字
             压在 featured 的 --forest-deep 深绿底上几乎不可读（箭头字面量同样是深色），
             浅底 chip + 深字在两种卡上都成立。 -->
        <view wx:if="{{collab.length}}" class="collab-row">
          <view wx:for="{{collab}}" wx:key="key" class="button leaf collab-leaf" hover-class="button-hover"
            data-key="{{item.key}}" catchtap="onCollab">
            <text>{{item.label}}</text>
            <icon name="arrow" size="16" color="#163E35" />
          </view>
        </view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="activity-card__row">
      <image class="activity-card__thumb" src="{{coverSrc}}" mode="aspectFill" binderror="onCoverError" />
      <view class="activity-card__body">
        <view class="card-header activity-card__header">
          <text class="activity-card__date small tabular" id="date">{{date}}{{when ? ' · 出发 ' + when : ''}}</text>
          <text class="badge neutral" id="status">{{status}}</text>
        </view>
        <view class="activity-card__title">{{title}}</view>
        <text class="activity-card__meta muted" id="meta">{{meta}}</text>
      </view>
    </view>
    <view wx:if="{{info}}" class="activity-card__info">{{info}}</view>
    <view class="activity-card__affordance">
      <view class="button leaf affordance-leaf affordance-open hero-body" aria-hidden="true">
        <text>查看活动安排</text>
        <icon name="arrow" size="18" color="#163E35" />
      </view>
      <view wx:if="{{collab.length}}" class="collab-row">
        <view wx:for="{{collab}}" wx:key="key" class="button leaf collab-leaf" hover-class="button-hover"
          data-key="{{item.key}}" catchtap="onCollab">
          <text>{{item.label}}</text>
          <icon name="arrow" size="16" color="#163E35" />
        </view>
      </view>
    </view>
  </block>
</article>

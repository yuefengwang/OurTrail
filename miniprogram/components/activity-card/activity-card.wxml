<article class="card activity-card {{featured ? 'hero activity-card--featured' : ''}}" bindtap="onTap" hover-class="card-hover">
  <image wx:if="{{featured}}" class="trail-art" src="data:image/svg+xml;base64," mode="aspectFit" />
  <view class="card-header activity-card__header hero-body">
    <text class="activity-card__date small tabular" id="date">{{date}}</text>
    <text class="badge {{featured ? 'on-forest' : 'neutral'}}" id="status">{{status}}</text>
  </view>
  <view class="activity-card__title hero-body">{{title}}</view>
  <text class="activity-card__meta muted hero-body" id="meta">{{meta}}</text>
  <view wx:if="{{info}}" class="activity-card__info hero-body">{{info}}</view>
  <view class="activity-card__affordance {{featured ? 'button leaf affordance-leaf' : ''}} hero-body" aria-hidden="true">
    <text>查看活动安排</text>
    <icon name="arrow" size="18" color="{{featured ? '#163E35' : '#163E35'}}" />
  </view>
</article>

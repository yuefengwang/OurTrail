<overlay open="{{open}}" kind="sheet" title="补全同行资料" bind:close="onClose">
  <view class="stack">
    <text class="small muted">报名、发起活动和协作授权需要姓名与手机号。微信只会在你点击下方按钮时授权，不会后台读取。</text>

    <view wx:if="{{loading}}" class="profile-gate-loading">
      <text class="small muted">正在读取当前资料…</text>
    </view>
    <block wx:else>
      <view class="profile-gate-row">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="button-hover">
          <image wx:if="{{person.avatar}}" class="avatar-img" src="{{person.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar-fallback">
            <text>{{person.name ? person.name[0] : '我'}}</text>
          </view>
        </button>
        <view class="profile-gate-copy">
          <text class="field-label">头像</text>
          <text class="small muted">{{uploadingAvatar ? '正在上传头像…' : '点左侧使用微信头像，可稍后再换'}}</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">姓名 / 昵称</text>
        <input
          class="input"
          type="nickname"
          maxlength="80"
          value="{{person.name}}"
          data-key="name"
          bindinput="onField"
          placeholder="点这里可使用微信昵称"
        />
      </view>

      <view class="field">
        <text class="field-label">手机号</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          value="{{person.phone}}"
          data-key="phone"
          bindinput="onField"
          placeholder="用于报名联络与安全应急"
        />
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onPhoneCode" hover-class="button-hover">
          {{phoneLoading ? '正在获取…' : '用微信手机号'}}
        </button>
      </view>

      <view wx:if="{{error}}" class="callout danger">{{error}}</view>
      <view wx:if="{{hint}}" class="callout success">{{hint}}</view>

      <view class="form-actions">
        <view class="button text" hover-class="button-hover" bindtap="onClose">稍后再说</view>
        <view class="button primary {{saving ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{saving ? '' : 'onSave'}}" style="flex:1;">{{saving ? '正在保存…' : '保存并继续'}}</view>
      </view>
    </block>
  </view>
</overlay>

.profile-gate-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.avatar-btn {
  display: block;
  width: 64px;
  height: 64px;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  flex: 0 0 64px;
  overflow: hidden;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 64px; height: 64px; border-radius: 50%; }
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--forest-soft);
  color: var(--forest);
  font-size: 24px;
  font-weight: 600;
}
.profile-gate-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.phone-btn {
  align-self: flex-start;
  min-height: var(--touch-target);
  padding: 12px 0;
  margin-top: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--forest);
  font-size: 13px;
  font-weight: 600;
  line-height: 20px;
  text-align: left;
}
.phone-btn::after { border: none; }
.profile-gate-loading {
  padding: 12px 0;
}

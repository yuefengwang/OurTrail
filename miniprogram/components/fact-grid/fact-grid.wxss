/* 两列事实网格。仓库没有 display:grid，统一用 flex + calc 列宽（屏宽 306px 也放得下）。 */
.fact-grid {
  display: flex;
  flex-wrap: wrap;
}

.fact-cell {
  flex: 0 0 calc(50% - 6px);
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.fact-cell--wide {
  flex-basis: 100%;
}

.fact-cell__label {
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--muted);
}

.fact-cell__value-row {
  display: flex;
  align-items: baseline;
  gap: 2px;
  min-width: 0;
}

.fact-cell__value {
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  color: var(--ink);
  overflow-wrap: anywhere;
}

.fact-cell__unit {
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--muted);
}

.fact-cell__sub {
  font-size: var(--text-caption);
  line-height: 18px;
  color: var(--muted);
  overflow-wrap: anywhere;
}

/* ---------- 信息卡：标签在上、值在下 ---------- */
/* row-gap 20（2026-10-26 style-B，16→20）：参考板事实块两行之间有明显空行，16 在 390 宽下读成一块 */
.fact-grid--card {
  gap: 20px 12px;
}

/* ---------- 路线指标：读数在上、标签在下（视觉顺序用 order，DOM 顺序仍是标签先出，读屏不乱） ---------- */
.fact-grid--stats {
  gap: 14px 12px;
}

.fact-grid--stats .fact-cell__label {
  order: 2;
  margin-top: 2px;
}

.fact-grid--stats .fact-cell__value-row {
  order: 1;
}

.fact-grid--stats .fact-cell__value {
  font-size: 26px;
  line-height: 1.3;
  color: var(--forest);
}

.fact-grid--stats .fact-cell__sub {
  order: 3;
}

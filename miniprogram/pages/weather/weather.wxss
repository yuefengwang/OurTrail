/* 天气页 V2：7 日概览条（降权——只负责选哪一天，非视觉主角） */
.day-strip { display: flex; white-space: nowrap; }
.day-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  min-width: 64px;
  padding: 8px 6px;
  margin-right: 6px;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--line);
}
.day-card.on { border-color: var(--forest); border-width: 2px; padding: 7px 5px; background: var(--forest-soft); }
.day-label { font-size: var(--text-caption); color: var(--muted); font-weight: 600; }
.day-date { font-size: 10px; color: var(--muted); line-height: 12px; }
.day-temp { font-size: var(--text-caption); font-weight: 600; color: var(--ink); }
.day-rain { font-size: 10px; color: var(--info); }

/* WMO 简字徽标 tone（文字承载语义） */
.day-phrase { font-size: var(--text-caption); font-weight: 600; }
.day-phrase.success { color: var(--success); }
.day-phrase.warning { color: var(--warning); }
.day-phrase.danger { color: var(--danger); }
.day-phrase.neutral { color: var(--muted); }

/* 软降级横幅（连不上实时源时展示旧数据）：按钮读作链接，不抢横幅的警告色 */
.stale-retry { display: inline-block; margin-top: 6px; padding-left: 0; padding-right: 0; text-align: left; color: var(--warning); font-weight: 600; }

/* V2 时间轴卡：切换开关 + 浮条 + 图注 */
/* M-07：24/48/72h 切窗是天气页的高频操作，而这页是户外强光/戴手套场景（见 activity.wxml 的同类说明）。
   原来把高度硬写成 26px（全局同类控件在 SWX1 的 M-06 之后已经是 var(--touch-target)），
   这里同样取 token 而不写数：影子调 --touch-target 时这里必须跟着动。
   选中态仍是实心深底白字（本页图表区信息密度高，实心更醒目），这是刻意保留的视觉，不是遗漏。 */
.tl-viewseg { display: flex; gap: 6px; margin: 4px 0 8px; }
.seg-btn {
  flex: 1; text-align: center; font-size: var(--text-caption);
  line-height: var(--touch-target); height: var(--touch-target);
  border-radius: 8px; background: var(--forest-soft); color: var(--muted); font-weight: 600;
}
.seg-btn.on { background: var(--forest); color: var(--surface); }
.timeline-card { display: block; }
.chart-caption { display: block; margin-top: 6px; }

/* 统一 Meteogram 图例（对齐 HTML 原型 renderLegend 两行：行1 图形变量 / 行2 约定解释）。
   swatch 颜色全部走 app.wxss 的 --chart-* token；token 值 = utils/meteogram-svg.js C 色板
   与 utils/cloud-field-svg.js BANDS 的运行时字面量，改色必须三处同步（同 --golden 先例）。 */
.chart-legend { display: block; margin-top: 6px; font-size: 10px; line-height: 16px; color: var(--muted); }
.lg-row { display: flex; flex-wrap: wrap; align-items: center; }
.lg-item { display: inline-flex; align-items: center; margin-right: 4px; white-space: nowrap; }
.lg-title { font-weight: 600; letter-spacing: 0.5px; }
.lg-dim { margin-left: 2px; opacity: 0.75; }
.sw-ramp {
  width: 34px; height: 9px; box-sizing: border-box; border: 1px solid var(--line);
  background: var(--chart-ramp); margin-right: 2px;
}
.sw-line { width: 12px; height: 0; margin-right: 2px; border-top: 2px solid var(--line); }
.sw-temp { border-top-color: var(--ink); }
.sw-rain { border-top-color: var(--info); }
.sw-showers { border-top-color: var(--chart-showers); }
.sw-wind { border-top-color: var(--chart-wind); }
.sw-gust { border-top-color: var(--chart-gust); }
.sw-dash { border-top: 1.5px dashed var(--forest); }
.sw-amber { border-top-color: var(--chart-in-cloud); }
.sw-arrow { margin-right: 2px; font-weight: 600; }

/* 小时浮条：点图上某小时后的数字与窗口归属（L1 事实 + L2 归属同条） */
.hour-chip {
  margin-top: 8px; border-radius: 10px; background: var(--forest-soft); padding: 8px 12px;
}
.chip-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
/* B-16：字重两档（正文 400/500、强调 600），700 只留给 .page-title；数字强调由 --forest 与 tabular 承载 */
.chip-time { font-size: var(--text-body); font-weight: 600; color: var(--forest); }
.chip-main { font-size: var(--text-caption); font-weight: 600; flex: 1; }
.chip-close { font-size: 11px; color: var(--muted); }
.chip-sub { margin-top: 2px; font-size: 11px; line-height: 17px; color: var(--ink); }
.chip-tags { margin-top: 4px; }
.chip-tag {
  font-size: 10px; line-height: 16px; padding: 0 7px; border-radius: 5px;
  background: var(--surface); color: var(--forest); font-weight: 600;
}
.chip-tag.warn { background: var(--warning-soft); color: var(--warning); }

/* V2 Numbers：全字段横滚表（默认折叠，专业用户深度数据） */
.num-sheet { padding: 0; overflow: hidden; }
.num-table { min-width: 760px; }
.num-row { display: flex; border-bottom: 1px solid var(--line); }
.num-row:last-child { border-bottom: none; }
/* E-06：这里原来写 `position: sticky` 却不带任何 top/bottom 偏移 —— 四个偏移全为 auto 时
   粘滞约束矩形没有边界，行为等同 position: relative，是一条永不生效的死声明（还会误导后来者以为表头已常驻）。
   本条选「删掉死声明」而不是「补 top: 0」：纵向滚动发生在页面级，而表头在一个只做横向滚动的 scroll-view 里，
   外层 .num-sheet 又带 overflow: hidden，单纯补 top 不足以让表头常驻 —— 真做常驻要改滚动容器（属结构改动，
   见 out/SWX2/requests.md 的 DEFERRED-DEPENDENCY）。底色保留：表头行仍要与数据行区分。 */
.num-head { background: var(--forest-soft); }
.nc {
  flex: 0 0 54px; padding: 6px 6px; font-size: 11px; line-height: 16px;
  text-align: right; color: var(--ink); white-space: nowrap;
}
/* B-16：数字列的强调同样降到 600（与表头 .num-head .nc 同档，靠 tabular 与右对齐区分） */
.nc-time { flex: 0 0 48px; text-align: left; font-weight: 600; }
.num-head .nc { color: var(--muted); font-weight: 600; }
.nc.success { color: var(--success); }
.nc.warning { color: var(--warning); }
.nc.danger { color: var(--danger); }
.nc.neutral { color: var(--muted); }

/* V2 今日户外时间轴（Agenda）：天文/天气事实（灰点）+ OurTrail 窗口（绿点+评级） */
.agenda { padding: 14px 14px 10px; }
.agenda-item { display: flex; gap: 10px; position: relative; padding-bottom: 14px; }
.agenda-item:last-child { padding-bottom: 2px; }
/* 58px：装得下「次日 06:00」（跨夜日程会把起点在次日的事件标出来）。
   旧列宽下这段文字会挤进标题列；只加宽时间列，不动字号与颜色。 */
.ag-time { flex: 0 0 58px; font-size: var(--text-caption); color: var(--muted); padding-top: 1px; }
.ag-line { flex: 0 0 14px; position: relative; }
.ag-line::before {
  content: ""; position: absolute; left: 6px; top: 14px; bottom: -2px;
  width: 1.5px; background: var(--line);
}
.agenda-item:last-child .ag-line::before { display: none; }
.ag-dot {
  position: absolute; left: 2px; top: 3px; width: 9px; height: 9px; border-radius: 50%;
  border: 2px solid var(--surface);
}
.ag-dot.l1 { background: var(--control-line); }
.ag-dot.l2 { background: var(--forest); }
.ag-body { flex: 1; min-width: 0; }
.ag-src { font-size: 10px; color: var(--muted); letter-spacing: 0.4px; display: block; }
.ag-title { font-size: 13px; font-weight: 600; line-height: 20px; color: var(--ink); }
.ag-title-l1 { font-weight: 600; }
.ag-sub { font-size: var(--text-caption); color: var(--muted); line-height: 18px; }
.ag-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
/* B-13：评级星原来是 --golden(#D6A33C) —— 白卡 2.29:1、forest-soft 1.99:1，强光下几乎糊掉。
   本仓已两次把同型坑改成「色块承担颜色、文字保持 --ink」（meteogram 图例、本组件的 .st-lg），
   这里沿用同一修法：星形是文字节点，就用正文墨色；评级语义本来就由紧邻的 .ag-grade/.cond-grade
   文字色（success/warning/muted，全部 ≥4.5:1）承载，色相不额外承担信息。
   若产品坚持要回金色星，许可的路径是 meteogram 那种「金色做色块 + 墨色字」，需要真机核验，见 handoff。 */
.ag-stars { color: var(--ink); font-size: 12px; letter-spacing: 1px; white-space: nowrap; }
.ag-item-card {
  margin-top: 5px; border-radius: 10px; padding: 8px 11px;
  background: var(--forest-soft);
}
.ag-item-card.success { background: var(--success-soft); }
.ag-item-card.warning { background: var(--warning-soft); }
.ag-item-card.neutral { background: var(--forest-soft); }
.ag-meta { display: flex; align-items: baseline; gap: 8px; margin-top: 2px; }
.ag-window { font-size: var(--text-caption); font-weight: 600; color: var(--ink); }
.ag-grade { font-size: var(--text-caption); font-weight: 600; }
.ag-grade.success { color: var(--success); }
.ag-grade.warning { color: var(--warning); }
.ag-grade.neutral { color: var(--muted); }
.ag-empty { padding: 4px 0 8px; }

.section-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px; }
.section-id { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; min-width: 0; }
/* 区块标题：把页面分成"客观指标"与"结论"两段（用户需求 2 的信息架构）
   B-16：字重从 700 降到 600（与 app.wxss 的 .section-title 同档）。
   ⚠ 这条页级覆盖没有删掉——它仍把字号从全局 --text-input(16px) 收到 --text-body(14px)，
   是承重的覆盖；「天气页要不要自己的区块标题」属 M-20 的裁决，本批未派，仍未闭合。 */
.section-title { font-size: var(--text-body); font-weight: 600; color: var(--ink); }
.section-sub { font-size: var(--text-caption); color: var(--muted); }

/* V2 户外条件卡：总评 + 评级卡（与事实层用同款卡片语言，靠文案与星级承载差异） */
.cond-card { border-left: 3px solid var(--forest); }
/* 沉默说明行：不是结论、也没有评级，左边条降为分隔线色，避免与 `.cond-card` 抢注意力 */
.cond-silent { border-left: 3px solid var(--line); }
.cond-pheno { display: flex; flex-direction: column; gap: 6px; }
.cond-pheno.featured { border-left: 3px solid var(--info); }
.cond-main { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
/* B-16：卡片主标题一律 600（与 .ag-title 同档；缺陷本体就是这两处同级标题字重不同） */
.cond-label { font-size: 15px; font-weight: 600; color: var(--ink); }
.cond-grade { display: inline-flex; align-items: baseline; gap: 6px; }
/* B-13：与 .ag-stars 同修——星形是文字节点，用 --ink；评级语义由 .cond-grade/.ag-grade 的文字色承载 */
.cond-stars { color: var(--ink); font-size: 13px; letter-spacing: 1px; }
.pheno-window { font-size: var(--text-body); font-weight: 600; color: var(--ink); }
.pheno-text { font-size: var(--text-caption); line-height: 19px; color: var(--muted); }
.pheno-disclaimer { line-height: 17px; }
.pheno-advice {
  font-size: var(--text-caption); background: var(--info-soft);
  border-radius: 8px; padding: 6px 10px; color: var(--ink);
}

/* Evidence（V2）：结论 → 事实清单 → 看图回跳 */
/* M-07：这是「为什么？▾」证据展开开关，原来只有 padding 2px 0（实算 26px）。
   纵向 padding 撑到命中下限（继承行高 22 + 11×2 = --touch-target）；字号 12px 不动，扩的是命中盒。 */
.cond-why {
  font-size: var(--text-caption); font-weight: 600; color: var(--forest);
  padding: 11px 0;
}
.reason-panel {
  margin: 2px -14px 0; padding: 10px 14px 12px; background: var(--forest-soft);
  border-radius: 0 0 14px 14px; display: flex; flex-direction: column; gap: 4px;
}
/* B-16：眉题级说明用 600 + 字距，不用第三档字重 */
.reason-title {
  font-weight: 600; color: var(--muted); font-size: 11px;
  letter-spacing: 0.5px; margin-bottom: 2px;
}
.reason-item { display: flex; gap: 6px; align-items: baseline; }
/* B-16：✓ 记号由颜色（--success）与字形本身承载，不需要 700 */
.reason-mark { font-weight: 600; color: var(--success); flex: 0 0 auto; }
.reason-fact { color: var(--ink); flex: 1 1 auto; min-width: 0; font-size: var(--text-caption); line-height: 20px; }
/* M-07：「看图 ↗」原来没有任何纵向 padding（实算 22px），是戴手套最难点中的一项。
   用透明纵向 padding 撑到命中下限；横向不加，免得越过 6px 的 gap 抢到相邻事实文字的热区。 */
.reason-link {
  color: var(--info); font-size: 11px; cursor: pointer; white-space: nowrap; flex: 0 0 auto;
  font-weight: 600; padding: 11px 0;
}
.reason-note { margin-top: 4px; color: var(--muted); font-size: 11px; line-height: 17px; }
.sky-look {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--forest-soft);
}
/* B-16：白底药丸标签用 600（与 .badge/.eyebrow 同档），不引入第三档字重 */
.sky-look-label {
  flex: 0 0 auto;
  font-size: 11px;
  font-weight: 600;
  color: var(--forest);
  padding: 1px 6px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.7);
}
.sky-look-text { flex: 1; font-size: var(--text-caption); line-height: 18px; color: var(--forest); }
.warn-text { color: var(--warning); }


/* ---------- Weather V2：Cloud Field 卡（additive；配色沿用已冻结云场色板） ---------- */
.cloud-field-card { margin-top: 12px; }
.cf-hdr { display: flex; flex-direction: column; gap: 2px; margin-bottom: 8px; }
.cf-title { font-size: 14px; font-weight: 600; color: var(--ink); }
.cf-sub { font-size: 11px; }
.cf-stage { position: relative; width: 100%; }
.cf-img { display: block; width: 100%; }
.cf-sel { position: absolute; left: 0; top: 0; width: 100%; }
/* 读数三级：L1 天气事实（大）→ L2 云场事实 → L2.5 OurTrail 解读（彩色）→ L1b 风 */
.cf-readout {
  margin-top: 8px;
  padding: 7px 9px;
  background: var(--paper);
  border-radius: 8px;
  line-height: 1.55;
}
/* 未选中态：提示文案代替空灰条（原型同位为纯事实提示） */
.cf-readout .ro-hint { font-size: 11px; color: var(--muted); }
.cf-readout .ro-l1 { font-size: 14px; font-weight: 600; color: var(--ink); }
.cf-readout .ro-l2 { margin-top: 2px; font-size: 11px; color: var(--muted); }
.cf-readout .ro-l3 { margin-top: 2px; font-size: 11px; font-weight: 600; }
/* B-10：原来这里是硬写的 #8C5A12 —— 与 app.wxss 的 --warning 逐字节同值却是两份真值，
   token 调整时这一行不会跟着动。同排的 .ok/.mid 一直走 var()，只有「入云」这一支抄了字面量。 */
.cf-readout .ro-l3.in { color: var(--warning); }
.cf-readout .ro-l3.ok { color: var(--success); }
.cf-readout .ro-l3.mid { color: var(--info); }
.cf-readout .ro-l4 { margin-top: 2px; font-size: 10.5px; color: var(--muted); }

/* ---------- Weather V2 OI Phase 2：机会卡（editorial 风格，克制配色） ---------- */
.oi-card { margin-top: 12px; }
.oi-hdr { display: flex; flex-direction: column; gap: 2px; margin-bottom: 6px; }
.oi-title { font-size: 14px; font-weight: 600; color: var(--ink); }
.oi-sub { font-size: 10px; }
.oi-timeline { position: relative; width: 100%; }
.oi-tl-img { display: block; width: 100%; }
.oi-tap { position: absolute; top: 0; height: 70%; }
.oi-list { display: flex; flex-direction: column; }
.oi-item { padding: 7px 8px; border-radius: 8px; }
.oi-item.on { background: var(--paper); }
.oi-row { display: flex; align-items: baseline; gap: 8px; }
.oi-time { font-size: 11px; color: var(--muted); min-width: 96px; }
/* 跨零点窗口的列表文案是「今晚 23:00 → 次日 04:00」：给足一列宽度并允许两行，
   避免把名称列挤到换行（时间轴本身仍只画今晚段）。 */
.oi-time.cross { flex: 0 0 122px; width: 122px; min-width: 122px; line-height: 15px; white-space: normal; }
.oi-name { font-size: 12.5px; font-weight: 500; color: var(--ink); flex: 1; }
.oi-tier { font-size: 10px; }
.oi-tier.astro { color: var(--info); }
.oi-tier.primary { color: var(--success); font-weight: 600; }
.oi-tier.good { color: var(--ink); }
.oi-tier.fair { color: var(--muted); }
/* B-14：这里原来有第二条 `.oi-ev { margin-top: 4px; padding-left: 104px; }`。
   两条同特异度、后写的赢 ⇒ 4px 那条从来没生效过，是死句；它的存在让人以为账本边距是 4px。
   收敛到下面那一条（生效值 margin-top: 3px 保持不变 ⇒ 本次合并不是视觉变化）。 */
.oi-silence { padding: 4px 8px 2px; }
.oi-minor { opacity: 0.82; }
.oi-more { padding: 5px 8px 2px; }
.oi-multi { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 6px; }
.oi-day { display: flex; align-items: baseline; gap: 10px; padding: 7px 8px; border-radius: 8px; }
.oi-day-label { font-size: 11px; color: var(--muted); min-width: 64px; }
.oi-day-main { flex: 1; font-size: 12.5px; color: var(--ink); display: flex; flex-direction: column; gap: 1px; }
.oi-day-top { font-weight: 500; }
.oi-day-sub { font-size: 10px; color: var(--muted); }
.oi-day-count { font-size: 10px; color: var(--muted); }
.oi-day-hint { display: block; margin-top: 4px; font-size: 9.5px; }
/* Evidence「看图 ↗」：证据入口，不是 CTA（§9：小字号、层级低于正文、无按钮墙）。
   B-14：这一条是 `.oi-ev` 的唯一出处（原第一条是死句，见上面 OI 列表那段的说明）。 */
.oi-ev { margin-top: 3px; padding-left: 104px; display: flex; align-items: baseline; gap: 8px; }
/* M-07：10px 的「看图」原来是纯文字高度（实算 22px）。纵向透明 padding 撑到命中下限，
   横向不加（左右相邻是摘要文字与 .oi-item 的行热区，越界反而会抢走「选中这一小时」的点击）。 */
.oi-link { font-size: 10px; color: var(--forest); opacity: 0.85; flex-shrink: 0; padding: 11px 0; }

.oi-daygroup { margin-top: 8px; }
.oi-dayhdr { padding: 2px 8px 4px; border-bottom: 1px solid var(--line); margin-bottom: 4px; }
.oi-dayhdr-text { font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: 0.06em; }

<view class="page">
  <status-panel wx:if="{{denied}}" kind="denied" title="无法查看天气参考" detail="{{denied}}" action-label="重试" bind:action="reload" />
  <status-panel wx:elif="{{loading}}" kind="loading" title="正在载入地点" detail="读取地点、海拔与路线权限。" />
  <view wx:else class="stack">
    <view class="section-head">
      <text class="kicker">地点天气 · 北京时间</text>
      <text class="page-title">{{pointCard ? pointCard.name : pointLabels[pointIndex]}}</text>
      <text class="section-sub">同一地点的时间与高度变化，不是整条路线的空间云层图。</text>
    </view>
    <view wx:if="{{showLocation}}" class="place-row" hover-class="button-hover" bindtap="onOpenLocation">
      <view class="place-row__main">
        <text class="place-row__label">{{locationTitle}} · 第 {{pointIndex + 1}}/{{pointLabels.length}} 个</text>
        <text class="place-row__name">{{pointLabels[pointIndex]}}</text>
        <text class="place-row__hint">点此切换浏览地点</text>
      </view>
      <text class="place-row__chev">▾</text>
    </view>
    <view wx:elif="{{pointCard}}" class="weather-location">
      <text class="point-meta tabular">坐标 {{pointCard.coordText}} · 海拔 {{pointCard.eleText}}</text>
      <view class="button text" hover-class="button-hover" bindtap="onSavePoint">保存常用地点</view>
    </view>
    <form-field wx:else label="路线关键点" hint="{{scheduleBasis}}">
      <picker range="{{pointLabels}}" value="{{pointIndex}}" bindchange="onPoint"><view class="picker"><text class="picker-value">{{pointLabels[pointIndex] || '暂无路线节点'}}</text><text>▾</text></view></picker>
    </form-field>
    <view class="weather-date">
      <text class="small muted">浏览日期（不修改行程）</text>
      <picker mode="date" value="{{date}}" bindchange="onDate"><view class="picker tabular">{{date}} ▾</view></picker>
    </view>
    <view class="segmented tabs-line weather-tabs">
      <view wx:for="{{tabOptions}}" wx:key="key" class="seg {{weatherTab === item.key ? 'on' : ''}}" hover-class="button-hover" bindtap="onWeatherTab" data-tab="{{item.key}}">{{item.label}}</view>
    </view>
    <view wx:if="{{isOwner}}" class="button secondary block" hover-class="button-hover" bindtap="onDraftNotice">生成天气提醒草稿</view>
    <status-panel wx:if="{{loadingWeather}}" kind="loading" title="正在查询天气" detail="{{retryNote || '正在向气象服务查询该点的逐小时预报。'}}" />
    <block wx:elif="{{dayCards.length}}">
      <view wx:if="{{weatherStale}}" class="callout warning"><text>{{weatherStale.text}}</text><view class="button text" hover-class="button-hover" bindtap="onRetryWeather">重新查询</view></view>
      <scroll-view class="day-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{dayCards}}"
          wx:key="date"
          class="day-card {{item.selected ? 'on' : ''}}"
          hover-class="button-hover"
          bindtap="onDayTap"
          data-date="{{item.date}}"
        >
          <text class="day-label">{{item.label}}</text>
          <text class="day-date tabular">{{item.dateLabel}}</text>
          <text class="day-phrase {{item.phrase.tone}}">{{item.phrase.label}}</text>
          <text class="day-temp tabular">{{item.tMax}}/{{item.tMin}}°</text>
          <text class="day-rain tabular">☂ {{item.precipProbMax}}%</text>
        </view>
      </scroll-view>


      <block wx:if="{{weatherTab === 'cloud' || weatherTab === 'hourly'}}">
        <view wx:for="{{callouts}}" wx:key="title" class="callout {{item.tone}}"><text>{{item.title}}</text></view>
        <view class="tl-viewseg">
          <view class="seg-btn {{viewSpan === 24 ? 'on' : ''}}" hover-class="button-hover" bindtap="onSpanToggle" data-span="24">24 小时</view>
          <view class="seg-btn {{viewSpan === 48 ? 'on' : ''}}" hover-class="button-hover" bindtap="onSpanToggle" data-span="48">48 小时</view>
          <view class="seg-btn {{viewSpan === 72 ? 'on' : ''}}" hover-class="button-hover" bindtap="onSpanToggle" data-span="72">72 小时</view>
        </view>
        <view wx:if="{{hourStrip.length}}" class="hour-strip">
          <view wx:for="{{hourStrip}}" wx:key="k" class="hour-strip__item"><text class="day-phrase {{item.phrase.tone}}">{{item.phrase.label}}</text><text class="hour-strip__temp tabular">{{item.temp}}</text><text class="hour-strip__t tabular">{{item.t}}</text></view>
        </view>
      </block>
      <block wx:if="{{weatherTab === 'cloud'}}">
        <view class="section-head"><text class="section-title">时间 × 海拔 · 云层剖面</text><text class="section-sub">灰阶为气压层云量，位势高度近似海拔。平滑仅改善阅读，不代表更高预测精度。</text></view>
        <view class="tl-viewseg">
          <view class="seg-btn {{cloudWindow === 'auto' ? 'on' : ''}}" hover-class="button-hover" bindtap="onCloudWindow" data-window="auto">自适应</view>
          <view class="seg-btn {{cloudWindow === 'low' ? 'on' : ''}}" hover-class="button-hover" bindtap="onCloudWindow" data-window="low">低层 0–4 km</view>
          <view class="seg-btn {{cloudWindow === 'high' ? 'on' : ''}}" hover-class="button-hover" bindtap="onCloudWindow" data-window="high">高层 3–7 km</view>
        </view>
        <status-panel wx:if="{{!unified}}" kind="empty" title="这次没有可用云层剖面" detail="没有足够的有效垂直云层数据，不代表晴空。可重试，或切换逐时预报查看温度、降水和风。" action-label="重新查询" bind:action="onRetryWeather" />
        <block wx:else>
          <text class="small muted tabular">{{unified.rangeText}}</text>
          <text class="small muted tabular">{{unified.coverageText}}</text>
          <view wx:if="{{unified}}" class="card cloud-field-card">

        <view class="cf-stage" bindtap="onCfTap" bindtouchstart="onCloudDrag" catchtouchmove="onCloudDrag" hover-class="button-hover">
          <image class="cf-img" src="{{unified.src}}" mode="widthFix"/>
          <image wx:if="{{unified.selSrc}}" class="cf-sel" src="{{unified.selSrc}}" mode="widthFix"/>
        </view>
        <view class="cf-readout">
          <block wx:if="{{unified.r1}}">
            <view class="ro-l1 tabular">{{unified.r1}}</view>
            <view class="ro-l2 tabular">{{unified.r2}}</view>
            <view wx:if="{{unified.r3}}" class="ro-l3 {{unified.stKey}}">→ {{unified.r3}}</view>
            <view class="ro-l4 tabular">{{unified.r4}}</view>
          </block>
          <view wx:else class="ro-hint">{{unified.readout}}</view>
        </view>
        <view class="chart-legend">
          <view class="lg-row">
            <view class="lg-item"><view class="sw-ramp"></view><text class="lg-title">分层云量</text><text class="lg-dim">10 / 25 / 50 / 75 / 90%</text></view>
            <view class="lg-item"><view class="sw-line sw-temp"></view><text>温度</text></view>
            <view class="lg-item"><view class="sw-line sw-rain"></view><text>总降水</text></view>
            <view class="lg-item"><view class="sw-line sw-showers"></view><text>其中阵雨</text></view>
            <view class="lg-item"><view class="sw-line sw-wind"></view><text>风速</text></view>
            <view class="lg-item"><view class="sw-line sw-gust"></view><text>阵风</text></view>
          </view>
          <view class="lg-row">
            <view class="lg-item"><view wx:if="{{unified.elevShown}}" class="sw-line sw-dash"></view><text>{{unified.legendElev}}</text></view>
            <view class="lg-item"><view class="sw-line sw-amber"></view><text>琥珀段 = {{unified.legendIn}}</text></view>
            <view class="lg-item"><text class="sw-arrow">↗</text><text>箭头 = 风向（吹向）</text></view>
          </view>
        </view>
      </view>


          <view class="weather-time-controls">
            <view class="button secondary" hover-class="button-hover" bindtap="onHourStep" data-step="-1">前一时</view>
            <picker range="{{hourOptions}}" value="{{selectedHourIndex}}" bindchange="onHourPicker"><view class="picker tabular">{{selectedTime}} ▾</view></picker>
            <view class="button secondary" hover-class="button-hover" bindtap="onHourStep" data-step="1">后一时</view>
          </view>
          <view wx:if="{{unified.gapCount}}" class="callout warning">{{unified.gapCount}} 个小时缺少有效云层数据，斜纹区域不可判读，不用邻近时刻补成云或晴空。</view>
          <text class="small muted">斜纹 = 缺测或高度覆盖外；显示窗之外仍可能有云。点按、横向拖动或直接选时可同步读数。</text>
          <text class="small muted">温度为近地面 2 m、风为近地面 10 m 预报，不是所选云层高度的温度或风。总降水已包含阵雨，不重复相加。</text>
        </block>
      </block>
      <block wx:elif="{{weatherTab === 'hourly'}}">
        <view class="section-head has-action"><text class="section-title">逐时预报</text><view class="button text" hover-class="button-hover" bindtap="onFullscreen">全图展示</view><text class="section-sub">近地面温度、降水与风 · 小时累计降水（mm）</text></view>
        <view wx:if="{{hourOverview}}" class="card hour-hero">
          <view class="hour-hero__head">
            <view class="hour-hero__main">
              <text class="chip-time tabular">{{hourOverview.dateLabel}} {{hourOverview.time}}</text>
              <text class="hour-hero__temp tabular">{{hourOverview.tempTxt}}</text>
              <text class="small muted tabular">体感 {{hourOverview.feelsTxt}}</text>
              <text class="day-phrase {{hourOverview.tone}}">{{hourOverview.phrase}}</text>
            </view>
            <view wx:if="{{hourOverview.tags.length}}" class="hour-hero__tags">
              <text wx:for="{{hourOverview.tags}}" wx:key="*this" class="chip-tag">{{item}}</text>
            </view>
          </view>
          <text class="hour-hero__note">读数属于选中这一小时；点图、横向拖动或用下方按钮换时都会同步。</text>
          <view wx:if="{{hourOverview.inCloud}}" class="hour-hero__warn">此点此时可能处在云中：体感更冷，能见度可能更差。</view>
          <fact-grid items="{{hourOverview.facts}}" variant="card" />
        </view>
        <view class="timeline-card"><meteogram series="{{chartView}}" marks="{{chartMarks}}" night="{{chartNight}}" selected-dates="{{chartSelected}}" hour-width="{{viewHW}}" elevation="{{chartElev}}" sun-bands="{{chartSunBands}}" sun-lines="{{chartSunLines}}" now="{{chartNow}}" pick="{{chartPick}}" bind:pickhour="onChartPickHour" /></view>
        <view class="weather-time-controls"><view class="button secondary" hover-class="button-hover" bindtap="onHourStep" data-step="-1">前一时</view><picker range="{{hourOptions}}" value="{{selectedHourIndex}}" bindchange="onHourPicker"><view class="picker tabular">{{selectedTime}} ▾</view></picker><view class="button secondary" hover-class="button-hover" bindtap="onHourStep" data-step="1">后一时</view></view>
        <view class="section-head has-action"><text class="section-title">当天数据</text><view class="button text" hover-class="button-hover" bindtap="toggleDetail">{{showDetail ? '收起逐小时全表' : '展开逐小时全表'}}</view></view>
        <view class="card brief-rows">
        <view wx:for="{{briefRows}}" wx:key="k" class="fact-row">
          <text class="fact-label">{{item.k}}</text>
          <text class="fact-value tabular">{{item.v}}</text>
        </view>
      </view>
      <view wx:if="{{showDetail}}" class="card num-sheet">
        <scroll-view scroll-x enhanced show-scrollbar>
          <view class="num-table">
            <view class="num-row num-head">
              <text class="nc nc-time">时间</text><text class="nc">天气</text><text class="nc">温度</text>
              <text class="nc">体感</text><text class="nc">降水%</text><text class="nc">mm</text>
              <text class="nc">风</text><text class="nc">风向</text><text class="nc">湿度</text>
              <text class="nc">气压</text><text class="nc">能见度</text><text class="nc">UV</text>
              <text class="nc">露点</text><text class="nc">云带 m</text>
            </view>
            <view wx:for="{{detailRows}}" wx:key="t" class="num-row">
              <text class="nc nc-time tabular">{{item.t}}</text>
              <text class="nc {{item.phrase.tone}}">{{item.phrase.label}}</text>
              <text class="nc tabular">{{item.temp}}°</text>
              <text class="nc tabular">{{item.feels}}°</text>
              <text class="nc tabular">{{item.pop}}%</text>
              <text class="nc tabular">{{item.precip}}</text>
              <text class="nc tabular">{{item.wind}}</text>
              <text class="nc">{{item.windDir}}</text>
              <text class="nc tabular">{{item.rh}}%</text>
              <text class="nc tabular">{{item.pressure}}</text>
              <text class="nc tabular">{{item.visibility}}</text>
              <text class="nc tabular">{{item.uv}}</text>
              <text class="nc tabular">{{item.dewPoint}}°</text>
              <text class="nc tabular">{{item.band}}</text>
            </view>
          </view>
        </scroll-view>
      </view>


      </block>
      <block wx:elif="{{weatherTab === 'enroute'}}">
        <view class="section-head">
          <text class="section-title">沿途天气</text>
          <text class="section-sub">先看清这条路线与要去的节点；逐节点的抵达预报在「完整沿途天气」里查。</text>
        </view>
        <view wx:if="{{routeView}}" class="card route-card">
          <text wx:if="{{routeView.title}}" class="route-title">{{routeView.title}}</text>
          <view wx:if="{{routeView.rows.length}}" class="route-rows">
            <view wx:for="{{routeView.rows}}" wx:key="k" class="route-row">
              <text class="route-row__k">{{item.k}}</text>
              <text class="route-row__v tabular">{{item.v}}</text>
            </view>
          </view>
          <text class="small muted">{{routeView.sourceNote}}</text>
        </view>
        <view class="section-head">
          <text class="section-title">路过哪些节点</text>
          <text class="section-sub">这里只切换浏览地点，不推算抵达时刻，也不修改个人行程。</text>
        </view>
        <view class="card route-list">
          <view
            wx:for="{{locationRows}}"
            wx:key="id"
            class="route-row-item {{pointIndex === item.index ? 'on' : ''}}"
            hover-class="button-hover"
            bindtap="onPickLocation"
            data-index="{{item.index}}"
          >
            <view class="route-row-item__main">
              <text class="route-row-item__name">{{item.name}}</text>
              <text class="route-row-item__sub tabular">{{item.sub}}</text>
            </view>
            <text wx:if="{{pointIndex === item.index}}" class="route-row-item__now">正在查看</text>
            <text wx:else class="route-row-item__chev">▾</text>
          </view>
        </view>
        <view class="button secondary block" hover-class="button-hover" bindtap="onOpenRoutePlan">打开完整沿途天气</view>
        <view class="button text block" hover-class="button-hover" bindtap="onOpenWeatherHub">去天气首页选别的路线</view>
      </block>
      <block wx:else>
        <view wx:if="{{condOverall || condCards.length || condSilent || skyInputLoading || skyInputNote}}" class="card cond-card cond-strip">
        <view wx:if="{{condOverall}}" class="cond-main">
          <text class="cond-label">天相条件</text>

          <view class="cond-grade"><text wx:if="{{condOverall.stars}}" class="cond-stars">{{condOverall.stars}}</text><text class="ag-grade {{condOverall.tone}}">{{condOverall.label}}</text></view>
        </view>
        <text wx:if="{{condOverall && condOverall.insufficient}}" class="small muted">可判读的天相不足，未给总评；这不是“条件差”。</text>
        <text wx:if="{{skyInputLoading}}" class="small muted">正在补充方向云/地形/透明度/光污染…</text>
        <text wx:if="{{skyInputNote}}" class="small muted">{{skyInputNote}}</text>
        <view wx:if="{{condCards.length}}" class="cond-strip__pills">
          <view wx:for="{{condCards}}" wx:key="key" class="cond-pill">
            <text class="cond-pill__title">{{item.title}}</text>
            <text class="cond-pill__stars tabular">{{item.stars}}</text>
          </view>
        </view>
      </view>


      <view wx:if="{{condSilent}}" class="card cond-silent">
        <text class="pheno-text">{{condSilent.text}}</text>
      </view>


      <!-- 24 小时天穹带（Stitch v16.3 日月标签）：与日照轨迹同源同日期，
           选中时刻是带上的一个白点（selectHour 与日照卡同一次 setData 重画）。 -->
      <block wx:if="{{skyEphemeris && skyEphemeris.band}}">
        <view class="section-head">
          <text class="section-title">24 小时天穹带</text>
          <text class="section-sub">按太阳高度角分段 · 每 5 分钟采样</text>
        </view>
        <view class="card sky-band-card">
          <image class="sky-band-img" src="{{skyEphemeris.band.src}}" mode="widthFix" />
          <text class="sky-band-summary tabular">{{skyEphemeris.band.summary}}</text>
          <view class="chart-legend">
            <view class="lg-row">
              <view class="lg-item"><view class="sw-band sw-night"></view><text>天文暗夜</text></view>
              <view class="lg-item"><view class="sw-band sw-astro"></view><text>天文晨昏</text></view>
              <view class="lg-item"><view class="sw-band sw-nautical"></view><text>航海晨昏</text></view>
              <view class="lg-item"><view class="sw-band sw-civil"></view><text>民用晨昏</text></view>
              <view class="lg-item"><view class="sw-band sw-day"></view><text>白昼</text></view>
            </view>
          </view>
          <text class="small muted">{{skyEphemeris.band.note}}</text>
        </view>
      </block>

      <!-- 晨昏时刻表：与天穹带同一次装配；「—」表示该纬度当日不出现这个阶段，
           不是缺测——这句话由 twilight.note 自己说，页面不另写第二份。 -->
      <block wx:if="{{skyEphemeris && skyEphemeris.twilight}}">
        <view class="section-head">
          <text class="section-title">晨昏时刻</text>
          <text class="section-sub">太阳高度角穿越 · 日出日落含海拔修正</text>
        </view>
        <view class="card ephem-card">
          <view class="ephem-grid">
            <view class="ephem-col">
              <text class="ephem-head">晨间梯度</text>
              <view wx:for="{{skyEphemeris.twilight.dawnRows}}" wx:key="k" class="ephem-row">
                <text class="ephem-k">{{item.k}}</text>
                <text class="ephem-v tabular">{{item.v}}</text>
              </view>
            </view>
            <view class="ephem-col">
              <text class="ephem-head">暮间梯度</text>
              <view wx:for="{{skyEphemeris.twilight.duskRows}}" wx:key="k" class="ephem-row">
                <text class="ephem-k">{{item.k}}</text>
                <text class="ephem-v tabular">{{item.v}}</text>
              </view>
            </view>
          </view>
          <text class="small muted">{{skyEphemeris.twilight.note}}</text>
        </view>
      </block>


      <block wx:if="{{solarArc}}">
        <view class="section-head">
          <text class="section-title">今日日照轨迹</text>
          <text class="section-sub">太阳高度随时间变化 · 真实天文量，不含山体遮挡</text>
        </view>
        <view class="card solar-card">
          <image class="solar-img" src="{{solarArc.src}}" mode="widthFix" />
          <view class="solar-meta">
            <text class="solar-summary tabular">{{solarArc.dateLabel}} · {{solarArc.summary}}</text>
            <text wx:if="{{solarArc.daylight}}" class="solar-summary tabular">{{solarArc.daylight}}</text>
          </view>
          <text class="small muted">{{solarArc.note}}</text>
          <view class="chart-legend">
            <view class="lg-row">
              <view class="lg-item"><view class="sw-line sw-sun"></view><text>太阳高度</text></view>
              <view class="lg-item"><view class="sw-band sw-golden"></view><text>黄金时刻</text></view>
              <view class="lg-item"><view class="sw-band sw-blue"></view><text>蓝调时刻</text></view>
              <view class="lg-item"><view class="sw-line sw-dash"></view><text>地平线（虚线）</text></view>
            </view>
          </view>
        </view>
      </block>

      <!-- 月相与夜空光照：月盘是矢量（utils/sky-ephemeris.js），亮面比例与月龄同源。
           月落标注「（次日）」由模块判一次，页面照搬，不在模板里比大小。 -->
      <block wx:if="{{skyEphemeris && skyEphemeris.moon}}">
        <view class="section-head">
          <text class="section-title">月相与夜空光照</text>
          <text class="section-sub">按日期与坐标计算 · 不含云量与光污染</text>
        </view>
        <view class="card moon-card">
          <view class="moon-row">
            <image class="moon-disc" src="{{skyEphemeris.moon.src}}" mode="widthFix" />
            <view class="moon-main">
              <view class="moon-line">
                <text class="moon-name">{{skyEphemeris.moon.name}}</text>
                <text class="moon-illum tabular">亮面 {{skyEphemeris.moon.illumination}}%</text>
              </view>
              <text class="moon-sub tabular">月龄 {{skyEphemeris.moon.age}} 天</text>
              <view class="moon-times">
                <view class="moon-time">
                  <text class="moon-time-k">{{skyEphemeris.moon.riseCell.k}}</text>
                  <text class="moon-time-v tabular">{{skyEphemeris.moon.riseCell.v}}</text>
                </view>
                <view class="moon-time">
                  <text class="moon-time-k">{{skyEphemeris.moon.setCell.k}}</text>
                  <text class="moon-time-v tabular">{{skyEphemeris.moon.setCell.v}}{{skyEphemeris.moon.setCell.hint}}</text>
                </view>
              </view>
            </view>
          </view>
          <text class="small muted">{{skyEphemeris.moon.note}}</text>
        </view>
      </block>


        <view wx:if="{{oiCard || oiHorizon}}" class="card oi-card">
        <view class="oi-hdr">
          <text class="oi-title">今天值得关注</text>
          <text class="oi-sub small muted">{{oiCard ? oiCard.astroNote : oiHorizon.astroNote}}</text>
        </view>
        <view class="oi-timeline" wx:if="{{oiCard}}">
          <image class="oi-tl-img" src="{{oiCard.timelineSrc}}" mode="widthFix"/>
          <view
            wx:for="{{oiCard.tapZones}}"
            wx:key="hour"
            class="oi-tap"
            style="left:{{item.left}}%;width:{{item.width}}%"
            hover-class="button-hover"
            bindtap="onOiTap"
            data-hour="{{item.hour}}"
          />
        </view>

        <block wx:if="{{viewSpan !== 24 && oiHorizon}}">
          <view class="oi-timeline">
            <image class="oi-tl-img" src="{{oiHorizon.timelineSrc}}" mode="widthFix"/>
            <view
              wx:for="{{oiHorizon.tapZones}}"
              wx:key="hour"
              class="oi-tap"
              style="left:{{item.left}}%;width:{{item.width}}%;top:{{item.track * 36}}%;height:34%"
              hover-class="button-hover"
              bindtap="onOiTap"
              data-h="{{item.hour}}"
            />
          </view>
          <view
            wx:for="{{oiHorizon.groups}}"
            wx:for-item="group"
            wx:for-index="gi"
            wx:key="label"
            class="oi-daygroup"
          >
            <view class="oi-dayhdr"><text class="oi-dayhdr-text">{{group.label}}</text></view>
            <view
              wx:for="{{group.items}}"
              wx:for-item="item"
              wx:key="index"
              class="oi-item {{oiHorizon.selGroup === gi && oiHorizon.selIndex === index ? 'on' : ''}}"
              hover-class="button-hover"
              bindtap="onOiTap"
              data-h="{{item.absHour}}"
            >
              <view class="oi-row">
                <text class="oi-time tabular">{{item.timeText}}</text>
                <text class="oi-name">{{item.title}}{{item.live ? ' · 进行中' : ''}}</text>
                <text wx:if="{{item.tierClass !== 'good'}}" class="oi-tier {{item.tierClass}}">{{item.tierText}}</text>
              </view>
              <view class="oi-ev">
                <text class="small muted">{{item.summaryText}}</text>
                <text
                  wx:if="{{item.anchor}}"
                  class="oi-link"
                  hover-class="button-hover"
                  catchtap="onOiEvidence"
                  data-hour="{{item.anchor.focusAbs}}"
                >{{oiHorizon.selGroup === gi && oiHorizon.selIndex === index ? '看图 · ' + item.anchor.focusLabel : '看图 ↗'}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{oiHorizon.silenceNote}}" class="oi-silence">
            <text class="small muted">{{oiHorizon.silenceNote}}</text>
          </view>
        </block>

        <view class="oi-list" wx:if="{{viewSpan === 24 && oiCard}}">
          <view
            wx:for="{{oiCard.items}}"
            wx:key="index"
            class="oi-item {{oiCard.selIndex === index ? 'on' : ''}}"
            hover-class="button-hover"
            bindtap="onOiTap"
            data-hour="{{item.hour}}"
          >
            <view class="oi-row">
              <text class="oi-time tabular {{item.crossMidnight ? 'cross' : ''}}">{{item.timeText}}</text>
              <text class="oi-name">{{item.title}}{{item.live ? ' · 进行中' : ''}}</text>
              <text wx:if="{{item.tierClass !== 'good'}}" class="oi-tier {{item.tierClass}}">{{item.tierText}}</text>
            </view>
            <view class="oi-ev">
              <text class="small muted">{{item.summaryText}}</text>
              <text
                wx:if="{{item.anchor}}"
                class="oi-link"
                hover-class="button-hover"
                catchtap="onOiEvidence"
                data-hour="{{item.anchor.focusHour}}"
              >{{oiCard.selIndex === index ? '看图 · ' + item.anchor.focusLabel : '看图 ↗'}}</text>
            </view>
          </view>
          <block wx:if="{{oiCard.expanded}}">
            <view
              wx:for="{{oiCard.moreItems}}"
              wx:key="index"
              class="oi-item oi-minor {{oiCard.selIndex === oiCard.items.length + index ? 'on' : ''}}"
              hover-class="button-hover"
              bindtap="onOiTap"
              data-hour="{{item.hour}}"
            >
              <view class="oi-row">
                <text class="oi-time tabular {{item.crossMidnight ? 'cross' : ''}}">{{item.timeText}}</text>
                <text class="oi-name">{{item.title}}</text>
                <text wx:if="{{item.tierClass !== 'good'}}" class="oi-tier {{item.tierClass}}">{{item.tierText}}</text>
              </view>
              <view class="oi-ev">
                <text class="small muted">{{item.summaryText}}</text>
                <text
                  wx:if="{{item.anchor}}"
                  class="oi-link"
                  hover-class="button-hover"
                  catchtap="onOiEvidence"
                  data-hour="{{item.anchor.focusHour}}"
                >{{oiCard.selIndex === oiCard.items.length + index ? '看图 · ' + item.anchor.focusLabel : '看图 ↗'}}</text>
              </view>
            </view>
          </block>
          <view wx:if="{{oiCard.moreCount > 0}}" class="oi-more" hover-class="button-hover" bindtap="onOiMore">
            <text class="small muted">{{oiCard.expanded ? '收起' : '还有 ' + oiCard.moreCount + ' 个时段'}}</text>
          </view>
        </view>
        <view wx:if="{{viewSpan !== 24 && oiMultiDay}}" class="oi-multi">
          <view
            wx:for="{{oiMultiDay}}"
            wx:key="date"
            class="oi-day"
            hover-class="button-hover"
            bindtap="onOiDay"
            data-date="{{item.date}}"
          >
            <text class="oi-day-label">{{item.label}}</text>
            <text class="oi-day-main" wx:if="{{item.silence}}">暂无明显天气类机会</text>
            <view wx:else class="oi-day-main">
              <text class="oi-day-top">{{item.topTitle}}</text>
              <text class="oi-day-sub tabular">{{item.topTime}} · 另有 {{item.count - 1}} 个时段</text>
            </view>
            <text class="oi-day-count tabular">{{item.silence ? '—' : item.count + ' 项'}}</text>
          </view>
          <text class="small muted oi-day-hint">点某天查看当日 24 小时机会详情</text>
        </view>
        <view wx:if="{{oiCard && oiCard.silenceNote}}" class="oi-silence">
          <text class="small muted">{{oiCard.silenceNote}}</text>
        </view>
        <text class="chart-caption small muted">OurTrail 户外解读由当日天气数据推导 · 天文时刻为确定性事件 · 天气窗口标注置信</text>
      </view>


      <view class="section-head">
        <text class="section-title">今日户外时间轴</text>
        <text class="section-sub">天文与天气变化 + OurTrail 窗口，按时间排</text>
      </view>
      <view class="card agenda">
        <view wx:for="{{agenda}}" wx:key="index" class="agenda-item">
          <text class="ag-time tabular">{{item.t}}</text>
          <view class="ag-line"><view class="ag-dot {{item.l2 ? 'l2' : 'l1'}}"></view></view>
          <view class="ag-body">
            <text class="ag-src">{{item.l2 ? 'OURTRAIL 分析' : '天文 / 天气'}}</text>
            <view wx:if="{{item.l2}}" class="ag-item-card {{item.tone}}" hover-class="button-hover">
              <view class="ag-title-row">
                <text class="ag-title">{{item.title}}</text>
                <text class="ag-stars">{{item.stars}}</text>
              </view>
              <view class="ag-meta tabular">
                <text class="ag-window">{{item.window}}</text>
                <text class="ag-grade {{item.tone}}">{{item.gradeLabel}}</text>
              </view>
            </view>
            <block wx:else>
              <view class="ag-title ag-title-l1">{{item.title}}</view>
              <view wx:if="{{item.sub}}" class="ag-sub tabular">{{item.sub}}</view>
            </block>
          </view>
        </view>
        <view wx:if="{{!agenda.length}}" class="ag-empty small muted">今天没有值得标注的窗口。</view>
      </view>




      <view wx:if="{{condCards.length}}" class="section-head">
        <text class="section-title">天相详解</text>
        <text class="section-sub">由云/月/地形/光害推算；只汇总天相，不是徒步安全评级</text>
      </view>

      <view wx:for="{{condCards}}" wx:key="key" class="card cond-pheno {{item.featured ? 'featured' : ''}}">
        <view class="card-header" style="margin-bottom:2px;">
          <text class="card-label">{{item.title}}{{item.featured ? ' · 值得关注' : ''}}</text>
          <text class="cond-stars">{{item.stars}}</text>
        </view>
        <text wx:if="{{item.window}}" class="pheno-window tabular">{{item.window}}</text>
        <text class="pheno-text">{{item.text}}</text>
        <view wx:if="{{item.look}}" class="sky-look">
          <text class="sky-look-label">往哪看</text>
          <text class="sky-look-text">{{item.look}}</text>
        </view>

        <view wx:if="{{item.evidence.length}}" class="cond-why" hover-class="button-hover" bindtap="onToggleEvidence" data-key="{{item.key}}">
          {{openEvidence[item.key] ? '收起依据 ▴' : '为什么？▾'}}
        </view>
        <view wx:if="{{item.evidence.length && openEvidence[item.key]}}" class="reason-panel">
          <text class="reason-title">OURTRAIL 判断依据 · 均为上方图表中的可见事实</text>
          <view wx:for="{{item.evidence}}" wx:for-item="f" wx:key="fact" class="reason-item">
            <text class="reason-mark">✓</text>
            <text class="reason-fact">{{f.fact}}</text>
            <text class="reason-link" hover-class="button-hover" catchtap="onEvidenceJump" data-at="{{f.at}}">看图 ↗</text>
          </view>
          <text class="reason-note">评级来自 sky.js 同源判定；点「看图」定位到对应小时自行核对。</text>
        </view>
        <view wx:if="{{item.advice}}" class="pheno-advice">建议：{{item.advice}}</view>
      </view>




      </block>
      <view wx:if="{{(weatherTab === 'cloud' || weatherTab === 'hourly') && popShown}}" class="pop-strip"><text class="pop-strip__label">降水概率</text><view class="pop-strip__row"><text wx:for="{{hourStrip}}" wx:key="k" class="pop-strip__v tabular">{{item.pop}}</text></view></view>
      <view class="weather-source"><text class="small muted">更新时间：{{updatedAt}} · 北京时间</text><text class="small muted">这是行前参考，不是出发许可；出发前核实当地气象与路况。</text><text class="small muted">数据来源 {{providerLabel || 'Open-Meteo'}}.com（CC BY 4.0）。日月时刻为本机按坐标计算；天气类天相为条件判断，不作保证。</text><text class="small muted">增强输入：7Timer!（非商业）、CAMS/Open-Meteo Air Quality（Copernicus）、Copernicus DEM（© DLR/Airbus DS）、DarkSkySites。</text><view class="button text" hover-class="button-hover" bindtap="onCopySources">数据来源与许可</view></view>
    </block>
    <status-panel wx:else kind="{{emptyKind}}" title="{{emptyTitle || '暂不展示天气数字'}}" detail="{{emptyDetail || '此节点暂无可用天气数据，请重新查询。'}}" action-label="重新查询" bind:action="fetchWeather" />
    <!-- 地点选择：只列当前这一屏的节点，另给「完整沿途天气」与天气首页两个出口。
         不复制路线库/GPX 能力（那些在 weather-hub），也不在这里查逐点预报。 -->
    <overlay open="{{locationOpen}}" kind="sheet" title="{{locationTitle}}" bind:close="onCloseLocation">
      <view class="loc-note small muted">{{locationNote}}</view>
      <view class="loc-list">
        <view
          wx:for="{{locationRows}}"
          wx:key="id"
          class="loc-row {{pointIndex === item.index ? 'on' : ''}}"
          hover-class="button-hover"
          bindtap="onPickLocation"
          data-index="{{item.index}}"
        >
          <view class="loc-row__main">
            <text class="loc-row__name">{{item.name}}</text>
            <text class="loc-row__sub tabular">{{item.sub}}</text>
          </view>
          <text wx:if="{{pointIndex === item.index}}" class="loc-row__now">正在查看</text>
          <text wx:else class="loc-row__chev">▾</text>
        </view>
      </view>
      <view class="loc-actions">
        <view class="button secondary block" hover-class="button-hover" bindtap="onOpenRoutePlan">打开完整沿途天气</view>
        <view class="button text block" hover-class="button-hover" bindtap="onOpenWeatherHub">去天气首页选别的路线</view>
      </view>
    </overlay>
  </view>
</view>

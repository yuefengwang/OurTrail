/* 全图展示（横屏）：把竖屏里"横滑才看得完"的 meteogram 摊到整屏宽度上。 */
.fc {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  /* 横屏时安全区在左右两侧（刘海/圆角），避开它再留白 */
  padding: 12px calc(16px + env(safe-area-inset-right)) 12px calc(16px + env(safe-area-inset-left));
  background: var(--paper);
}

.fc-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.fc-id {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.fc-point {
  font-size: var(--text-body);
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fc-sub { font-size: var(--text-caption); color: var(--muted); }

/* 点图上某小时的读数。全览下列太窄读不出字，点一下把数值摊在标题栏 */
.fc-pick {
  min-width: 0;
  font-size: var(--text-caption);
  font-weight: 600;
  color: var(--forest);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fc-spacer { flex: 1; }
.fc-modes { flex: 0 0 auto; width: 216px; }
/* .segmented .seg 默认 36px，低于可点区域下限，这里补到 44 */
.fc-modes .seg { min-height: 44px; font-size: var(--text-caption); }
.fc-close { flex: 0 0 auto; }

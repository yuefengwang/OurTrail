<view class="page wh-page">

  <!-- 屏 1：选源首页 ------------------------------------------------------>
  <block wx:if="{{screen === 'home'}}">
    <!-- 与屏 2 同一条品牌固定条（plain：白底无分隔线、词标用 ink），两屏身份不跳 -->
    <brand-header variant="plain" />

    <view class="wh-header">
      <text class="wh-eyebrow">山野天气</text>
      <text class="wh-title">看清天气，再出发。</text>
      <text class="wh-sub">一个地点，一段路线，或一场计划中的徒步。</text>
    </view>

    <view class="wh-actions">
      <view class="wh-primary" hover-class="wh-tap" bindtap="onPickMap">
        <view class="wh-primary-title">
          <icon name="pin" size="19" color="#16783E" />
          <text>地图选点</text>
        </view>
        <text class="wh-primary-sub">找到你想去的山野</text>
      </view>
      <view class="wh-row">
        <view class="wh-row-btn" hover-class="wh-tap" bindtap="onManualOpen">
          <icon name="crosshair" size="16" color="#16783E" />
          <text>输入经纬度</text>
        </view>
        <view class="wh-row-btn" hover-class="wh-tap" bindtap="onImportGpx">
          <icon name="upload" size="16" color="#16783E" />
          <text>导入 GPX 轨迹</text>
        </view>
      </view>
    </view>

    <!-- 继续上次：最近一条个人计划（无则整块不出现） -->
    <view wx:if="{{lastPlan}}" class="wh-recent">
      <text class="wh-recent-title">继续上次</text>
      <view class="wh-recent-btn" hover-class="wh-tap" bindtap="onOpenPlanFromRoute">
        <view class="wh-recent-tag">
          <icon name="calendar" size="11" color="#2C5A38" />
          <text>{{lastPlan.isOwner ? '个人计划' : '共享计划'}}</text>
        </view>
        <text class="wh-recent-name">{{lastPlan.name}}</text>
        <text class="wh-recent-sub">{{lastPlan.subText}}</text>
        <view class="wh-chev"><icon name="next" size="16" color="#8A968C" /></view>
      </view>
    </view>

    <!-- 资产三 tab -->
    <view class="wh-tabs">
      <view class="wh-tab {{homeTab === 'plans' ? 'on' : ''}}" hover-class="wh-tap" bindtap="onHomeTab" data-tab="plans">个人计划</view>
      <view class="wh-tab {{homeTab === 'points' ? 'on' : ''}}" hover-class="wh-tap" bindtap="onHomeTab" data-tab="points">常用地点</view>
      <view class="wh-tab {{homeTab === 'routes' ? 'on' : ''}}" hover-class="wh-tap" bindtap="onHomeTab" data-tab="routes">共用路线</view>
    </view>

    <view class="wh-list">
      <!-- 个人计划：我创建的 / 共享给我的 -->
      <block wx:if="{{homeTab === 'plans'}}">
        <view wx:if="{{plansState === 'loading'}}" class="wh-quiet">正在读个人计划…</view>
        <view wx:elif="{{plansState === 'denied'}}" class="wh-quiet">登录后才能保存与共享计划。天气查询不需要登录。</view>
        <view wx:elif="{{plansState === 'error'}}" class="wh-quiet">
          <text>个人计划暂时读不到。</text>
          <view class="wh-inline-link" hover-class="wh-tap" bindtap="onRetryPlans">重新读取</view>
        </view>
        <block wx:else>
          <view wx:for="{{plans}}" wx:key="id" class="wh-asset" hover-class="wh-tap" bindtap="onOpenPlan" data-id="{{item.id}}">
            <view class="wh-asset-icon"><icon name="calendar" size="18" color="#5F7A63" /></view>
            <view class="wh-asset-body">
              <text class="wh-asset-name">{{item.name}}</text>
              <text class="wh-asset-sub">{{item.subText}}</text>
            </view>
            <view class="wh-chev"><icon name="next" size="16" color="#8A968C" /></view>
          </view>
          <view wx:if="{{sharedPlans.length}}" class="wh-group-head">共享给我的</view>
          <view wx:for="{{sharedPlans}}" wx:key="id" class="wh-asset" hover-class="wh-tap" bindtap="onOpenPlan" data-id="{{item.id}}">
            <view class="wh-asset-icon"><icon name="calendar" size="18" color="#5F7A63" /></view>
            <view class="wh-asset-body">
              <text class="wh-asset-name">{{item.name}}</text>
              <text class="wh-asset-sub">{{item.subText}} · 只读</text>
            </view>
            <view class="wh-chev"><icon name="next" size="16" color="#8A968C" /></view>
          </view>
          <view wx:if="{{!plans.length && !sharedPlans.length}}" class="wh-quiet">还没有个人计划。先选一条路线，再安排哪天到哪个节点。</view>
        </block>
      </block>

      <!-- 常用地点 -->
      <block wx:elif="{{homeTab === 'points'}}">
        <view wx:for="{{points}}" wx:key="id" class="wh-asset" hover-class="wh-tap" bindtap="onOpenPoint" data-id="{{item.id}}">
          <view class="wh-asset-icon"><icon name="pin" size="18" color="#5F7A63" /></view>
          <view class="wh-asset-body">
            <text class="wh-asset-name">{{item.display}}</text>
            <text class="wh-asset-sub">{{item.subText}} · 已保存</text>
          </view>
          <view class="wh-chev"><icon name="next" size="16" color="#8A968C" /></view>
          <view class="wh-asset-del" catchtap="onDeleteTap" data-type="point" data-id="{{item.id}}" data-name="{{item.display}}">删除</view>
        </view>
        <view wx:if="{{!points.length}}" class="wh-quiet">还没有常用地点。地图选点或输入坐标后，可以保存到这里。</view>
      </block>

      <!-- 共用路线：路线库 + 导入的轨迹点组 -->
      <block wx:else>
        <view wx:if="{{routesState === 'loading'}}" class="wh-quiet">正在读路线库…</view>
        <view wx:for="{{routes}}" wx:key="id" class="wh-asset" hover-class="wh-tap" bindtap="onOpenRoute" data-id="{{item.id}}">
          <view class="wh-asset-icon"><icon name="route" size="18" color="#5F7A63" /></view>
          <view class="wh-asset-body">
            <text class="wh-asset-name">{{item.title}}</text>
            <text class="wh-asset-sub">{{item.pointCount}} 个关键点 · 路线库{{item.isOwner ? '' : ' · 共用'}}</text>
          </view>
          <view class="wh-chev"><icon name="next" size="16" color="#8A968C" /></view>
        </view>

        <view wx:for="{{tracks}}" wx:key="id" class="wh-track">
          <view class="wh-asset" hover-class="wh-tap" bindtap="onOpenTrack" data-id="{{item.id}}">
            <view class="wh-asset-icon"><icon name="route" size="18" color="#5F7A63" /></view>
            <view class="wh-asset-body">
              <text class="wh-asset-name">{{item.name}}</text>
              <text class="wh-asset-sub">{{item.statsText}} · 导入轨迹</text>
            </view>
            <view class="wh-chev"><icon name="next" size="16" color="#8A968C" /></view>
          </view>
          <view class="wh-track-toggle" hover-class="wh-tap" bindtap="onTrackToggle" data-id="{{item.id}}">
            <text>{{trackOpen[item.id] ? '收起节点' : '展开节点'}}</text>
            <icon name="{{trackOpen[item.id] ? 'up' : 'down'}}" size="11" color="#16783E" />
          </view>
          <view wx:if="{{trackOpen[item.id]}}" class="wh-track-nodes">
            <view
              wx:for="{{item.nodes}}"
              wx:for-item="node"
              wx:for-index="nodeIndex"
              wx:key="id"
              class="wh-node-row"
              hover-class="wh-tap"
              bindtap="onOpenTrackNode"
              data-set="{{item.id}}"
              data-index="{{nodeIndex}}"
            >
              <text class="wh-node-name">{{node.name}}</text>
              <text class="wh-node-sub">{{node.label}}</text>
            </view>
            <view class="wh-asset-del wh-track-del" catchtap="onDeleteTap" data-type="track" data-id="{{item.id}}" data-name="{{item.name}}">删除这组轨迹</view>
          </view>
        </view>
        <view wx:if="{{!routes.length && !tracks.length && routesState !== 'loading'}}" class="wh-quiet">还没有共用路线。在路线库保存路线，或导入一条 GPX。</view>
      </block>

      <text class="wh-foot">天气来自公开预报服务；个人计划与共享状态保存在云端。山野信号不稳时，页面会显示最近一次取到的预报并标注时效。</text>
    </view>
  </block>

  <!-- 屏 2：四视图详情（唯一实现）------------------------------------------>
  <block wx:else>
    <weather-detail
      mode="tab"
      can-back
      place="{{place}}"
      initial="{{initial}}"
      plan-id="{{planId}}"
      bind:openplace="onOpenPlace"
      bind:screenback="onBackHome"
      bind:planchange="onPlanChange"
    />
  </block>

  <!-- 地点切换弹层 -->
  <overlay open="{{placeOpen}}" kind="sheet" title="换一个地点" bind:close="onPlaceClose">
    <view class="wh-place">
      <input class="wh-search" value="{{placeQuery}}" bindinput="onPlaceQuery" placeholder="搜索地点或路线" />
      <view
        wx:for="{{placeList}}"
        wx:key="key"
        class="wh-place-row"
        hover-class="wh-tap"
        bindtap="onPickPlace"
        data-key="{{item.key}}"
      >
        <view class="wh-place-body">
          <text class="wh-place-name">{{item.name}}</text>
          <text class="wh-place-sub">{{item.sub}}</text>
        </view>
        <view class="wh-chev">
          <icon wx:if="{{item.current}}" name="check" size="17" color="#16783E" />
          <icon wx:else name="next" size="17" color="#16783E" />
        </view>
      </view>
      <view wx:if="{{!placeList.length}}" class="wh-quiet">没有匹配的地点。地点来自常用地点与路线库。</view>
    </view>
  </overlay>

  <!-- 手动输入经纬度 -->
  <overlay open="{{manualOpen}}" kind="dialog" title="输入经纬度" bind:close="onManualClose">
    <view class="stack">
      <view wx:if="{{manualError}}" class="callout danger">{{manualError}}</view>
      <form-field label="名称（可选）">
        <input class="input" value="{{manual.name}}" bindinput="onManualName" placeholder="如：四姑娘山大峰" />
      </form-field>
      <form-field label="纬度">
        <input class="input" type="digit" value="{{manual.lat}}" bindinput="onManualLat" placeholder="31.0632" />
      </form-field>
      <form-field label="经度">
        <input class="input" type="digit" value="{{manual.lng}}" bindinput="onManualLng" placeholder="102.9085" />
      </form-field>
      <form-field label="海拔（可选，影响天相判断）" hint="米。有真实海拔时，云海与晨昏光的判断更准。">
        <input class="input" type="digit" value="{{manual.ele}}" bindinput="onManualEle" placeholder="4250" />
      </form-field>
      <view class="list-row" bindtap="onManualWgs">
        <view class="list-main">
          <text>这是 GPS 原始坐标（WGS-84）</text>
          <text class="list-sub">从奥维/两步路等导出的坐标多为 WGS-84；微信地图里的坐标不用勾</text>
        </view>
        <checkbox checked="{{manual.wgs}}" color="#163E35" />
      </view>
      <view class="button primary block" hover-class="button-hover" bindtap="onManualSubmit">保存并查询</view>
    </view>
  </overlay>

  <!-- GPX 预览 -->
  <overlay open="{{gpxOpen}}" kind="sheet" title="导入 GPX 轨迹" bind:close="onGpxClose">
    <view class="stack">
      <view wx:if="{{gpxError}}" class="callout danger">{{gpxError}}</view>
      <block wx:if="{{gpxMeta && !gpxError}}">
        <view class="callout">
          <text class="callout-title">{{gpxMeta.fileName}}</text>
          <text style="display:block;margin-top:4px;">解析出 {{gpxMeta.count}} 个路线节点{{gpxMeta.count > gpxPoints.length ? '，保留 ' + gpxPoints.length + ' 个' : ''}}{{gpxMeta.distanceKm > 0 ? ' · 全程约 ' + gpxMeta.distanceKm + ' km' : ''}}{{gpxMeta.hasElevation ? ' · 累计爬升约 ' + gpxMeta.ascentM + ' m' : ''}}{{gpxMeta.hasTime ? ' · 含时刻（可推算抵达日）' : ''}}。</text>
        </view>
        <view class="stack" style="gap:4px;">
          <text class="small muted">确认前可先核对各节点，多余的可以删掉：</text>
          <view wx:for="{{gpxPoints}}" wx:key="index" class="list-row">
            <view class="list-main">
              <text>{{item.name}}</text>
              <text class="list-sub tabular">{{item.coordinates.lat}}, {{item.coordinates.lng}}</text>
            </view>
            <view class="button text" hover-class="button-hover" catchtap="onGpxRemove" data-index="{{index}}">删除</view>
          </view>
        </view>
        <view wx:if="{{gpxMeta.count > gpxPoints.length}}" class="button text block" hover-class="button-hover" bindtap="onGpxReset">恢复全部节点</view>
        <text wx:if="{{!(gpxPoints.length >= 2)}}" class="small muted">至少保留 2 个节点才能存为轨迹点组。</text>
        <view class="button primary block {{gpxPoints.length >= 2 ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{gpxPoints.length >= 2 ? 'onGpxApply' : ''}}">存为轨迹点组</view>
      </block>
      <block wx:elif="{{gpxError}}">
        <text class="small muted">请确认文件是标准 GPX（含 wpt/rtept/trkpt）后重试。</text>
      </block>
      <block wx:else>
        <text class="small muted">正在读取文件…</text>
      </block>
    </view>
  </overlay>

  <!-- 删除确认 -->
  <overlay open="{{deleteOpen}}" kind="dialog" title="{{deleteInfo.type === 'track' ? '删除这组轨迹？' : '删除这个观察点？'}}" bind:close="onDeleteClose">
    <view class="stack">
      <text>将删除「{{deleteInfo.name}}」{{deleteInfo.type === 'track' ? '及其全部节点，不可恢复。' : '，不可恢复。'}}</text>
      <view class="button danger block" hover-class="button-hover" bindtap="onDeleteConfirm">删除</view>
      <view class="button text block" hover-class="button-hover" bindtap="onDeleteClose">先留着</view>
    </view>
  </overlay>
</view>
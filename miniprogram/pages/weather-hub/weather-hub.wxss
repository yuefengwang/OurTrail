/* 天气模块（Tab）：屏 1 选源首页用本页皮肤；屏 2 详情全部在 weather-detail 组件里。
   页面级滚动（不用整页 scroll-view），因为组件里的四视图 tab 要 position: sticky。 */

/* Tab 页底部留白（唯一规则登记在 design-system.md「Tab 页底部留白（唯一规则）」）：
   缺失时列表最后几行被固定 tabBar 拦腰截断。本页在 app.json 的 tabBar.list 内 ⇒ 必须留。
   判据 tools/b4-pad-final-value-test.js §2 逐页解终值。 */
.page { padding-bottom: calc(32px + 84px + env(safe-area-inset-bottom)); }
/* 天气页皮肤是白底无卡片：横向留白由各分区自己给 20px，根节点不再吃 .page 的 20px。 */
.wh-page { padding-top: 0; padding-left: 0; padding-right: 0; }

.wh-tap { opacity: .72; }

/* ---------- 首页头 ---------- */
.wh-header { padding: 14px 20px 14px; }
.wh-eyebrow {
  display: block;
  font-size: 10px;
  letter-spacing: 2px;
  color: #16783E;
  font-weight: 600;
  margin-bottom: 7px;
}
.wh-title {
  display: block;
  font-size: 25px;
  line-height: 1.3;
  letter-spacing: -.7px;
  font-weight: 700;
  color: #18211B;
}
.wh-sub { display: block; font-size: 12px; color: #6F7A72; margin-top: 8px; line-height: 1.6; }

/* ---------- 三个入口 ---------- */
.wh-actions { padding: 4px 20px 18px; display: grid; gap: 9px; }
.wh-primary {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 60px;
  padding: 15px 16px;
  border: 1px solid #D5E2D3;
  border-radius: 12px;
  background: #FFFFFF;
}
.wh-primary-title { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 600; color: #22402D; }
.wh-primary-sub { font-size: 10px; color: #79837A; }
.wh-row { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.wh-row-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 46px;
  padding: 0 8px;
  border: 1px solid #E8ECE7;
  border-radius: 10px;
  font-size: 12px;
  color: #3C4A41;
  background: #FFFFFF;
}

/* ---------- 继续上次 ---------- */
.wh-recent { padding: 16px 20px; border-top: 1px solid #E8ECE7; }
.wh-recent-title { display: block; font-size: 13px; font-weight: 600; color: #5B675E; margin-bottom: 10px; }
.wh-recent-btn {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-rows: auto auto;
  column-gap: 11px;
  align-items: center;
  min-height: 60px;
  padding: 14px;
  border-radius: 12px;
  background: #F2F6F0;
}
.wh-recent-tag {
  grid-column: 1;
  grid-row: 1;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 9px;
  background: #DCEDD9;
  color: #2C5A38;
  border-radius: 5px;
  padding: 3px 7px;
}
.wh-recent-name { grid-column: 2; grid-row: 1; font-size: 13px; font-weight: 600; color: #18211B; }
.wh-recent-sub { grid-column: 2; grid-row: 2; font-size: 10px; color: #77817A; margin-top: 4px; }
.wh-recent-btn .wh-chev { grid-column: 3; grid-row: 1 / 3; }

/* ---------- 资产 tab ---------- */
.wh-tabs {
  display: flex;
  background: #FFFFFF;
  border-top: 1px solid #E8ECE7;
  border-bottom: 1px solid #E8ECE7;
  padding: 0 14px;
}
.wh-tab {
  position: relative;
  flex: 1;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #6C766E;
}
.wh-tab.on { font-weight: 700; color: #16783E; }
.wh-tab.on::after {
  content: "";
  position: absolute;
  bottom: -1px;
  left: 22%;
  right: 22%;
  height: 3px;
  background: #16783E;
  border-radius: 4px;
}

/* ---------- 列表 ---------- */
.wh-list { padding: 8px 20px 18px; }
.wh-quiet { display: block; font-size: 12px; line-height: 1.8; color: #758070; padding: 16px 0; }
.wh-inline-link { font-size: 12px; color: #16783E; padding: 8px 0; }
.wh-asset {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 56px;
  padding: 15px 0;
  border-bottom: 1px solid #E8ECE7;
}
.wh-asset-body { flex: 1; min-width: 0; }
.wh-asset-name { display: block; font-size: 13px; font-weight: 600; color: #18211B; overflow-wrap: anywhere; }
.wh-asset-sub { display: block; font-size: 10px; color: #7B857C; margin-top: 4px; }
.wh-asset-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #EDF1E9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.wh-asset-del { font-size: 11px; color: #96403C; padding: 10px 4px 10px 12px; flex: none; }
.wh-chev { display: flex; align-items: center; flex: none; }
.wh-group-head { font-size: 11px; color: #8B958C; padding: 16px 0 4px; }

.wh-track { border-bottom: 1px solid #E8ECE7; }
.wh-track .wh-asset { border-bottom: 0; }
.wh-track-toggle { display: flex; align-items: center; gap: 4px; font-size: 11px; color: #16783E; padding: 4px 0 10px; }
.wh-track-nodes { padding: 0 0 10px 12px; border-left: 1px solid #E8ECE7; margin-left: 4px; }
.wh-node-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; }
.wh-node-name { font-size: 12px; color: #2C3C31; }
.wh-node-sub { font-size: 10px; color: #7B857C; }
.wh-track-del { padding-left: 0; }

.wh-foot { display: block; font-size: 10px; color: #8B958C; padding: 12px 0 4px; line-height: 1.7; }

/* ---------- 地点弹层 ---------- */
.wh-place { padding-bottom: 8px; }
.wh-search {
  width: 100%;
  box-sizing: border-box;
  font-size: 14px;
  padding: 12px;
  border: 1px solid #E8ECE7;
  border-radius: 8px;
  background: #F7F9F5;
  margin-bottom: 10px;
  min-height: 44px;
}
.wh-place-row {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 56px;
  padding: 14px 0;
  border-bottom: 1px solid #E8ECE7;
}
.wh-place-body { flex: 1; min-width: 0; }
.wh-place-name { display: block; font-size: 13px; font-weight: 600; color: #18211B; overflow-wrap: anywhere; }
.wh-place-sub { display: block; font-size: 10px; color: #7B857C; margin-top: 4px; }
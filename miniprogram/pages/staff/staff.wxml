<view class="page activity-ui">
  <view class="stack-sections">
    <!-- 紧凑身份头（L3）：角色 + 真实活动编号同一行；这页没有活动名投影，就不虚构一个标题。
         授权范围写在角色下面，现场协作的人先知道「这是我现在的授权范围」。 -->
    <view class="staff-identity activity-intro">
      <view class="cluster" style="justify-content:space-between;align-items:center;">
        <text class="eyebrow">现场协作</text>
        <text class="small muted">活动编号 · {{activityId}}</text>
      </view>
      <text class="staff-identity__title">照顾好这一小队。</text>
      <text class="section-sub">这里只展示当前仍授权给你的人员与任务；授权变更后立即生效。</text>
    </view>
    <!-- sync-key 是宿主唯一的失效信号（与 workspace.wxml 同型）。不接面板的写完成事件：
         本页只有这一个面板，它写成功后自己会 reload（field-panel.js），宿主再下发一次就是重复读。 -->
    <field-panel activity-id="{{activityId}}" perspective="staff" sync-key="{{syncKey}}" />
  </view>
</view>

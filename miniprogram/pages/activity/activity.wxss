/* 活动详情页 · 编辑式视觉层（2026-10-16）
   结构与业务逻辑不动，只做视觉层：hero-cover 全局类已定义在 app.wxss，
   这里只放页面特有的微调。 */
/* B-10（合并自 master）：本页 hero 容器是 .hero-cover（原写法写死 #D0D8D7，与app.wxss 的
   --on-forest-muted 逐字节同值却是两份真值）⇒ 改引用 token，值不变、无视觉变化。 */
.hero-cover .metric-unit,
.hero .metric-unit { color: var(--on-forest-muted); }
/* 主状态 callout：编辑式"当前该做什么"——比其他提示重半格，但不换语义色体系 */
.callout .callout-title { font-size: 15px; line-height: 22px; }

/* 分区锚点：横向滚动，不换行；只做阅读跳转 */
.section-nav {
  white-space: nowrap;
  width: 100%;
}
.section-nav__chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 0 12px;
  margin-right: 8px;
  border-radius: var(--radius-tag);
  background: var(--stone);
  color: var(--forest);
  font-size: 13px;
  font-weight: 600;
}
.section-nav__chip:last-child { margin-right: 0; }

/* 活动图文正文（2026-10-21）：段落按空行拆开；图片 1 张通栏、2 张两列、3+ 张三列 */
.article-p {
  display: block;
  margin-top: 12px;
  font-size: 16px;
  line-height: 1.8;
  color: var(--ink);
}

.article-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.article-cell { width: 100%; }

.article-images.single .article-img {
  width: 100%;
  height: auto;
}

.article-images.double .article-cell {
  width: calc((100% - 8px) / 2);
  height: 140px;
}

.article-images.triple .article-cell {
  width: calc((100% - 16px) / 3);
  height: 96px;
}

.article-img {
  width: 100%;
  height: 100%;
  border-radius: 8px;
  background: var(--stone);
}

.article-img-failed {
  width: 100%;
  height: 100%;
  min-height: 96px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: var(--stone);
  color: var(--muted);
  font-size: var(--text-caption);
}

.highlight-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.highlight-dot {
  color: var(--forest);
  font-weight: 700;
  line-height: 24px;
}

.highlight-text {
  flex: 1;
  line-height: 24px;
}

.star-row {
  display: flex;
  gap: 2px;
}

.star {
  color: var(--line);
  font-size: 15px;
}

.star.on { color: var(--forest); }

.fee-line {
  line-height: 24px;
  color: var(--ink);
}

<view class="page">
  <status-panel wx:if="{{denied}}" kind="denied" title="无法查看此活动" detail="{{denied}}" actionLabel="回到我的活动" bind:action="goHome" />
  <block wx:elif="{{loading}}">
    <status-panel kind="loading" title="正在载入" detail="正在核对活动安排。" />
  </block>
  <view wx:else class="stack">

    <view wx:if="{{draftNotice}}" class="callout warning">
      <text class="callout-title">未发布预览 · 仅你可见</text>
      <text style="display:block;margin-top:4px;">此预览不会发布活动，也不会替你报名。</text>
    </view>

    <!-- 编辑式封面 hero：定高媒体盒（文档流图片，微信里最稳的绘制路径）+ 状态浮层 +
         森林底信息区（design-system.md §3）。照片是场景氛围图而非活动实拍
         （活动模型无图片字段），页尾有脚注说明；加载失败 img-failed 隐藏照片，
         媒体盒高度仍在，退回纯色，不出破图。 -->
    <view class="hero-cover {{coverFailed ? 'img-failed' : ''}}">
      <view class="hero-cover-media">
        <image class="hero-cover-img" src="{{cover}}" mode="aspectFill" binderror="onCoverError" />
        <view class="hero-cover-scrim" />
        <view class="hero-cover-top">
          <view class="cluster" style="gap:8px;min-width:0;">
            <text class="badge on-forest">{{badgeText}}</text>
            <text wx:if="{{difficultyLabel}}" class="badge on-forest">{{difficultyLabel}}</text>
          </view>
          <text class="small tabular hero-date">{{startAtLabel}}</text>
        </view>
      </view>
      <view class="hero-cover-body">
        <text class="display hero-body">{{title}}</text>
        <text class="hero-body hero-sub">{{routeTitle}}</text>
        <view class="metrics hero-body">
          <view class="metric">
          <text wx:if="{{distance}}" class="metric-value">{{distance}}<text class="metric-unit">km</text></text>
          <text wx:else class="metric-value" style="color:var(--on-forest-muted);font-size:18px;font-weight:400;">待补</text>
          <text class="metric-label">路线里程</text>
          </view>
          <view class="metric">
          <text wx:if="{{ascent}}" class="metric-value">{{ascent}}<text class="metric-unit">m</text></text>
          <text wx:else class="metric-value" style="color:var(--on-forest-muted);font-size:18px;font-weight:400;">待补</text>
          <text class="metric-label">累计爬升</text>
          </view>
          <view class="metric">
          <text class="metric-value">{{confirmed}}<text class="metric-unit">/ {{capacity}}</text></text>
          <text class="metric-label">已确认人数</text>
          </view>
      </view>
    </view>
  </view>

    <view wx:if="{{!isDraft}}" class="callout {{stateTone}}">
      <text class="callout-title">{{stateTitle}}</text>
      <text style="display:block;margin-top:4px;">{{stateDetail}}</text>
      <!-- 时间锚点单独一行、前面带形状标记：户外强光下不能只靠颜色区分「现在该做的那件事」 -->
      <text wx:if="{{milestone}}" class="small tabular" style="display:block;margin-top:6px;">● {{milestone}}</text>
      <text wx:if="{{countersLine}}" class="small" style="display:block;margin-top:4px;">{{countersLine}}</text>
      <text wx:if="{{howLine}}" class="small" style="display:block;margin-top:4px;">{{howLine}}</text>
    </view>

    <view class="form-actions">
      <view wx:if="{{isOwner}}" class="button primary" hover-class="button-hover" bindtap="onWorkspace" style="flex:1;">
        <text>{{isDraft ? '返回编辑与发布' : '进入工作台'}}</text>
        <icon name="arrow" size="18" color="#FFFFFF" />
      </view>
      <button
        wx:elif="{{canSubmit}}"
        class="button primary"
        style="flex:1;"
        hover-class="button-hover"
        bindtap="onSignup"
      >填写报名资料</button>
      <view wx:elif="{{canSelfSheet}}" class="button primary" hover-class="button-hover" bindtap="onSelfSheet" style="flex:1;">{{selfButton}}</view>
      <view wx:elif="{{nextActionTarget === 'meeting'}}" class="button primary" hover-class="button-hover" bindtap="onNextAction" style="flex:1;">{{nextActionLabel}}</view>
      <!-- 分享是次要动作，给它 text 权重：一屏只留一个 primary，拇指落在哪个上一目了然 -->
      <button class="button text" hover-class="button-hover" open-type="share">
        <icon name="copy" size="18" color="#163E35" />
        <text>分享</text>
      </button>
    </view>

    <!-- 分区锚点：只做阅读跳转，不隐藏任何内容，也不替主操作做决定 -->
    <scroll-view class="section-nav" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{sectionNav}}"
        wx:key="id"
        wx:if="{{item.id !== 'sec-weather' || !isDraft}}"
        class="section-nav__chip"
        hover-class="button-hover"
        data-id="{{item.id}}"
        bindtap="onSectionNav"
      >{{item.label}}</view>
    </scroll-view>

    <view wx:if="{{rows.length}}" id="sec-peers" class="stack" style="gap:0;">
      <view class="section-head">
        <text class="kicker">同行人</text>
        <text class="section-title">我与同行人</text>
        <text class="section-sub">每个人，独立确认</text>
      </view>
      <person-row
        wx:for="{{rows}}"
        wx:key="signupId"
        name="{{item.name}}"
        avatar="{{item.avatar}}"
        status="{{item.statusLabel}}"
        tone="{{item.tone}}"
        subtitle="{{item.subtitle}}"
      >
        <view class="button {{item.isPrimary ? 'secondary' : 'text'}}" hover-class="button-hover" data-id="{{item.signupId}}" bindtap="onToggleRow">
          {{item.isPrimary ? '当前查看' : '切换查看'}}
        </view>
        <view class="button text" hover-class="button-hover" data-id="{{item.signupId}}" bindtap="openSheet">
          <text>资料与操作</text>
          <icon name="arrow" size="16" color="#163E35" />
        </view>
      </person-row>
    </view>

    <view id="sec-itinerary" class="stack" style="gap:0;">
      <view class="section-head">
        <text class="kicker">行程</text>
        <text class="section-title">这一次的安排</text>
      </view>
      <text class="lede">{{description}}</text>
      <view class="fact-row"><text class="fact-label">{{times[0].label}}</text><text class="fact-value tabular">{{times[0].value}}</text></view>
      <view class="fact-row"><text class="fact-label">{{times[1].label}}</text><text class="fact-value tabular">{{times[1].value}}</text></view>
      <view class="fact-row"><text class="fact-label">{{times[2].label}}</text><text class="fact-value tabular">{{times[2].value}}</text></view>
      <text wx:if="{{organizerIntro}}" class="small muted" style="display:block;margin-top:12px;">{{organizerIntro}}</text>
    </view>

    <view wx:if="{{!isDraft}}" id="sec-weather" class="stack" style="gap:8px;">
      <view class="section-head">
        <text class="kicker">天气</text>
        <text class="section-title">出发日天气</text>
        <text class="section-sub">只看出发日的天气事实；不构成出发许可。</text>
      </view>
      <view class="card stack-gap3">
        <block wx:if="{{weatherLoading}}">
          <text class="small muted">正在查询出发日天气…</text>
        </block>
        <block wx:elif="{{weatherBrief.ready}}">
          <view class="cluster" style="justify-content:space-between;">
            <text class="badge {{weatherBrief.tone}}">{{weatherBrief.phraseLabel}}</text>
            <text class="small muted">{{weatherBrief.dayLabel}}</text>
          </view>
          <text wx:if="{{weatherBrief.hourText}}" class="lede">{{weatherBrief.hourText}}</text>
          <text class="small muted">{{weatherBrief.dayText}}</text>
          <text wx:if="{{weatherBrief.pointText}}" class="small muted">{{weatherBrief.pointText}}</text>
          <view wx:if="{{weatherBrief.staleText}}" class="callout warning">
            <text class="small">{{weatherBrief.staleText}}</text>
          </view>
          <view wx:if="{{weatherBrief.riskText}}" class="callout warning">
            <text class="callout-title">风险提示</text>
            <text style="display:block;margin-top:4px;">{{weatherBrief.riskText}}</text>
          </view>
          <view class="cluster">
            <view class="button text" hover-class="button-hover" bindtap="onWeather">查看路线天气</view>
            <view wx:if="{{weatherBrief.riskText}}" class="button text" hover-class="button-hover" data-id="sec-safety" bindtap="onSectionNav">看下方风险</view>
          </view>
        </block>
        <block wx:else>
          <text class="small muted">{{weatherBrief.text || '正在准备天气信息…'}}</text>
          <view wx:if="{{weatherBrief.retry}}" class="button text" hover-class="button-hover" bindtap="onWeatherRetry">重新查询</view>
        </block>
      </view>
    </view>

    <view id="meeting-block" class="stack" style="gap:0;">
      <view class="section-head">
        <text class="kicker">路线与集合</text>
        <text class="section-title">怎么去 · 在哪集合</text>
      </view>
      <view wx:if="{{map.visible}}" class="map-card">
        <map
          class="map-canvas"
          latitude="{{map.latitude}}"
          longitude="{{map.longitude}}"
          scale="{{map.scale}}"
          markers="{{map.markers}}"
          polyline="{{map.polyline}}"
          include-points="{{map.includePoints}}"
          show-compass="{{false}}"
          show-scale="{{false}}"
          bindmarkertap="onMapMarkerTap"
        />
      </view>
      <view class="stack" style="gap:8px;margin-top:12px;">
        <view class="section-head">
          <text class="kicker">剖面</text>
          <text class="section-title">海拔怎么走</text>
          <text class="section-sub">高程来自 GPX 或路线节点；节点剖面不是连续地形。</text>
        </view>
        <view class="card">
          <route-profile track="{{track}}" points="{{points}}" />
        </view>
      </view>
      <view class="timeline" style="margin-top:12px;">
        <view
          wx:for="{{points}}"
          wx:key="id"
          class="timeline-item"
          hover-class="{{item.coordinates ? 'button-hover' : 'none'}}"
          bindtap="onPointLocate"
          data-index="{{index}}"
        >
          <view class="cluster" style="justify-content:space-between;align-items:flex-start;">
            <view style="min-width:0;">
              <text class="eyebrow">{{item.kindLabel}}</text>
              <text style="display:block;font-weight:700;margin-top:2px;">{{item.name}}</text>
            </view>
            <block wx:if="{{item.coordinates}}">
              <view
                wx:if="{{item.kind === 'checkpoint'}}"
                class="button text"
                hover-class="button-hover"
                catchtap="onPointWeather"
                data-index="{{index}}"
              >天气</view>
              <view
                wx:else
                class="button text"
                hover-class="button-hover"
                catchtap="onOpenLocation"
                data-lat="{{item.coordinates.lat}}"
                data-lng="{{item.coordinates.lng}}"
                data-name="{{item.name}}"
              >导航</view>
            </block>
          </view>
        </view>
      </view>
      <!-- 空路线（发布门允许路线整体后补）：说清「缺什么、补了有什么用」，不长成空白 -->
      <text wx:if="{{!points.length}}" class="small muted" style="display:block;margin-top:12px;">组织者还没有填写路线节点。途中清点与进度确认会用到它们，发布后可随时补上。</text>
      <view wx:for="{{pickups}}" wx:key="id" class="list-row" style="margin-top:12px;">
        <view class="list-main">
          <text>{{item.name}}</text>
          <text class="list-sub">{{item.address}}</text>
        </view>
        <view class="cluster" style="gap:10px;">
          <text wx:if="{{item.time}}" class="small tabular">{{item.time}}</text>
          <view
            wx:if="{{item.coordinates}}"
            class="button text"
            hover-class="button-hover"
            bindtap="onOpenLocation"
            data-lat="{{item.coordinates.lat}}"
            data-lng="{{item.coordinates.lng}}"
            data-name="{{item.name}}"
            data-address="{{item.address}}"
          >导航</view>
        </view>
      </view>
    </view>

    <view id="sec-safety" class="stack" style="gap:12px;">
      <view class="section-head">
        <text class="kicker">安全</text>
        <text class="section-title">风险提示</text>
      </view>
      <block wx:if="{{risks.length}}">
        <view wx:for="{{risks}}" wx:key="id" class="callout warning">
          <text class="callout-title">{{item.title}}</text>
          <text style="display:block;margin-top:4px;">{{item.advice}}</text>
        </view>
      </block>
      <text wx:else class="muted">组织者尚未补充具体风险；户外活动存在天气与路况变化。</text>
    </view>

    <view id="sec-equipment" class="stack" style="gap:12px;">
      <view class="section-head">
        <text class="kicker">装备</text>
        <text class="section-title">出发前，检查装备</text>
      </view>
      <block wx:if="{{equipment.length}}">
        <text class="field-label">必带</text>
        <view class="cluster">
          <text wx:for="{{equipment}}" wx:key="index" class="badge neutral">{{item}}</text>
        </view>
      </block>
      <block wx:if="{{equipmentSuggested.length}}">
        <text class="field-label" style="display:block;margin-top:12px;">建议</text>
        <view class="cluster">
          <text wx:for="{{equipmentSuggested}}" wx:key="index" class="badge neutral">{{item}}</text>
        </view>
      </block>
      <text wx:if="{{!equipment.length && !equipmentSuggested.length}}" class="muted">组织者未填写装备清单。</text>
    </view>

    <view id="sec-fee" class="stack" style="gap:12px;">
      <view class="section-head">
        <text class="kicker">费用与约定</text>
        <text class="section-title">费用与退出约定</text>
      </view>
      <text>{{feeNote}}</text>
      <text wx:if="{{cancellationNote}}" class="muted">{{cancellationNote}}</text>
      <text class="small muted">OurTrail 不收款，不处理支付或退款。</text>
      <!-- 封面诚实性：氛围图不是活动实拍（活动模型没有图片字段）。这句话必须看得见、但不可抢戏 -->
      <text class="photo-note" style="display:block;margin-top:4px;">封面为场景氛围图，非本次活动实拍；路线与天气信息以组织者填写与实测数据为准。</text>
    </view>

    <view wx:if="{{!isDraft}}" class="list-row" hover-class="button-hover" bindtap="onNotices">
      <view class="list-main">
        <text>活动通知</text>
        <text class="list-sub">集合变更与最新安排</text>
      </view>
      <icon name="arrow" size="22" color="#163E35" />
    </view>
    <view wx:if="{{!isDraft}}" class="list-row" hover-class="button-hover" bindtap="goTasks">
      <view class="list-main">
        <text>协作任务</text>
        <text class="list-sub">装备、采购与记录的分工</text>
      </view>
      <icon name="arrow" size="22" color="#163E35" />
    </view>
  </view>

  <overlay open="{{sheetOpen}}" kind="sheet" title="{{selRow.name}} · 同行状态" bind:close="closeSheet">
    <view class="stack">
      <view class="cluster">
        <text class="badge neutral">{{selRow.statusLabel}}</text>
        <text class="small muted">{{selRow.line}}</text>
      </view>
      <view wx:if="{{selMessage}}" class="callout success">{{selMessage}}</view>
      <view wx:if="{{selError}}" class="callout danger">{{selError}}</view>

      <form-field label="本次说明" hint="取消、异常与代确认时请说明原因；操作只作用于当前这位参与人。">
        <textarea class="textarea" maxlength="2000" value="{{selNote}}" bindinput="onSelNote" />
      </form-field>

      <view wx:if="{{canCheckin || canHome}}" class="form-actions">
        <view wx:if="{{canCheckin}}" class="button primary {{busy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy ? '' : 'onCheckin'}}" style="flex:1;">确认已到集合点</view>
        <view wx:if="{{canHome}}" class="button primary {{busy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy ? '' : 'onHome'}}" style="flex:1;">确认已安全到家</view>
      </view>

      <view wx:if="{{canNode}}" class="stack-gap3">
        <form-field label="到达的路线节点">
          <picker range="{{selPoints}}" range-key="label" value="{{selPointIndex}}" bindchange="onSelPoint">
            <view class="picker {{selPointIndex < 0 ? 'placeholder' : ''}}">
              <text class="picker-value">{{selPointIndex < 0 ? '请选择节点' : selPoints[selPointIndex].label}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </form-field>
        <view class="button secondary {{busy || selPointIndex < 0 ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || selPointIndex < 0 ? '' : 'onNode'}}">确认到达此节点</view>
      </view>

      <view wx:if="{{canPosReport}}" class="stack-gap3">
        <view class="button text" hover-class="button-hover" bindtap="onTogglePosBox">
          <text>{{showPosBox ? '收起' : '展开'}}位置上报</text>
        </view>
        <view wx:if="{{showPosBox}}" class="stack-gap3">
          <text class="small muted">仅本次主动上报一个位置点，不后台追踪；授权随活动结束失效，也可随时撤回。</text>
          <checkbox-group bindchange="onSelConsent">
            <label class="check-label">
              <checkbox color="#163E35" value="on" checked="{{selConsent}}" />
              <text class="check-text">同意本次活动授权人员查看这次上报的位置，活动结束后失效</text>
            </label>
          </checkbox-group>
          <view class="button secondary {{busy || !selConsent ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || !selConsent ? '' : 'onPosReport'}}">上报当前位置</view>
          <view wx:if="{{canPosRevoke}}" class="button text" hover-class="button-hover" bindtap="{{busy ? '' : 'onPosRevoke'}}">撤回位置共享</view>
        </view>
      </view>

      <view wx:if="{{canIncident}}" class="stack-gap3">
        <form-field label="报备类型">
          <picker range="{{kindOptions}}" value="{{selKindIndex}}" bindchange="onSelKind">
            <view class="picker">
              <text class="picker-value">{{kindOptions[selKindIndex]}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </form-field>
        <text class="small muted">用上方「本次说明」写明现状、去向与需要的帮助；报备不等于已完成安全收尾。</text>
        <view class="button danger {{busy || !selNote ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || !selNote ? '' : 'onIncident'}}">提交报备</view>
      </view>

      <view wx:if="{{canEdit || canCancel}}" class="form-actions">
        <view wx:if="{{canEdit}}" class="button secondary" hover-class="button-hover" bindtap="onEditRow" style="flex:1;">修改此人资料</view>
        <view wx:if="{{canCancel}}" class="button danger {{busy || !selNote ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || !selNote ? '' : 'onCancelRow'}}" style="flex:1;">确认取消此人报名</view>
      </view>

      <view class="stack-gap3">
        <form-field label="查看必要安全联络资料" hint="紧急联络与健康备注仅供本次必要用途。">
          <input class="input" value="{{selPurpose}}" bindinput="onSelPurpose" placeholder="说明本次查看的必要用途" />
        </form-field>
        <view class="button text {{selPurpose ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{selPurpose ? 'onSensitive' : ''}}">
          <text>按用途查看</text>
          <icon name="shield" size="16" color="#163E35" />
        </view>
        <view wx:if="{{selSensitive}}" class="callout">
          <text>紧急联系人：{{selSensitive.emergency.name}}</text>
          <text style="display:block;">紧急电话：{{selSensitive.emergency.phone}}</text>
          <text style="display:block;">健康备注：{{selSensitive.medical || '未填写'}}</text>
        </view>
      </view>
    </view>
  </overlay>
</view>

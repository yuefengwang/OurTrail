.route-overview {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.route-meta { gap: 8px; }
.route-facts .metric .metric-value {
  font-size: var(--text-title);
  line-height: 24px;
  letter-spacing: 0;
}
.route-facts .metric .route-fact-missing {
  color: var(--muted);
  font-weight: 400;
}
.route-node-name {
  display: block;
  font-weight: 600;
  margin-top: 2px;
  overflow-wrap: anywhere;
}
.button.route-delete {
  align-self: flex-start;
  color: var(--danger);
}
.route-actions .button { min-width: 0; padding: 12px; }
.route-actions .button.primary { flex: 2; }

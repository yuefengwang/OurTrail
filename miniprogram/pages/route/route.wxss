.route-overview {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.route-facts .metric .route-fact-missing {
  color: var(--muted);
  font-weight: 400;
}
/* 5b：字重与 overflow-wrap 已收进 app.wxss 的 `.row-title`（模板上两个类同写），
   这里只留这一行相对眉题的排布差（块级 + 与眉题的 2px 间距）。 */
.route-node-name {
  display: block;
  margin-top: 2px;
}
.button.route-delete {
  align-self: flex-start;
  color: var(--danger);
}
.route-actions .button { min-width: 0; padding: 12px; }
.route-actions .button.primary { flex: 2; }

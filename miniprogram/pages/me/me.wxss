/* 我的页：微信资料同步 + 自动保存 */
.page { padding-bottom: calc(32px + 84px + env(safe-area-inset-bottom)); }

.card-label {
  display: block;
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 12px;
}

/* 微信资料行：头像 + 昵称 */
.wx-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line, #DEE3DB);
  margin-bottom: 16px;
}
.avatar-btn {
  display: block;
  width: 64px;
  height: 64px;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  flex: 0 0 64px;
  overflow: hidden;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 64px; height: 64px; border-radius: 50%; flex: 0 0 64px; }
.avatar-img.sm { width: 36px; height: 36px; flex: 0 0 36px; }
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  font-size: 24px;
  font-weight: 600;
  background: var(--forest-soft, #ECF0EF);
  color: var(--forest, #163E35);
  border-radius: 50%;
}
.avatar-fallback.sm-text {
  display: inline-flex;
  width: 36px;
  height: 36px;
  font-size: 15px;
}
.nick-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.nick-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
/* 无下划线大字：身份行读作"个人资料"而非输入框（可编辑性由下方小字提示） */
.nick-input {
  min-height: 40px;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  font-size: 17px;
  font-weight: 600;
  line-height: 40px;
}

/* 手机号行：手填为主，一键获取降级为文字捷径（个人主体无「快速验证」权限） */
.field-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.phone-btn {
  flex: 0 0 auto;
  min-height: 0;
  padding: 4px 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--forest, #163E35);
  font-size: 13px;
  font-weight: 600;
  line-height: 20px;
  text-align: right;
}
button.phone-btn { font-family: inherit; }
.phone-btn::after { border: none; }

/* 其余 */
.who { display: flex; align-items: center; gap: 12px; }
.code-text { flex: 1; min-width: 0; word-break: break-all; }
.textarea.slim { min-height: 72px; }

/* 我的页：山野档案 v3（UI Lab B 方案 1:1 布局，字号/触控按小程序规范放大）
   Tab 页底部留白：规则与理由唯一登记在 design-system.md「Tab 页底部留白（唯一规则）」；
   本页在 app.json 的 tabBar.list 内 ⇒ 必须留（判据 tools/b4-pad-final-value-test.js §2 逐页解终值）。
   色彩/圆角只用 app.wxss 的 token，不新增色值；零阴影（头像白描边用 --white，不是阴影）。 */
.page {
  padding-bottom: calc(32px + 84px + env(safe-area-inset-bottom));
}
.me-page {
  background: var(--white);
  padding-top: 0;
  padding-left: 0;
  padding-right: 0;
}
.me-body { padding-bottom: 20px; }
.me-notice { margin: 16px 20px 0; }

/* ① 头图 + 身份叠加 */
.me-cover {
  position: relative;
  height: 148px;
  margin: 6px 20px 0;
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--stone);
}
.me-cover__img { display: block; width: 100%; height: 148px; }
.me-cover__caption {
  position: absolute;
  right: 10px;
  bottom: 9px;
  padding: 2px 6px;
  border-radius: var(--radius-tag);
  background: var(--forest-deep);
  color: var(--white);
  font-size: 12px;
  line-height: 16px;
  letter-spacing: 0.6px;
}
.ident-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 13px;
  margin: -42px 20px 0;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--white);
}
.ident-main { flex: 1; min-width: 0; }
.ident-name-row { display: flex; align-items: center; gap: 8px; }
.ident-name-input {
  flex: 1;
  min-width: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: 21px;
  line-height: 28px;
  font-weight: 600;
  letter-spacing: -0.6px;
}
.ident-name--gate { font-size: 21px; line-height: 28px; font-weight: 600; letter-spacing: -0.6px; display: block; }
.ident-status { flex: none; font-size: 12px; }
.ident-meta-row { display: flex; align-items: center; gap: 8px; margin-top: 2px; }
.ident-meta {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 18px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ident-edit {
  width: var(--touch-target);
  height: var(--touch-target);
  margin-right: -8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--forest-soft);
}
.ident-card--gate { align-items: flex-end; }

/* 头像：72px + 3px 白描边（原型的 \"护城河\"） */
.avatar {
  width: 72px;
  height: 72px;
  padding: 0;
  margin: 0;
  flex: 0 0 72px;
  border: none;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  line-height: 1;
  box-shadow: 0 0 0 3px var(--white);
}
.avatar::after { border: none; }
.avatar__img { display: block; width: 72px; height: 72px; border-radius: 50%; }
.avatar__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--forest);
  color: var(--leaf);
  font-size: 24px;
  font-weight: 600;
}
.avatar--gate { background: var(--forest-soft); box-shadow: 0 0 0 3px var(--white); }
.avatar--gate .avatar__fallback { background: var(--forest-soft); color: var(--muted); }
.ident-card--gate .avatar { display: flex; align-items: center; justify-content: center; background: var(--forest-soft); }

/* ② 待完善引导 */
.incomplete-card {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 16px 20px 0;
  padding: 12px 14px;
  border: 1px solid var(--stone-line);
  border-radius: var(--radius-card);
  background: var(--warning-soft);
  text-align: left;
}
.incomplete-icon {
  width: 36px;
  height: 36px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-button);
  background: var(--white);
}
.incomplete-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.incomplete-title { color: var(--ink); font-size: 14px; line-height: 20px; font-weight: 600; }
.incomplete-sub { color: var(--warning); font-size: 12px; line-height: 18px; }

/* ③ 履历栏：四等分，竖线用 --line（原型同结构） */
.trail-log {
  margin: 16px 20px 0;
  padding: 12px 4px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--white);
}
.trail-log__row { display: flex; align-items: stretch; }
.trail-log__item { flex: 1; min-width: 0; text-align: center; }
.trail-log__item + .trail-log__item { border-left: 1px solid var(--line); }
.trail-log__num {
  display: block;
  color: var(--ink);
  font-size: 18px;
  line-height: 24px;
  font-weight: 600;
  letter-spacing: -0.5px;
}
.trail-log__unit { font-size: 12px; font-weight: 600; letter-spacing: 0; margin-left: 1px; color: var(--muted); }
.trail-log__label { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 18px; }

/* ④ 我的行程 */
.section { margin: 20px 20px 0; }
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 10px;
}
.section-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.section-title { color: var(--ink); font-size: 16px; line-height: 24px; font-weight: 600; letter-spacing: -0.3px; }
.section-sub { color: var(--muted); font-size: 12px; line-height: 18px; }
.section-link {
  flex: none;
  min-height: var(--touch-target);
  display: flex;
  align-items: center;
  gap: 2px;
  color: var(--forest);
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}
.chev { flex: none; color: var(--muted); font-size: 20px; line-height: 20px; }

.next-trip {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--white);
  min-height: 102px;
}
.next-photo {
  position: relative;
  width: 82px;
  height: 84px;
  flex: none;
  border-radius: var(--radius-button);
  overflow: hidden;
  background: var(--stone);
}
.next-photo__img { display: block; width: 82px; height: 84px; }
.next-photo__fallback { width: 82px; height: 84px; background: var(--forest-soft); }
.next-date {
  position: absolute;
  left: 6px;
  bottom: 6px;
  padding: 2px 5px;
  border-radius: var(--radius-tag);
  background: var(--white);
  color: var(--forest);
  font-size: 12px;
  line-height: 16px;
  font-weight: 600;
}
.next-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.next-overline {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--forest);
  font-size: 12px;
  line-height: 18px;
  font-weight: 600;
}
.next-overline::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--forest);
  flex: none;
}
.next-title {
  color: var(--ink);
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  letter-spacing: -0.3px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.next-meta { display: flex; flex-wrap: wrap; gap: 2px 10px; }
.next-meta__item { display: flex; align-items: center; gap: 3px; color: var(--muted); font-size: 12px; line-height: 18px; }

.more-trips { margin-top: 8px; border-top: 1px solid var(--line); }
.more-trip {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 56px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
}
.more-trip__img { width: 34px; height: 34px; flex: none; border-radius: var(--radius-button); background: var(--stone); }
.more-trip__img--fallback { background: var(--forest-soft); }
.more-trip__main { flex: 1; min-width: 0; }
.more-trip__title {
  display: block;
  color: var(--ink);
  font-size: 14px;
  line-height: 20px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.more-trip__meta { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 18px; }

.data-empty {
  padding: 24px 16px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-card);
  background: var(--white);
  text-align: center;
}
.data-empty__title { display: block; color: var(--ink); font-size: 14px; line-height: 20px; font-weight: 600; }
.data-empty__sub { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; line-height: 18px; }
.data-empty__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target);
  margin-top: 6px;
  color: var(--forest);
  font-size: 12px;
  font-weight: 600;
}

/* ⑤ 同行与安全 */
.safety-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--white);
}
.safety-row {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 60px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--line);
}
.safety-card .safety-row:last-child { border-bottom: 0; }
.safety-row--standalone {
  margin-top: 10px;
  min-height: 64px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--white);
}
.safety-icon {
  width: 36px;
  height: 36px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-button);
  background: var(--forest-soft);
}
.safety-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.safety-title { color: var(--ink); font-size: 14px; line-height: 20px; font-weight: 600; }
.safety-sub {
  color: var(--muted);
  font-size: 12px;
  line-height: 18px;
  /* 原型是 9px 单行省略；放大到 12px 后单行会截掉路线库的关键半句，
     这里允许折到两行（触控行 min-height 60 仍够），不拿省略号换可读性。 */
  overflow-wrap: anywhere;
}
.safety-flag {
  flex: none;
  padding: 1px 6px;
  border-radius: var(--radius-tag);
  background: var(--forest-soft);
  color: var(--forest);
  font-size: 12px;
  line-height: 18px;
  font-weight: 600;
}
.route-count { flex: none; display: flex; flex-direction: column; align-items: flex-end; min-width: 28px; margin-right: 2px; }
.route-count__num { color: var(--ink); font-size: 18px; line-height: 22px; font-weight: 600; }
.route-count__unit { color: var(--muted); font-size: 12px; line-height: 16px; }

.companions-strip {
  margin-top: 10px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  background: var(--white);
}
.companions-label { display: flex; flex-direction: column; gap: 2px; }
.companions-title { color: var(--ink); font-size: 14px; line-height: 20px; font-weight: 600; }
.companions-sub { color: var(--muted); font-size: 12px; line-height: 18px; }
.companions-list { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
.companions-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.companions-inner { display: flex; align-items: center; gap: 8px; }
.companion {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: var(--touch-target);
  padding: 5px 12px 5px 6px;
  border-radius: var(--radius-button);
  background: var(--forest-soft);
  flex: none;
}
.companion-avatar {
  width: 32px;
  height: 32px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--white);
  color: var(--forest);
  font-size: 14px;
  font-weight: 600;
}
.companion-name {
  max-width: 120px;
  color: var(--ink);
  font-size: 14px;
  line-height: 20px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.companion-add {
  width: var(--touch-target);
  height: var(--touch-target);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--line);
  border-radius: var(--radius-button);
}
.companions-empty { display: block; margin-top: 8px; color: var(--muted); font-size: 12px; line-height: 18px; }

.me-foot {
  display: block;
  margin: 28px 0 4px;
  text-align: center;
  color: var(--muted);
  font-size: 12px;
  line-height: 18px;
}

/* 读不到档案 */
.gate { padding: 40px 24px 24px; text-align: center; }
.gate__icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--forest-soft);
}
.gate__title { display: block; color: var(--ink); font-size: 20px; line-height: 28px; font-weight: 600; letter-spacing: -0.45px; }
.gate__detail { display: block; max-width: 280px; margin: 8px auto 0; color: var(--muted); font-size: 14px; line-height: 22px; }
.gate .button { margin-top: 20px; }
.gate__note { display: block; margin-top: 12px; color: var(--muted); font-size: 12px; line-height: 18px; }

/* Sheet 内容 */
.phone-btn {
  flex: 0 0 auto;
  min-height: 0;
  padding: 4px 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--forest);
  font-size: 13px;
  font-weight: 600;
  line-height: 20px;
  text-align: right;
}
button.phone-btn { font-family: inherit; }
.phone-btn::after { border: none; }
.revoke-text { color: var(--danger); font-weight: 600; }
.textarea.slim { min-height: 72px; }
.position-card { margin-top: 8px; }
.consent-callout {
  padding: 12px;
  border-radius: var(--radius-button);
  background: var(--forest-soft);
  color: var(--muted);
  font-size: 12px;
  line-height: 20px;
}

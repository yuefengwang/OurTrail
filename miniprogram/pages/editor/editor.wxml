<wxs src="../../wxs/text.wxs" module="text" />
<!-- has-sticky 与底栏 wx:if 同条件（同 route-edit.wxml 的既定写法）：底栏是 position:fixed
     不计入文档流，页尾要靠 .page.has-sticky(120px) 留白才不被压住；denied/loading 没有底栏，
     就不该多留这一截空白。 -->
<view class="page {{!denied && !loading ? 'has-sticky' : ''}}">
  <status-panel wx:if="{{denied}}" kind="denied" title="无法编辑此活动" detail="{{denied}}" />
  <block wx:elif="{{loading}}">
    <status-panel kind="loading" title="正在载入" detail="正在准备编辑器。" />
  </block>
  <view wx:else class="stack">

    <!-- 编辑式头部：眉题 + 大标题 + 一句定位；删除草稿仍是 text 权重的次要动作。 -->
    <view class="card-header" style="align-items:flex-start;">
      <view class="section-head" style="min-width:0;flex:1;">
        <text class="eyebrow">{{savedId ? '编辑活动' : '发起一次同行'}}</text>
        <text class="page-title" style="display:block;margin-top:4px;">把出发，安排妥当。</text>
        <text class="section-sub">先填必填项，能发布就先发布；路线、图文和说明都可以稍后补。</text>
      </view>
      <view wx:if="{{isDraft}}" class="button text {{busy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy ? '' : 'onDeleteDraftOpen'}}" style="flex:0 0 auto;">删除草稿</view>
    </view>

    <!-- 复制模板（仅新建且有过往活动时）：默认收成一行，不抢快速创建的首屏。 -->
    <view wx:if="{{!savedId && myActivities.length}}" class="card" style="padding:4px 16px;">
      <view class="list-row" hover-class="button-hover" bindtap="toggleTemplateCopy">
        <view class="list-main">
          <text>从过往活动复制（可选）</text>
          <text class="list-sub">沿用名称、名额、费用与装备；时间与集合时间需要重新确认</text>
        </view>
        <text class="muted">{{templateCopyOpen ? '▾' : '›'}}</text>
      </view>
    </view>
    <view wx:if="{{!savedId && myActivities.length && templateCopyOpen}}" class="card stack-gap3">
      <form-field label="选择自己的活动模板" hint="创建一份新的草稿；不复制报名人员、车辆、授权与通知。">
        <picker range="{{myActivities}}" range-key="title" value="{{templateIndex}}" bindchange="onTemplatePick">
          <view class="picker {{templateIndex < 0 ? 'placeholder' : ''}}">
            <text class="picker-value">{{templateIndex < 0 ? '请选择' : myActivities[templateIndex].title}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
      </form-field>
      <view class="button secondary block {{templateId && !busy ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{templateId && !busy ? 'onCopyTemplate' : ''}}">创建模板副本并编辑</view>
    </view>

    <!-- 路线库预填横幅：标题与路线信息已自动带入，仍可修改 -->
    <view wx:if="{{fromRouteTitle}}" class="callout info">
      <view class="callout-title">已从路线库带入「{{fromRouteTitle}}」</view>
      <text class="small muted">名称、节点、风险与轨迹已经填好；在这里的改动不会影响路线库里的路线。</text>
    </view>

    <view class="stack" style="gap:4px;">
      <view class="segmented" aria-label="活动编辑步骤">
        <!-- 完成态只做视觉记号（.seg.done 的 ✓）：判据来自发布门的 missing，不在模板里重算 -->
        <view wx:for="{{stepLabels}}" wx:key="index" class="seg {{step === index ? 'on' : ''}} {{stepDone[index] ? 'done' : ''}}" data-step="{{index}}" bindtap="setStep">{{item}}</view>
      </view>
      <text class="small muted tabular">第 {{step + 1}} 步 / 共 {{stepLabels.length}} 步</text>
    </view>

    <!-- ========== 步骤 1：基本信息 ========== -->
    <view wx:if="{{step === 0}}" class="stack-gap3">
      <view class="section-head">
        <text class="kicker">基本信息</text>
        <text class="section-title">名称、出发时间与集合</text>
        <text class="section-sub">系统会自动估算结束时间、报名截止与集合时间；只有名称、出发时间和集合位置会拦发布。</text>
      </view>

      <!-- 步内分组（T007）：眉题用存量 .kicker，组间距由 .step-group 承载（editor.wxss） -->
      <view class="step-group">
        <view class="section-head">
          <text class="kicker">基本</text>
        </view>
        <!-- 先选路线，能自动带入名称与路线数据 -->
        <view class="card stack-gap3">
          <view class="section-head">
            <text class="section-title">从路线开始（可选，但最省事）</text>
            <text class="small muted">选一条路线或导入 GPX，名称、里程、爬升、节点和风险会自动带入。</text>
          </view>
          <view class="cluster">
            <view class="button secondary {{canChangeRoute ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{canChangeRoute ? 'onQuickRouteOpen' : ''}}">从路线库选择</view>
            <view class="button secondary {{canChangeRoute ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{canChangeRoute ? 'onImportGpx' : ''}}">导入 GPX</view>
          </view>
          <view wx:if="{{form.routeTitle}}" class="callout success">
            <text class="callout-title">已带入：{{form.routeTitle}}</text>
            <text wx:if="{{routeAutoText}}" class="small muted" style="display:block;margin-top:4px;">{{routeAutoText}}。接下来确认时间和集合位置即可。</text>
          </view>
          <text wx:if="{{!canChangeRoute}}" class="small muted">集合或行程中路线只能补充，不能更换。</text>
        </view>

        <form-field label="活动名称" hint="{{titleAutoSource || '必填。从路线或 GPX 开始会自动填写，可修改。'}}">
          <input class="input" value="{{form.title}}" maxlength="100" placeholder="这次想去哪里？如：青城后山 · 周末轻徒步" bindinput="onTitleInput" />
        </form-field>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">时间</text>
        </view>
      <view class="card stack-gap3">
        <view class="cluster" style="justify-content:space-between;">
          <text class="section-title">出发时间</text>
          <text wx:if="{{form.dt_start.date}}" class="badge success">已定</text>
        </view>
        <view wx:if="{{!form.dt_start.date}}" class="stack-gap3">
          <text class="small muted">常用时间建议，点一下填入；也可以直接选日期和时间。</text>
          <view class="cluster">
            <view wx:for="{{startSuggestions}}" wx:key="key" class="chip" hover-class="button-hover" data-key="{{item.key}}" bindtap="useSuggestedStart">{{item.label}}</view>
          </view>
        </view>
        <view class="cluster" style="flex-wrap:nowrap;">
          <picker mode="date" value="{{form.dt_start.date}}" data-key="dt_start" bindchange="onDate" style="flex:1;">
            <view class="picker {{form.dt_start.date ? '' : 'placeholder'}}">
              <text class="picker-value">{{form.dt_start.date || '选择日期'}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <picker mode="time" value="{{form.dt_start.time}}" data-key="dt_start" bindchange="onTime" style="flex:1;">
            <view class="picker {{form.dt_start.time ? '' : 'placeholder'}}">
              <text class="picker-value">{{form.dt_start.time || '选择时间'}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>
        <text class="small muted">均为北京时间。定好出发后，结束时间与报名截止会自动估算。</text>

        <view class="cluster" style="justify-content:space-between;">
          <view class="stack" style="gap:2px;min-width:0;">
            <text class="field-label">预计结束</text>
            <text class="tabular {{form.dt_end.date ? '' : 'muted'}}">{{form.dt_end.date ? form.dt_end.date + ' ' + form.dt_end.time : '待定'}}</text>
          </view>
          <view class="button text" hover-class="button-hover" data-key="dt_end" bindtap="toggleTime">{{expandedTimes.dt_end ? '收起' : '调整'}}</view>
        </view>
        <view wx:if="{{expandedTimes.dt_end}}" class="stack-gap3">
          <block wx:if="{{form.dt_start.date && form.dt_start.time}}">
            <view class="cluster">
              <view class="chip" hover-class="button-hover" data-kind="same" bindtap="onQuickEnd">当天往返</view>
              <view class="chip" hover-class="button-hover" data-kind="2" bindtap="onQuickEnd">2 天</view>
              <view class="chip" hover-class="button-hover" data-kind="3" bindtap="onQuickEnd">3 天</view>
              <view class="chip" hover-class="button-hover" data-kind="5" bindtap="onQuickEnd">5 天</view>
            </view>
            <text class="small muted">按出发时刻估算，选完可再微调。</text>
          </block>
          <text wx:else class="small muted">先填好上方出发时间，这里可以一键估算。</text>
          <view class="cluster" style="flex-wrap:nowrap;">
            <picker mode="date" value="{{form.dt_end.date}}" data-key="dt_end" bindchange="onDate" style="flex:1;">
              <view class="picker {{form.dt_end.date ? '' : 'placeholder'}}">
                <text class="picker-value">{{form.dt_end.date || '选择日期'}}</text>
              </view>
            </picker>
            <picker mode="time" value="{{form.dt_end.time}}" data-key="dt_end" bindchange="onTime" style="flex:1;">
              <view class="picker {{form.dt_end.time ? '' : 'placeholder'}}">
                <text class="picker-value">{{form.dt_end.time || '选择时间'}}</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="cluster" style="justify-content:space-between;">
          <view class="stack" style="gap:2px;min-width:0;">
            <text class="field-label">报名截止</text>
            <text class="tabular {{form.dt_deadline.date ? '' : 'muted'}}">{{form.dt_deadline.date ? form.dt_deadline.date + ' ' + form.dt_deadline.time : '待定'}}</text>
          </view>
          <view class="button text" hover-class="button-hover" data-key="dt_deadline" bindtap="toggleTime">{{expandedTimes.dt_deadline ? '收起' : '调整'}}</view>
        </view>
        <view wx:if="{{expandedTimes.dt_deadline}}" class="stack-gap3">
          <block wx:if="{{form.dt_start.date && form.dt_start.time}}">
            <view class="cluster">
              <view class="chip" hover-class="button-hover" data-days="1" bindtap="onQuickDeadline">出发前 1 天</view>
              <view class="chip" hover-class="button-hover" data-days="2" bindtap="onQuickDeadline">前 2 天</view>
              <view class="chip" hover-class="button-hover" data-days="3" bindtap="onQuickDeadline">前 3 天</view>
            </view>
            <text class="small muted">按出发时刻倒推，选完可再微调。</text>
          </block>
          <text wx:else class="small muted">先填好上方出发时间，这里可以一键倒推。</text>
          <view class="cluster" style="flex-wrap:nowrap;">
            <picker mode="date" value="{{form.dt_deadline.date}}" data-key="dt_deadline" bindchange="onDate" style="flex:1;">
              <view class="picker {{form.dt_deadline.date ? '' : 'placeholder'}}">
                <text class="picker-value">{{form.dt_deadline.date || '选择日期'}}</text>
              </view>
            </picker>
            <picker mode="time" value="{{form.dt_deadline.time}}" data-key="dt_deadline" bindchange="onTime" style="flex:1;">
              <view class="picker {{form.dt_deadline.time ? '' : 'placeholder'}}">
                <text class="picker-value">{{form.dt_deadline.time || '选择时间'}}</text>
              </view>
            </picker>
          </view>
        </view>
      </view>
      </view>

      <!-- 缺项=warning（拦发布），可后补=info（不拦）——层级只换语气，文案零改动 -->
      <view wx:if="{{!publishReady}}" class="callout warning">
        <text class="callout-title">还差：{{requiredMissingText}}</text>
        <text class="small muted" style="display:block;margin-top:4px;">补齐后底栏会直接出现「发布活动」，不要求先写完介绍。</text>
      </view>
    </view>

    <!-- ========== 步骤 2：路线与集合 ========== -->
    <view wx:if="{{step === 1}}" class="stack-gap3">
      <view class="section-head">
        <text class="kicker">路线与集合</text>
        <text class="section-title">走哪条路，在哪集合</text>
        <text class="section-sub">有路线就自动带入；没有也能先发布。集合点是发布必填。</text>
      </view>

      <view class="card stack-gap3">
        <view class="cluster" style="justify-content:space-between;">
          <text class="section-title">路线</text>
          <text wx:if="{{form.routeTitle}}" class="badge neutral">{{form.routeTitle}}</text>
        </view>
        <text wx:if="{{routeAutoText}}" class="small muted">{{routeAutoText}}</text>
        <text wx:else class="small muted">还没有路线。没有路线也能发布，之后可以在活动编辑里补。</text>
        <view class="cluster">
          <view class="button secondary {{canChangeRoute ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{canChangeRoute ? 'onQuickRouteOpen' : ''}}">{{form.routeTitle ? '更换路线' : '从路线库选择'}}</view>
          <view class="button secondary {{canChangeRoute ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{canChangeRoute ? 'onImportGpx' : ''}}">导入 GPX</view>
        </view>
        <view wx:if="{{form.routeTitle || form.points.length}}" class="cluster cluster-row-tap" style="justify-content:space-between;" hover-class="button-hover" bindtap="toggleRouteDetails">
          <text class="small muted">{{form.points.length}} 个节点 · {{form.risks.length}} 条风险</text>
          <text class="muted">{{routeDetailsOpen ? '收起' : '查看/调整'}} ›</text>
        </view>

        <block wx:if="{{routeDetailsOpen}}">
          <view class="step-group">
            <view class="section-head">
              <text class="kicker">路线指标</text>
            </view>
            <form-field label="路线名称" hint="可后补；从路线库或 GPX 带入">
              <input class="input" value="{{form.routeTitle}}" data-key="routeTitle" bindinput="onField" />
            </form-field>
            <view class="cluster" style="align-items:flex-start;">
              <form-field label="距离（km）" hint="自动获取，可修改" style="flex:1;">
                <input class="input" type="digit" value="{{form.distanceKm}}" data-key="distanceKm" bindinput="onField" />
              </form-field>
              <form-field label="爬升（m）" hint="不确定可留空" style="flex:1;">
                <input class="input" type="number" value="{{form.ascentM}}" data-key="ascentM" bindinput="onField" />
              </form-field>
            </view>
            <form-field label="路线难度（可选）" hint="由组织者判断，不从里程自动推导；不填就是未标注">
              <picker range="{{difficultyOptions}}" range-key="label" value="{{form.difficulty === 'easy' ? 1 : form.difficulty === 'moderate' ? 2 : form.difficulty === 'hard' ? 3 : 0}}" bindchange="onDifficulty">
                <view class="picker">
                  <text class="picker-value">{{form.difficulty === 'easy' ? '轻松' : form.difficulty === 'moderate' ? '中等' : form.difficulty === 'hard' ? '挑战' : '未标注'}}</text>
                  <text class="picker-arrow">▾</text>
                </view>
              </picker>
            </form-field>
          </view>

          <view class="step-group">
            <view class="section-head">
              <text class="kicker">路线节点</text>
            </view>
            <view class="cluster" style="justify-content:space-between;">
              <text class="section-title">路线节点（可后补）</text>
              <view wx:if="{{!form.points.length}}" class="button text" hover-class="button-hover" bindtap="useSampleRoute">用示例路线</view>
            </view>
          <text class="small muted">节点是你计划经过的关键位置（起点、垭口、终点……），用于途中清点与进度确认。</text>
          <block wx:for="{{form.points}}" wx:key="id">
            <view
              wx:if="{{!expandedPoints[item.id]}}"
              class="card"
              style="padding:12px 16px;"
              hover-class="button-hover"
              data-id="{{item.id}}"
              bindtap="togglePoint"
            >
              <view class="cluster" style="justify-content:space-between;">
                <view class="cluster" style="gap:8px;min-width:0;">
                  <text class="badge neutral tabular">{{index + 1}}</text>
                  <text style="font-weight:600;">{{item.name || (item.kind === 'start' ? '起点' : item.kind === 'finish' ? '终点' : '节点 ' + index)}}</text>
                </view>
                <view class="cluster" style="gap:8px;flex:0 0 auto;">
                  <text class="badge {{item.kind === 'start' ? 'success' : item.kind === 'finish' ? 'info' : 'neutral'}}">{{item.kind === 'start' ? '起点' : item.kind === 'finish' ? '终点' : '途中'}}</text>
                  <text class="muted">›</text>
                </view>
              </view>
            </view>
            <view wx:else class="card stack-gap3">
              <view class="cluster" style="justify-content:space-between;">
                <text class="card-label">节点 {{index + 1}}</text>
                <view class="button text" hover-class="button-hover" data-id="{{item.id}}" bindtap="togglePoint">收起</view>
              </view>
              <form-field label="节点名称" hint="发布前需为每个节点命名；GPX 导入的通常会自带名称">
                <input class="input" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="onRoutePoint" />
              </form-field>
              <form-field label="节点类型">
                <picker range="{{['起点', '途中节点', '终点']}}" value="{{item.kind === 'start' ? 0 : item.kind === 'finish' ? 2 : 1}}" data-index="{{index}}" bindchange="onPointKind">
                  <view class="picker">
                    <text class="picker-value">{{item.kind === 'start' ? '起点' : item.kind === 'finish' ? '终点' : '途中节点'}}</text>
                    <text class="picker-arrow">▾</text>
                  </view>
                </picker>
              </form-field>
              <view class="stack-gap3">
                <view class="cluster" style="justify-content:space-between;">
                  <text class="field-label">位置（可选）</text>
                  <view class="button text" hover-class="button-hover" data-id="{{item.id}}" bindtap="togglePointCoords">{{showPointCoords[item.id] ? '收起手动输入' : '手动输入'}}</view>
                </view>
                <view class="button secondary block" hover-class="button-hover" data-index="{{index}}" bindtap="choosePointLocation">
                  <icon name="pin" size="16" color="#163E35" />
                  <text>在地图上选点{{item.lat ? '（已设置）' : ''}}</text>
                </view>
                <block wx:if="{{showPointCoords[item.id]}}">
                  <view class="cluster" style="align-items:flex-start;">
                    <form-field label="纬度" style="flex:1;">
                      <input class="input" type="digit" value="{{item.lat}}" data-index="{{index}}" data-key="lat" bindinput="onRoutePoint" />
                    </form-field>
                    <form-field label="经度" style="flex:1;">
                      <input class="input" type="digit" value="{{item.lng}}" data-index="{{index}}" data-key="lng" bindinput="onRoutePoint" />
                    </form-field>
                  </view>
                </block>
              </view>
              <view class="button text" hover-class="button-hover" data-index="{{index}}" catchtap="removePoint">移除此节点</view>
            </view>
          </block>
          <view class="button secondary block" hover-class="button-hover" bindtap="addPoint">
            <icon name="plus" size="18" color="#163E35" />
            <text>添加路线节点</text>
          </view>
          </view>

          <view wx:if="{{form.points.length}}" class="step-group">
            <view class="section-head">
              <text class="kicker">节点日程</text>
            </view>
            <text class="small muted">{{scheduleBasis}}</text>
            <view wx:if="{{scheduleRows.length}}" class="timeline">
              <view wx:for="{{scheduleRows}}" wx:key="id" class="timeline-item">
                <view class="cluster" style="justify-content:space-between;align-items:flex-start;">
                  <view style="min-width:0;">
                    <text class="eyebrow">{{item.indexText}}</text>
                    <text style="display:block;font-weight:600;margin-top:2px;">{{item.name}}</text>
                  </view>
                  <text class="{{item.known ? 'small tabular' : 'small muted'}}" style="flex:0 0 auto;">{{item.label}}</text>
                </view>
              </view>
            </view>
            <text wx:if="{{scheduleSpanDays > 1}}" class="small muted">全程跨越 {{scheduleSpanDays}} 天。</text>
            <text wx:if="{{scheduleSpanDays}}" class="small muted">日程只按轨迹时间差推算，不能手工调整；要改时间请重新导入带时间的 GPX。</text>
          </view>
        </block>
      </view>

      <view class="section-head">
        <text class="kicker">集合</text>
        <text class="section-title">在哪集合</text>
        <text class="section-sub">发布必填至少 1 个集合点；地图选点会同时填好名称、地址与坐标。</text>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">上车点</text>
        </view>
      <view wx:if="{{!form.pickups.length}}" class="card stack-gap3">
        <text>还没有集合点。选一个地图位置最快；也可以先手动添加，地址之后补。</text>
        <view class="button secondary block" hover-class="button-hover" bindtap="chooseNewPickupLocation">
          <icon name="pin" size="16" color="#163E35" />
          <text>在地图上选集合点</text>
        </view>
        <view wx:if="{{form.points.length}}" class="button text" hover-class="button-hover" bindtap="useStartAsPickup">用路线起点生成集合点</view>
        <view class="button text" hover-class="button-hover" bindtap="addPickup">手动添加</view>
      </view>

      <block wx:for="{{form.pickups}}" wx:key="id">
        <view wx:if="{{!editingPickups[item.id]}}" class="card" hover-class="button-hover" data-id="{{item.id}}" bindtap="togglePickup">
          <view class="cluster" style="justify-content:space-between;align-items:flex-start;">
            <view class="cluster" style="gap:8px;min-width:0;">
              <text class="badge neutral tabular">{{index + 1}}</text>
              <text style="font-weight:600;">{{item.name || '上车点 ' + (index + 1)}}</text>
            </view>
            <view class="button text" hover-class="button-hover" data-id="{{item.id}}" catchtap="togglePickup">编辑</view>
          </view>
          <text wx:if="{{item.address}}" style="display:block;margin-top:6px;">{{item.address}}</text>
          <text wx:else class="small muted" style="display:block;margin-top:6px;">还没写集合位置，点「编辑」补一句。</text>
          <view class="cluster" style="gap:8px;margin-top:6px;">
            <text class="small tabular">{{item.meeting.date || '待定'}} {{item.meeting.time}}</text>
            <text wx:if="{{item.lat}}" class="small muted">· 已定位</text>
          </view>
        </view>
        <view wx:else class="card stack-gap3">
          <view class="cluster" style="justify-content:space-between;">
            <text class="card-label">上车点 {{index + 1}}</text>
            <view class="button text" hover-class="button-hover" data-id="{{item.id}}" bindtap="togglePickup">完成</view>
          </view>
          <form-field label="上车点名称">
            <input class="input" value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="onPickup" />
          </form-field>
          <form-field label="详细集合位置" hint="必填。写清楚从哪儿进、认什么标志物；地图选点会自动填。">
            <input class="input" value="{{item.address}}" data-index="{{index}}" data-key="address" bindinput="onPickup" />
          </form-field>
          <view class="button secondary block" hover-class="button-hover" data-index="{{index}}" bindtap="choosePickupLocation">
            <icon name="pin" size="16" color="#163E35" />
            <text>在地图上选点{{item.lat ? '（已设置）' : ''}}</text>
          </view>
          <view class="stack-gap3">
            <view class="cluster" style="justify-content:space-between;">
              <text class="field-label">集合时间</text>
              <text class="small tabular">{{item.meeting.date || '待定'}} {{item.meeting.time}}</text>
            </view>
            <block wx:if="{{form.dt_start.date && form.dt_start.time}}">
              <view class="cluster">
                <view class="chip" hover-class="button-hover" data-index="{{index}}" data-offset="0" bindtap="onPickupQuickTime">与出发同时</view>
                <view class="chip" hover-class="button-hover" data-index="{{index}}" data-offset="-30" bindtap="onPickupQuickTime">提前 30 分</view>
                <view class="chip" hover-class="button-hover" data-index="{{index}}" data-offset="-60" bindtap="onPickupQuickTime">提前 1 小时</view>
              </view>
            </block>
            <text wx:else class="small muted">填好步骤 1 的出发时间后，这里可一键估算；日期默认出发日。</text>
            <view class="cluster" style="flex-wrap:nowrap;">
              <picker mode="date" value="{{item.meeting.date}}" data-index="{{index}}" bindchange="onPickupDate" style="flex:1;">
                <view class="picker {{item.meeting.date ? '' : 'placeholder'}}">
                  <text class="picker-value">{{item.meeting.date || '日期'}}</text>
                </view>
              </picker>
              <picker mode="time" value="{{item.meeting.time}}" data-index="{{index}}" bindchange="onPickupTime" style="flex:1;">
                <view class="picker {{item.meeting.time ? '' : 'placeholder'}}">
                  <text class="picker-value">{{item.meeting.time || '时间'}}</text>
                </view>
              </picker>
            </view>
          </view>
          <view class="cluster" style="justify-content:space-between;">
            <text class="field-label">坐标（可选）</text>
            <view class="button text" hover-class="button-hover" data-id="{{item.id}}" bindtap="togglePickupCoords">{{showPickupCoords[item.id] ? '收起手动输入' : '手动输入'}}</view>
          </view>
          <block wx:if="{{showPickupCoords[item.id]}}">
            <view class="cluster" style="align-items:flex-start;">
              <form-field label="纬度" style="flex:1;">
                <input class="input" type="digit" value="{{item.lat}}" data-index="{{index}}" data-key="lat" bindinput="onPickup" />
              </form-field>
              <form-field label="经度" style="flex:1;">
                <input class="input" type="digit" value="{{item.lng}}" data-index="{{index}}" data-key="lng" bindinput="onPickup" />
              </form-field>
            </view>
          </block>
          <view class="button text" hover-class="button-hover" data-index="{{index}}" catchtap="removePickup">移除此上车点</view>
        </view>
      </block>
      <view wx:if="{{form.pickups.length}}" class="button secondary block" hover-class="button-hover" bindtap="addPickup">
        <icon name="plus" size="18" color="#163E35" />
        <text>添加上车点</text>
      </view>
      </view>
    </view>

    <!-- ========== 步骤 3：介绍（可选） ========== -->
    <view wx:if="{{step === 2}}" class="stack-gap3">
      <view class="section-head">
        <text class="kicker">介绍（可选）</text>
        <text class="section-title">想写就写，不写也能发布</text>
        <text class="section-sub">写几句话、配几张图，报名的人更容易判断；不需要先建段落卡片。</text>
      </view>

      <content-editor
        initial-content="{{form.content}}"
        initial-cover="{{form.coverFileId}}"
        reset-key="{{contentResetKey}}"
        bind:change="onContentChange"
        bind:busy="onContentBusy"
      />

      <view class="card stack-gap3">
        <view class="cluster cluster-row-tap" style="justify-content:space-between;" hover-class="button-hover" bindtap="toggleIntro">
          <text style="font-weight:600;">简介与推荐理由（可选）</text>
          <view class="cluster" style="gap:8px;">
            <text wx:if="{{form.description || form.organizerIntro || form.highlightsText}}" class="badge success">已填写</text>
            <text class="muted">{{expandedIntro ? '▾' : '›'}}</text>
          </view>
        </view>
        <block wx:if="{{expandedIntro}}">
          <form-field label="一句话简介" hint="一两句话；卡片和搜索会用">
            <textarea class="textarea slim" value="{{form.description}}" maxlength="2000" placeholder="可选。比如：周末轻徒步，适合第一次上山的人" data-key="description" bindinput="onField" />
          </form-field>
          <form-field label="组织者与协作说明">
            <textarea class="textarea slim" value="{{form.organizerIntro}}" maxlength="2000" placeholder="可选。谁带队、如何分工协作" data-key="organizerIntro" bindinput="onField" />
          </form-field>
          <form-field label="推荐理由" hint="一行一条；详情页会以要点展示">
            <textarea class="textarea slim" value="{{form.highlightsText}}" maxlength="2000" placeholder="如：直面主峰，云海日出；路线成熟，适合有一定经验的爱好者" data-key="highlightsText" bindinput="onField" />
          </form-field>
        </block>
      </view>
      <text wx:if="{{contentBusy}}" class="small muted">图片正在上传/检查，完成后才能保存、发布或切换步骤。</text>
    </view>

    <!-- ========== 步骤 4：发布 ========== -->
    <view wx:if="{{step === 3}}" class="stack-gap3">
      <view class="section-head">
        <text class="kicker">发布</text>
        <text class="section-title">名额与可选说明</text>
        <text class="section-sub">名额已默认 24 人、手动审核；不改也能直接发布。</text>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">名额审核</text>
        </view>
      <view class="card stack-gap3">
        <view class="cluster" style="justify-content:space-between;">
          <text class="section-title">名额与报名</text>
          <text class="small muted">{{form.capacity}} 人 · {{form.approvalMode === 'manual' ? '手动审核' : '自动确认'}}</text>
        </view>
        <view class="cluster" style="align-items:flex-start;">
          <form-field label="人数上限" hint="1–500 人，待审核与已确认都占名额" style="flex:1;">
            <input class="input" type="number" value="{{form.capacity}}" data-key="capacity" bindinput="onField" />
          </form-field>
          <form-field label="报名确认方式" style="flex:1;">
            <picker range="{{['组织者手动审核', '符合条件自动确认']}}" bindchange="onApproval">
              <view class="picker">
                <text class="picker-value">{{form.approvalMode === 'manual' ? '手动审核' : '自动确认'}}</text>
                <text class="picker-arrow">▾</text>
              </view>
            </picker>
          </form-field>
        </view>
        <checkbox-group bindchange="onAccepting">
          <label class="check-label">
            <checkbox color="#163E35" value="on" checked="{{form.acceptingSignups}}" />
            <text class="check-text">发布后开放报名</text>
          </label>
        </checkbox-group>
      </view>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">可见范围</text>
        </view>
        <view class="card stack-gap3">
          <view class="cluster" style="justify-content:space-between;">
            <text class="section-title">谁能看到这个活动</text>
            <text class="small muted">{{form.visibility === 'link' ? '仅链接可见' : '公开到发现页'}}</text>
          </view>
          <picker range="{{['公开到发现页', '仅通过分享链接可见']}}" bindchange="onVisibility">
            <view class="picker">
              <text class="picker-value">{{form.visibility === 'link' ? '仅通过分享链接可见' : '公开到发现页'}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <text class="small muted">{{form.visibility === 'link' ? '不出现在发现页；拿到分享链接的人仍可查看并报名。' : '发布后会出现在发现页，其他户外爱好者可以搜索到。'}}</text>
        </view>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">费用文本</text>
        </view>
      <view class="card stack-gap3">
        <view class="cluster cluster-row-tap" style="justify-content:space-between;" hover-class="button-hover" bindtap="toggleDetailExtras">
          <text style="font-weight:600;">活动说明与费用（可选）</text>
          <view class="cluster" style="gap:8px;">
            <text wx:if="{{form.leader || form.feeSummary || form.feeIncludesText || form.feeExcludesText || form.signupNote || form.minParticipants || form.sceneryRating || form.funRating}}" class="badge success">已填写</text>
            <text class="muted">{{detailExtrasOpen ? '▾' : '›'}}</text>
          </view>
        </view>
        <block wx:if="{{detailExtrasOpen}}">
          <form-field label="领队/发起团队" hint="一行；如「友友部落领队天团」">
            <input class="input" value="{{form.leader}}" maxlength="100" data-key="leader" bindinput="onField" />
          </form-field>
          <form-field label="成行人数" hint="只作展示；不填则只显示人数上限">
            <input class="input" type="number" value="{{form.minParticipants}}" data-key="minParticipants" bindinput="onField" />
          </form-field>
          <view class="cluster" style="justify-content:space-between;">
            <text class="field-label">风景指数</text>
            <view class="cluster" style="gap:6px;">
              <view wx:for="{{ratingOptions}}" wx:key="*this" class="chip {{form.sceneryRating >= item ? 'on' : ''}}" data-key="sceneryRating" data-value="{{item}}" bindtap="onRating">{{item}}</view>
            </view>
          </view>
          <view class="cluster" style="justify-content:space-between;">
            <text class="field-label">腐败指数</text>
            <view class="cluster" style="gap:6px;">
              <view wx:for="{{ratingOptions}}" wx:key="*this" class="chip {{form.funRating >= item ? 'on' : ''}}" data-key="funRating" data-value="{{item}}" bindtap="onRating">{{item}}</view>
            </view>
          </view>
          <form-field label="费用摘要" hint="一行；详情页活动说明会显示">
            <input class="input" value="{{form.feeSummary}}" maxlength="200" data-key="feeSummary" bindinput="onField" placeholder="如：住木屋 498/人；露营 398/人" />
          </form-field>
          <form-field label="费用包含" hint="一行一条">
            <textarea class="textarea slim" value="{{form.feeIncludesText}}" data-key="feeIncludesText" bindinput="onField" placeholder="如：大巴&#10;住宿&#10;领队" />
          </form-field>
          <form-field label="费用不含" hint="一行一条">
            <textarea class="textarea slim" value="{{form.feeExcludesText}}" data-key="feeExcludesText" bindinput="onField" placeholder="如：餐食&#10;中转车" />
          </form-field>
          <form-field label="报名后须知" hint="如拉群方式、行前准备；详情页会显示">
            <textarea class="textarea slim" value="{{form.signupNote}}" maxlength="2000" data-key="signupNote" bindinput="onField" />
          </form-field>
        </block>
      </view>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">风险</text>
        </view>
      <view class="card stack-gap3">
        <view class="cluster cluster-row-tap" style="justify-content:space-between;" hover-class="button-hover" bindtap="toggleRisks">
          <text style="font-weight:600;">风险提示（可选）</text>
          <view class="cluster" style="gap:8px;">
            <text class="badge {{form.risks.length ? 'warning' : 'neutral'}}">{{form.risks.length ? form.risks.length + ' 条' : '未填'}}</text>
            <text class="muted">{{risksOpen ? '▾' : '›'}}</text>
          </view>
        </view>
        <block wx:if="{{risksOpen}}">
          <text class="small muted">逐条确认问题与应对。填了就必须完整；不填也能发布，但建议尽早补上。</text>
          <block wx:for="{{form.risks}}" wx:key="id">
            <view wx:if="{{!editingRisks[item.id]}}" class="card" hover-class="button-hover" data-id="{{item.id}}" bindtap="toggleRisk">
              <view class="cluster" style="justify-content:space-between;align-items:flex-start;">
                <view class="cluster" style="gap:8px;min-width:0;">
                  <text class="badge warning tabular">{{index + 1}}</text>
                  <text style="font-weight:600;">{{item.title || '风险 ' + (index + 1)}}</text>
                </view>
                <view class="button text" hover-class="button-hover" data-id="{{item.id}}" catchtap="toggleRisk">编辑</view>
              </view>
              <text wx:if="{{item.advice}}" style="display:block;margin-top:8px;line-height:1.6;">{{item.advice}}</text>
              <text wx:else class="small muted" style="display:block;margin-top:8px;">还没写应对方式，点「编辑」补充。</text>
            </view>
            <view wx:else class="card stack-gap3">
              <view class="cluster" style="justify-content:space-between;">
                <text class="card-label">风险 {{index + 1}}</text>
                <view class="button text" hover-class="button-hover" data-id="{{item.id}}" bindtap="toggleRisk">完成</view>
              </view>
              <form-field label="可能出的问题">
                <input class="input" value="{{item.title}}" data-index="{{index}}" data-key="title" bindinput="onRisk" placeholder="如：垭口风大气温骤降、碎石坡湿滑" />
              </form-field>
              <form-field label="应对方式">
                <textarea class="textarea slim" value="{{item.advice}}" data-index="{{index}}" data-key="advice" bindinput="onRisk" placeholder="如：查好天气窗再出发，全员备防风衣物，控制队伍间距" />
              </form-field>
              <view class="button text" hover-class="button-hover" data-index="{{index}}" catchtap="removeRisk">移除此风险</view>
            </view>
          </block>
          <view class="button secondary block" hover-class="button-hover" bindtap="addRisk">添加风险提示</view>
        </block>
      </view>
      </view>

      <view class="step-group">
        <view class="section-head">
          <text class="kicker">装备</text>
        </view>
      <view class="card stack-gap3">
        <view class="cluster cluster-row-tap" style="justify-content:space-between;" hover-class="button-hover" bindtap="toggleExtras">
          <text style="font-weight:600;">装备与费用说明（可选）</text>
          <view class="cluster" style="gap:8px;">
            <text wx:if="{{form.equipmentText || form.equipmentSuggestedText || form.feeNote || form.cancellationNote}}" class="badge success">已填写</text>
            <text style="color:var(--forest);font-weight:600;">{{editingExtras ? '完成' : '编辑'}}</text>
          </view>
        </view>

        <block wx:if="{{!editingExtras}}">
          <block wx:if="{{form.equipmentText || form.equipmentSuggestedText || form.feeNote || form.cancellationNote}}">
            <block wx:if="{{form.equipmentText}}">
              <text class="field-label">必带装备</text>
              <view class="cluster" style="margin-top:8px;">
                <text wx:for="{{text.lines(form.equipmentText)}}" wx:key="*this" class="badge neutral">{{item}}</text>
              </view>
            </block>
            <block wx:if="{{form.equipmentSuggestedText}}">
              <text class="field-label" style="display:block;margin-top:12px;">建议携带</text>
              <view class="cluster" style="margin-top:8px;">
                <text wx:for="{{text.lines(form.equipmentSuggestedText)}}" wx:key="*this" class="badge neutral">{{item}}</text>
              </view>
            </block>
            <block wx:if="{{form.feeNote}}">
              <text class="field-label" style="display:block;margin-top:12px;">费用说明</text>
              <text style="display:block;margin-top:4px;line-height:1.6;">{{form.feeNote}}</text>
            </block>
            <block wx:if="{{form.cancellationNote}}">
              <text class="field-label" style="display:block;margin-top:12px;">取消与退出约定</text>
              <text style="display:block;margin-top:4px;line-height:1.6;">{{form.cancellationNote}}</text>
            </block>
          </block>
          <text wx:else class="small muted">装备、费用与取消约定都不填也可以发布；点「编辑」补充。</text>
        </block>

        <block wx:else>
          <view class="stack-gap3">
            <text class="field-label">必带装备</text>
            <view wx:if="{{text.lines(form.equipmentText).length}}" class="cluster">
              <view
                wx:for="{{text.lines(form.equipmentText)}}"
                wx:key="*this"
                class="chip"
                hover-class="button-hover"
                data-group="equipment"
                data-index="{{index}}"
                bindtap="removeEquipment"
              >{{item}} ×</view>
            </view>
            <text wx:else class="small muted">还没有必带装备。</text>
            <view class="cluster" style="flex-wrap:nowrap;">
              <input class="input" style="flex:1;" value="{{equipmentDraft}}" data-key="equipmentDraft" bindinput="onEquipmentDraft" placeholder="如：防滑徒步鞋" confirm-type="done" data-group="equipment" bindconfirm="addEquipment" />
              <view class="button secondary" hover-class="button-hover" data-group="equipment" bindtap="addEquipment">添加</view>
            </view>
            <text class="small muted">发布后参与者的行前检查以「必带」为准；点一项可移除。</text>
          </view>
          <view class="stack-gap3">
            <text class="field-label">建议携带</text>
            <view wx:if="{{text.lines(form.equipmentSuggestedText).length}}" class="cluster">
              <view
                wx:for="{{text.lines(form.equipmentSuggestedText)}}"
                wx:key="*this"
                class="chip"
                hover-class="button-hover"
                data-group="suggested"
                data-index="{{index}}"
                bindtap="removeEquipment"
              >{{item}} ×</view>
            </view>
            <text wx:else class="small muted">还没有建议携带清单。</text>
            <view class="cluster" style="flex-wrap:nowrap;">
              <input class="input" style="flex:1;" value="{{equipmentSuggestedDraft}}" data-key="equipmentSuggestedDraft" bindinput="onEquipmentDraft" placeholder="如：登山杖" confirm-type="done" data-group="suggested" bindconfirm="addEquipment" />
              <view class="button secondary" hover-class="button-hover" data-group="suggested" bindtap="addEquipment">添加</view>
            </view>
            <text class="small muted">仅作建议，不当作必带承诺；可留空。</text>
          </view>
          <form-field label="费用说明" hint="仅说明费用，线下结算；不收款。">
            <textarea class="textarea slim" value="{{form.feeNote}}" data-key="feeNote" bindinput="onField" />
          </form-field>
          <form-field label="取消与退出约定">
            <textarea class="textarea slim" value="{{form.cancellationNote}}" data-key="cancellationNote" bindinput="onField" />
          </form-field>
        </block>
      </view>
      </view>

      <view wx:if="{{publishReady}}" class="callout success">
        <text class="callout-title">必填项已齐，可以直接发布。</text>
        <text class="small muted" style="display:block;margin-top:4px;">图文、路线、风险与费用都能发布后继续补。</text>
      </view>
      <!-- 缺项=warning（拦发布），可后补=info（不拦）——层级只换语气，文案零改动 -->
      <view wx:else class="callout warning">
        <text class="callout-title">还差：{{requiredMissingText}}</text>
      </view>
    </view>

    <view wx:if="{{failure}}" class="callout danger">{{failure}}</view>
    <view wx:if="{{profileGate}}" class="callout warning">
      <text class="callout-title">发布前需要同行资料</text>
      <text style="display:block;margin-top:4px;">用微信头像、昵称和手机号补全后，会自动继续刚才的保存或发布；也可以手动填写。</text>
    </view>
    <view wx:if="{{profileGate}}" class="button secondary block" hover-class="button-hover" bindtap="onOpenProfileGate">补全资料后继续</view>
    <view wx:if="{{message}}" class="callout success">{{message}}</view>

    <view class="form-actions">
      <view class="button secondary {{busy || contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || contentBusy ? '' : 'onSave'}}">{{saveLabel}}</view>
      <view class="button secondary {{busy || contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || contentBusy ? '' : 'onSavePreview'}}">保存并预览</view>
    </view>
    <text wx:if="{{draftSavedAt}}" class="small muted" style="text-align:center;">草稿已自动保存 · {{draftSavedAt}}</text>
  </view>

  <!-- 固定底栏：必填齐了就把「发布活动」提为主操作，任意步骤都能直接发；「继续完善」仍可往下走。 -->
  <view wx:if="{{!denied && !loading}}" class="sticky-action">
    <view wx:if="{{step > 0}}" class="button text {{contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{contentBusy ? '' : 'prevStep'}}">上一步</view>
    <block wx:if="{{step < 3}}">
      <view wx:if="{{publishReady && isDraft}}" class="button primary block {{busy || contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || contentBusy ? '' : 'onPublishIntent'}}">发布活动</view>
      <view wx:else class="button primary block {{contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{contentBusy ? '' : 'nextStep'}}" style="flex:1;">
        <text>下一步</text>
        <icon name="arrow" size="18" color="#FFFFFF" />
      </view>
      <view wx:if="{{publishReady && isDraft}}" class="button text {{contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{contentBusy ? '' : 'nextStep'}}">继续完善</view>
    </block>
    <view wx:if="{{step === 3 && isDraft}}" class="button primary block {{busy || contentBusy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || contentBusy ? '' : 'onPublishIntent'}}">发布活动</view>
  </view>

  <overlay open="{{deleteDraftOpen}}" kind="dialog" title="删除这份草稿？" bind:close="onDeleteDraftClose">
    <view class="stack">
      <text>删除后不可恢复：路线节点、风险与装备预填都会丢失。已保存的私有路线会保留在你的账号下。{{savedId ? '' : '此草稿还未保存到服务器，删除只清除本机草稿。'}}</text>
      <view class="button text" hover-class="button-hover" bindtap="onDeleteDraftClose">再想想</view>
      <view class="button danger block {{busy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy ? '' : 'onDeleteDraftConfirm'}}">确认删除</view>
    </view>
  </overlay>

  <overlay open="{{publishOpen}}" kind="dialog" title="准备好发布了吗？" bind:close="onPublishClose">
    <view class="stack">
      <view class="card stack-gap3">
        <text class="section-title">{{form.title || '未命名活动'}}</text>
        <text class="small muted">{{publishSummaryText}}</text>
      </view>
      <view wx:if="{{deferred.length}}" class="callout info">
        <view class="callout-title">这些还没填，发布后随时可补</view>
        <text class="small muted" style="display:block;margin-top:4px;">{{deferredText}}。报名的人在发布前看不到这些信息；补上后立即对所有人可见。</text>
        <view class="button text" hover-class="button-hover" bindtap="onDeferredFix">去补上</view>
      </view>
      <text>发布后参与者即可报名。报名、同行人和车辆数据不会自动创建。</text>
      <checkbox-group bindchange="onParticipate">
        <label class="check-label">
          <checkbox color="#163E35" value="on" checked="{{participate}}" />
          <text class="check-text">我本人也参加（发布后自动为我报名）</text>
        </label>
      </checkbox-group>
      <block wx:if="{{participate}}">
        <text class="small muted">发布后以你的常用资料报名。请先在「我的」检查本人及紧急联络信息。</text>
        <form-field label="本人出行方式">
          <radio-group bindchange="onTripChange">
            <label class="radio-label" wx:for="{{tripModes}}" wx:for-item="opt" wx:key="value">
              <radio color="#163E35" value="{{opt.value}}" checked="{{(tripSelf ? 'self' : 'shared') === opt.value}}" />
              <view class="check-text">
                <text>{{opt.label}}</text>
                <text class="small muted" style="display:block;">{{opt.hint}}</text>
              </view>
            </label>
          </radio-group>
        </form-field>
        <form-field wx:if="{{!tripSelf}}" label="选择上车点">
          <picker range="{{form.pickups}}" range-key="name" value="{{tripPickupIndex}}" bindchange="onTripPickup">
            <view class="picker {{tripPickupIndex < 0 ? 'placeholder' : ''}}">
              <text class="picker-value">{{tripPickupIndex < 0 ? '请选择上车点' : form.pickups[tripPickupIndex].name}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </form-field>
        <checkbox-group bindchange="onDataUse">
          <label class="check-label">
            <checkbox color="#163E35" value="on" checked="{{dataUse}}" />
            <text class="check-text">独立同意本次活动使用我的报名与安全联络资料</text>
          </label>
        </checkbox-group>
      </block>
      <view wx:if="{{failure}}" class="callout danger">{{failure}}</view>
      <view class="button primary block {{busy || (participate && !dataUse) ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{busy || (participate && !dataUse) ? '' : 'publish'}}">
        确认发布
      </view>
    </view>
  </overlay>

  <overlay open="{{quickRouteOpen}}" kind="sheet" title="从路线库选择" bind:close="onQuickRouteClose">
    <view class="stack">
      <view wx:if="{{quickRouteLoading}}" class="small muted">正在读取你的路线…</view>
      <view wx:elif="{{quickRouteError}}" class="stack-gap3">
        <view class="callout danger">{{quickRouteError}}</view>
        <view class="button secondary block" hover-class="button-hover" bindtap="onQuickRouteRetry">重试</view>
      </view>
      <block wx:elif="{{quickRouteTotal}}">
        <text class="small muted">路线会作为活动快照带入；之后对路线库的修改不会影响这场活动。</text>
        <input class="input" value="{{quickRouteQuery}}" placeholder="搜索路线名称" bindinput="onQuickRouteSearch" />
        <text wx:if="{{quickRouteMatched > quickRouteShown}}" class="small muted">共 {{quickRouteMatched}} 条，只显示最近 {{quickRouteShown}} 条；输入名称可继续筛选。</text>
        <view wx:if="{{quickRoutes.length}}" class="card" style="padding:4px 16px;">
          <view wx:for="{{quickRoutes}}" wx:key="id" class="list-row" hover-class="button-hover" data-id="{{item.id}}" bindtap="{{quickRouteBusyId ? '' : 'onQuickRoutePick'}}">
            <view class="list-main">
              <view class="cluster" style="gap:8px;">
                <text style="font-weight:600;">{{item.title}}</text>
                <text class="badge {{item.badge === '我的' ? 'neutral' : 'info'}}">{{item.badge}}</text>
              </view>
              <text class="list-sub">{{item.statsText}}</text>
              <text class="list-sub">{{item.ownerText}}</text>
            </view>
            <text wx:if="{{quickRouteBusyId === item.id}}" class="small muted">读取中…</text>
            <icon wx:else name="arrow" size="20" color="#5F6E66" />
          </view>
        </view>
        <view wx:else class="callout info">
          <text class="callout-title">没有匹配的路线</text>
          <text class="small muted" style="display:block;margin-top:4px;">换个关键词试试，或直接导入 GPX。</text>
        </view>
      </block>
      <block wx:else>
        <view class="callout info">
          <text class="callout-title">路线库还是空的</text>
          <text class="small muted" style="display:block;margin-top:4px;">可以先导入 GPX，或在发起活动后从「路线」里整理一条。</text>
        </view>
        <view class="button secondary block" hover-class="button-hover" bindtap="onQuickRouteClose">先不用路线</view>
      </block>
    </view>
  </overlay>

  <overlay open="{{routeReplaceOpen}}" kind="dialog" title="替换当前路线？" bind:close="onRouteReplaceClose">
    <view class="stack">
      <text>将用「{{pendingRouteTitle}}」替换当前的路线名称、里程、爬升、节点、风险与轨迹。时间、集合点和图文内容不受影响。</text>
      <view class="button text" hover-class="button-hover" bindtap="onRouteReplaceClose">保留当前路线</view>
      <view class="button primary block" hover-class="button-hover" bindtap="onRouteReplaceConfirm">替换</view>
    </view>
  </overlay>

  <overlay open="{{gpxOpen}}" kind="sheet" title="导入 GPX 轨迹" bind:close="onGpxClose">
    <view class="stack">
      <view wx:if="{{gpxError}}" class="callout danger">{{gpxError}}</view>
      <block wx:if="{{gpxMeta && !gpxError}}">
        <view class="callout">
          <text class="callout-title">{{gpxMeta.fileName}}</text>
          <text style="display:block;margin-top:4px;">解析出 {{gpxMeta.count}} 个路线节点{{gpxMeta.distanceKm > 0 ? ' · 全程约 ' + gpxMeta.distanceKm + ' km' : ''}}{{gpxMeta.hasElevation ? ' · 累计爬升约 ' + gpxMeta.ascentM + ' m' : ''}}。</text>
        </view>
        <view class="stack" style="gap:4px;">
          <text class="small muted">将替换当前路线节点{{gpxMeta.distanceKm > 0 ? '与里程' : ''}}{{gpxMeta.hasElevation ? '、爬升' : ''}}；集合上车点与风险提示不受影响。确认前可先核对：</text>
          <view wx:for="{{gpxPoints}}" wx:key="index" class="list-row">
            <view class="list-main">
              <text>{{item.name}}</text>
              <text class="list-sub">{{item.kind === 'start' ? '起点' : item.kind === 'finish' ? '终点' : '途中节点'}} · {{item.coordinates.lat}}, {{item.coordinates.lng}}</text>
            </view>
          </view>
          <text wx:if="{{gpxSuggest}}" class="small muted">另外会按轨迹特征预填 {{gpxSuggest.risks.length}} 条风险提示{{gpxSuggest.equipment.length ? '与 ' + gpxSuggest.equipment.length + ' 项装备' : ''}}（可核对修改，已有内容不覆盖）。</text>
        </view>
        <view class="button primary block" hover-class="button-hover" bindtap="onGpxApply">应用到路线</view>
      </block>
      <block wx:elif="{{gpxError}}">
        <text class="small muted">请确认文件是标准 GPX（含 wpt/rtept/trkpt）后重试。</text>
      </block>
      <block wx:else>
        <text class="small muted">正在读取文件…</text>
      </block>
    </view>
  </overlay>

  <profile-gate open="{{profileGateOpen}}" bind:saved="onProfileSaved" bind:close="onProfileGateClose" />
</view>

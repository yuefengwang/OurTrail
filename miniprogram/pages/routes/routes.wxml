<view class="page">
  <status-panel wx:if="{{denied}}" kind="denied" title="路线库暂不可用" detail="{{denied}}" actionLabel="重试" bind:action="reload" />
  <block wx:elif="{{loading}}">
    <status-panel kind="loading" title="正在载入" detail="正在读取你的路线。" />
  </block>
  <view wx:else class="stack">
    <view class="card">
      <text class="eyebrow">OURTRAIL · 路线库</text>
      <text class="page-title" style="display:block;margin-top:4px;">走过的路，下次直接复用。</text>
      <view class="button primary block" style="margin-top:12px;" hover-class="button-hover" bindtap="onNewRoute">
        <icon name="plus" size="18" color="#FFFFFF" />
        <text>新建路线</text>
      </view>
    </view>

    <view wx:for="{{routes}}" wx:key="id" class="card list-row" hover-class="button-hover" data-id="{{item.id}}" bindtap="onOpen">
      <view class="list-main">
        <view class="cluster" style="gap:8px;">
          <text style="font-weight:600;">{{item.title}}</text>
          <text wx:if="{{item.shared}}" class="badge info">已共享</text>
          <text wx:if="{{!item.mine}}" class="badge neutral">协作</text>
        </view>
        <text class="list-sub">{{item.statsText}}</text>
        <text class="list-sub">{{item.refText}} · {{item.sourceText}} · {{item.updatedText}}</text>
      </view>
      <text class="muted">›</text>
    </view>

    <status-panel
      wx:if="{{!routes.length}}"
      kind="empty"
      title="路线库还是空的"
      detail="创建活动时，路线会自动沉淀到这里；也可以把路线共享给同行的领队。"
    />
  </view>
</view>

<view class="page">
  <status-panel wx:if="{{denied}}" kind="denied" title="没有此工作台的访问权限" detail="{{denied}}" actionLabel="{{activityId ? '查看活动' : '回到我的活动'}}" bind:action="onDeniedAction" />
  <block wx:elif="{{loading}}">
    <status-panel kind="loading" title="正在载入" detail="正在核对当前需要关注的事。" />
  </block>
  <view wx:else class="stack">
    <view class="stack" style="gap:8px;">
      <view class="card-header">
        <text class="eyebrow">{{eyebrow}}</text>
        <text class="badge success">{{phaseLabel}}</text>
      </view>
      <text class="page-title">{{title}}</text>
      <text class="muted">{{subtitle}}</text>
    </view>

    <!-- 指标即入口：点数字直接跳到对应工作区 -->
    <view class="metrics">
      <view class="metric" hover-class="button-hover" bindtap="goRoster"><text class="metric-value">{{pending}}</text><text class="metric-label">待审核 ›</text></view>
      <view class="metric" hover-class="button-hover" bindtap="goTransport"><text class="metric-value">{{unassigned}}</text><text class="metric-label">待安排车辆 ›</text></view>
      <view class="metric" hover-class="button-hover" bindtap="goField"><text class="metric-value">{{thirdValue}}</text><text class="metric-label">{{thirdLabel}} ›</text></view>
    </view>
    <!-- 出行方式构成写在指标下面：待安排车辆只统计「需要乘车」的人，自行到达的人不是缺事项 -->
    <text class="small muted" style="display:block;margin-top:-4px;">{{tripSummaryLine}}</text>

    <view class="segmented" aria-label="工作台分区">
      <view wx:for="{{tabLabels}}" wx:key="index" class="seg {{tab === index ? 'on' : ''}}" data-tab="{{index}}" bindtap="onTab">{{item}}</view>
    </view>

    <!-- 面板保持挂载、用类名隐藏：自定义组件宿主上 hidden 属性不生效（曾导致四区内容全部平铺）；
         不用 wx:if 是为了保住各面板内的搜索词、勾选与车辆表单状态。
         bind:written：任一面板写库成功后宿主重读并下发新 sync-key，兄弟面板才不会拿旧 revision 发命令 -->
    <roster-panel class="{{tab === 1 ? '' : 'hide'}}" activity-id="{{activityId || ''}}" sync-key="{{syncKey}}" bind:written="onPanelSync" />
    <transport-panel class="{{tab === 2 ? '' : 'hide'}}" activity-id="{{activityId || ''}}" sync-key="{{syncKey}}" bind:written="onPanelSync" />
    <field-panel class="{{tab === 3 ? '' : 'hide'}}" activity-id="{{activityId || ''}}" perspective="organizer" sync-key="{{syncKey}}" bind:written="onPanelSync" />

    <block wx:if="{{tab === 0}}">
      <!-- 时间锚点：领队最该先看到的不是字段，是「还剩多久到我必须做的那一步」 -->
      <view wx:if="{{milestone}}" class="callout">
        <text class="callout-title">● {{milestone}}</text>
      </view>

      <view class="stack" style="gap:0;">
        <text class="section-title">当前待办</text>
        <!-- 待办由 journey.leaderQueue 生成：只列真的拦路的事，每条带人数与去处；
             没有拦路事时给一句话，而不是摆四个 0 让人以为都欠着 -->
        <view wx:for="{{queue}}" wx:key="id" class="list-row" hover-class="button-hover" bindtap="goQueueItem" data-target="{{item.target}}">
          <view class="list-main">
            <text>{{item.label}}{{item.blocking ? '（拦路）' : ''}}</text>
            <text class="list-sub">{{item.detail}}</text>
          </view>
          <icon name="arrow" size="18" color="#163E35" />
        </view>
        <view class="list-row" hover-class="button-hover" bindtap="goNotices">
          <view class="list-main">
            <text>活动通知</text>
            <text class="list-sub">发布安排，核对通知的实际状态</text>
          </view>
          <icon name="arrow" size="18" color="#163E35" />
        </view>
      </view>

      <view class="stack" style="gap:12px;">
        <text class="section-title">活动进程</text>
        <!-- ✓ 已完成 · ● 当前 · ○ 还没到：户外强光下不能只靠颜色承载状态（AGENTS 铁律 / 设计走查） -->
        <view class="timeline">
          <view wx:for="{{phaseTimeline}}" wx:key="phase" class="timeline-item">
            <text class="badge {{item.current ? 'on-forest' : (item.done ? 'success' : 'neutral')}}">{{item.mark}} {{item.label}}{{item.current ? ' · 当前' : ''}}</text>
          </view>
        </view>
        <view class="button primary block {{canTransition && !busy ? '' : 'disabled'}}" hover-class="button-hover" bindtap="{{canTransition && !busy ? 'onTransition' : ''}}">{{nextPhaseLabel || '这一步现在还不能做'}}</view>
        <!-- 门槛不满足时先说清缺什么、去哪儿补，而不是给一个点不动的灰按钮 -->
        <text wx:if="{{!canTransition && transitionHint}}" class="small muted" style="display:block;">为什么现在不能推进：{{transitionHint}}</text>
        <text wx:elif="{{!canTransition}}" class="small muted" style="display:block;">这一阶段没有可推进的下一步；已归档或已取消的活动只读。</text>
        <view wx:if="{{canEdit}}" class="button text" hover-class="button-hover" bindtap="goEdit">编辑活动</view>
      </view>
      <!-- 取消是破坏性动作，降级为文字入口；真正的危险确认留在弹层里 -->
      <view wx:if="{{canCancel}}" class="button text" hover-class="button-hover" bindtap="{{busy ? '' : 'onTransition'}}" data-next="cancelled">取消这场活动（仅出发前可作废）</view>

      <view class="button secondary block" hover-class="button-hover" bindtap="goDetail">以参与者视角查看活动</view>
      <view wx:if="{{message}}" class="callout success">{{message}}</view>
    </block>
  </view>

  <overlay open="{{transitionOpen}}" kind="dialog" title="{{transitionTitle}}" bind:close="onTransitionClose">
    <view class="stack">
      <text>阶段变更会影响报名与现场操作。未处理的出发去向、车辆或安全事项可能阻止变更。</text>
      <form-field label="变更原因" hint="请明确说明本次阶段变更的依据。">
        <textarea class="textarea" value="{{reason}}" maxlength="2000" bindinput="onReason" />
      </form-field>
      <view wx:if="{{error}}" class="callout danger">{{error}}</view>
      <view class="button {{transitionDanger ? 'danger' : 'primary'}} block {{!reason || busy ? 'disabled' : ''}}" hover-class="button-hover" bindtap="{{!reason || busy ? '' : 'onTransitionConfirm'}}">确认变更，不跳过检查</view>
    </view>
  </overlay>
</view>

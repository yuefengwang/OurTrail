/* OurTrail 设计系统 · 由原型 tokens.css / base.css / components.css 移植
   —— color-mix() 已预算为字面量色值；:root → page；dvh 不用 */

page {
  --forest: #163E35;
  --leaf: #D6EA8A;
  --paper: #F5F5F0;
  --white: #FFFFFF;
  --ink: #202A26;
  --muted: #5F6E66;
  --line: #DEE3DB;
  --danger: #B43D3B;
  --warning: #8C5A12;
  --info: #346583;
  --success: #276145;

  /* 天相窗口色 —— 从 components/meteogram/layout.js 的 MARK_STYLE 提升而来。
     此前这两个值只活在 meteogram 的 canvas 字面量色板里，canvas 拿不到 var()，
     于是 WXML 侧（结论卡/徽标/图例）无法引用，只能再抄一份或干脆不用。
     改色必须同步 MARK_STYLE，否则图上标记与页面文字会分叉。 */
  --golden: #D6A33C;      /* 黄金 / 晚霞窗口 */
  --blue-hour: #6C7C93;    /* 蓝调时刻 */

  /* Weather V2 图例 swatch 色 —— 从 utils/meteogram-svg.js 的 C 色板与
     utils/cloud-field-svg.js 的 BANDS 提升而来：SVG 拿不到 var() 只能双写。
     改色必须同步两处字面量，否则图例色块与图上标记分叉（同 --golden 先例）。 */
  --chart-showers: #2E8B8B;                     /* 阵雨柱（C.showers） */
  --chart-wind: #3D8A7F;                        /* 风速曲线（C.wind） */
  --chart-gust: #9FC4D8;                        /* 阵风曲线（C.gust） */
  --chart-in-cloud: rgba(180, 118, 26, 0.65);   /* 琥珀段：此刻处于云中（C.inCloud） */
  --chart-ramp: linear-gradient(90deg, #eeeeea, #d4d6d0, #b0b2ab, #84867f, #5a5c56); /* 云量五档灰阶（= BANDS，3 测试 pin） */

  --surface: #FFFFFF;
  --forest-soft: #ECF0EF;      /* forest 8% + white */
  --success-soft: #EBF0EE;     /* success 9% + white */
  --warning-soft: #F4F0E9;     /* warning 9% + white */
  --danger-soft: #FAF1F1;      /* danger 7% + white */
  --info-soft: #F0F3F6;        /* info 8% + white */
  --on-forest-muted: #D0D8D7;  /* white 80% + forest 20% */
  --on-forest-line: #4E6C65;   /* white 24% + forest 76% */
  --control-line: #8C9791;     /* muted 72% + white 28% */
  /* 「--focus」已删（B-14）：全仓引用实测 0 次，小程序里没有 :focus-visible 宿主可吃这个描边色。
     将来真要聚焦环，先在 page 上重新登记并在 design-system.md 同步，不要拿同值的 --info 冒充它。 */
  --leaf-on-forest: #2D533F;   /* leaf 12% + forest */

  --text-caption: 12px;
  --text-body: 14px;
  --text-input: 16px;
  --text-title: 18px;

  --radius-tag: 5px;
  --radius-button: 8px;
  --radius-card: 14px;
  --radius-sheet: 20px;
  --touch-target: 44px;
  --action-height: 48px;
  --motion: 180ms;

  background: var(--paper);
  color: var(--ink);
  font-size: var(--text-body);
  line-height: 22px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 页面骨架与节奏 ---------- */
.page {
  padding: 24px 20px 32px;
  box-sizing: border-box;
  min-height: 100vh;
}
.page.has-sticky { padding-bottom: 120px; }
/* Tab 页底部留白为什么**不在这里**（B4-PAD，2026-10-16；规则全文见 design-system.md「Tab 页底部留白（唯一规则）」）：
   上面这条 .page 的 32px 是**所有页面**的基线，而 tab 页要多让出一截固定 tabBar 的高度。
   ① 不能把那份多让的宽度写进本表的 .page——app.wxss 对 20 个页面全局生效，会把 16 个子页一起吃进去
      （凭空多出约 84px 空白 = M-18 / E-03 那个缺陷的放大版）；
   ② 收成一条类规则（如 .page.with-tabbar）需要 4 个 tab 页根节点都挂上它 ⇒ 要改 4 份 wxml，
      而 home 现有的那个条件类是「有卡片才挂」，home 是 tab 页、tabBar 与卡片数量无关 ⇒ 空状态那一支会失去留白
      （判据 tools/b4-pad-final-value-test.js §7 方向 B-2 实测就是红的）；home.wxml:1 因此是个不产生任何样式的假开关，
      删除动作归页面 owner（本表不替它补定义）；
   ③ 收成 token 违反「不新增 token」（AGENTS.md 铁律 17），把样式文件按路径整体引进来（wxss 的文件级 import）
      被 swx2 的解析器围栏判据挡着（它见到那种语法就要求先升级解析器，不许静默误判）。
   ⇒ 四条 tab 页各自在自己的 wxss 里带这一行（载体），「单一真值源」由那条登记规则 + 判据保证：
      四份必须互相同构、必须等于注册表那一行、非 tab 页必须一份都不带。本表的 .page 基线保持 32px 不动。 */
.page-title {
  font-size: 28px;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -0.6px;
}
.stack { display: flex; flex-direction: column; gap: 16px; }
.stack-gap3 { display: flex; flex-direction: column; gap: 12px; }
.cluster { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.card {
  padding: 16px;
  border-radius: var(--radius-card);
  background: var(--surface);
}
.card-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 12px; }
.section-title { font-size: var(--text-input); line-height: 24px; font-weight: 600; color: inherit; }
.eyebrow { font-size: var(--text-caption); line-height: 18px; font-weight: 600; letter-spacing: 0.72px; color: var(--muted); }
.muted { color: var(--muted); }
.small { font-size: var(--text-caption); line-height: 18px; }
.divider { border: 0; border-top: 1px solid var(--line); margin: 16px 0; width: 100%; }
.icon { display: inline-block; flex: 0 0 auto; }
image.icon { vertical-align: middle; }
.tabular { font-variant-numeric: tabular-nums; }

/* ---------- 按钮 ---------- */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: var(--action-height);
  max-width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius-button);
  background: var(--surface);
  color: var(--forest);
  font-weight: 600;
  font-size: var(--text-body);
  line-height: 22px;
  text-align: center;
  box-sizing: border-box;
}
.button::after { border: none; }
.button.primary { background: var(--forest); border-color: var(--forest); color: var(--white); }
.button.secondary { background: var(--forest-soft); border-color: transparent; color: var(--forest); }
.button.danger { color: var(--danger); border-color: var(--danger); background: var(--surface); }
.button.text { border-color: transparent; background: transparent; padding-left: 8px; padding-right: 8px; }
.button.leaf { background: var(--leaf); color: var(--forest); border-color: var(--leaf); }
.button.block { display: flex; width: 100%; }
/* 禁用态：先兜底，再按变体分别定义（B-11；强制修复顺序对 2 的前项，后项是 B-12）。
   下一条通用规则当初是按「有底色的按钮」写的，它同特异度 (0,2,0) 又写在
   .button.primary/.secondary/.danger/.text/.leaf 之后 ⇒ 把五个变体一起压成灰底灰边。
   对实底族这是对的（变灰退后）；对 .text 就是权重倒挂：一条本来透明的文字链，
   禁用后反而长出灰底 + 灰边，比它可点时更抢眼（activity L286 / editor L15 /
   roster L69 / transport L133 四处，busy 与条件不满足时都会闪成灰块）。
   所以现在把每个变体的禁用表达写出来，通用规则退为「没有变体时的兜底」：
   · 实底族（primary/secondary/danger/leaf）→ 底色与描边一起退到 --line、文字退到 --muted，
     终值与兜底逐字相同 ⇒ 本轮像素只允许 .text 一族变化，其余四族一格都不动（由判据证）；
   · 文字族（text）→ 禁用后仍然没有底色、没有描边，只把文字从 --forest 降到 --muted。
   两族共用 --muted 这一支禁用文字色：单源是 token 本身（按引用读 var()，不抄字面量），
   影子改写 --line/--muted 必须整族一起动——见 tools/style-semantics-test.js §6。
   边界：禁用族只许声明 background/border-color/color。按压反馈（hover 闪烁、
   pointer-events）属 C-16，本轮不并入；opacity 也不能用在这里——它既会连带改掉
   .button-hover 的按压反馈，又会把 --muted 文字压到 3:1 以下（design-system 已写明
   「--muted 4.6:1 勿再调淡」，B-13 正是低对比文字的判例）。 */
.button.disabled, .button[disabled] { background: var(--line); border-color: var(--line); color: var(--muted); }
.button.primary.disabled, .button.primary[disabled] { background: var(--line); border-color: var(--line); color: var(--muted); }
.button.secondary.disabled, .button.secondary[disabled] { background: var(--line); border-color: var(--line); color: var(--muted); }
.button.danger.disabled, .button.danger[disabled] { background: var(--line); border-color: var(--line); color: var(--muted); }
.button.leaf.disabled, .button.leaf[disabled] { background: var(--line); border-color: var(--line); color: var(--muted); }
.button.text.disabled, .button.text[disabled] { background: transparent; border-color: transparent; color: var(--muted); }
.button-hover { opacity: 0.82; }
button.button { font-family: inherit; }
.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--touch-target);
  height: var(--touch-target);
  border-radius: var(--radius-button);
  color: var(--forest);
}
.form-actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
.form-actions .button { flex: 1 1 120px; }
.sticky-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  background: var(--surface);
  padding: 12px 20px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--line);
}
.sticky-action .button { flex: 1; }

/* ---------- 状态：色相只是辅助，文字才是主体 ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  max-width: 100%;
  padding: 2px 8px;
  border-radius: var(--radius-tag);
  font-size: var(--text-caption);
  line-height: 18px;
  font-weight: 600;
  vertical-align: middle;
}
.badge.success { color: var(--success); background: var(--success-soft); }
.badge.warning { color: var(--warning); background: var(--warning-soft); }
.badge.danger { color: var(--danger); background: var(--danger-soft); }
.badge.info { color: var(--info); background: var(--info-soft); }
.badge.neutral { color: var(--muted); background: var(--paper); }
.callout {
  padding: 12px 16px;
  border-radius: var(--radius-button);
  border-left: 3px solid var(--info);
  background: var(--info-soft);
  color: var(--info);
  box-sizing: border-box;
}
.callout.warning { border-color: var(--warning); background: var(--warning-soft); color: var(--warning); }
.callout.danger { border-color: var(--danger); background: var(--danger-soft); color: var(--danger); }
.callout.success { border-color: var(--success); background: var(--success-soft); color: var(--success); }
.callout-title { font-weight: 600; }
.callout p { margin-top: 4px; }
.notice-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
  background: var(--surface);
  border-radius: var(--radius-card);
}
.notice-card.unread { border-left: 3px solid var(--forest); }

/* ---------- 精选活动卡：森林底 + 等高线 ---------- */
.hero {
  position: relative;
  overflow: hidden;
  padding: 20px;
  background: var(--forest);
  border: 1px solid var(--forest);
  border-radius: var(--radius-card);
  color: var(--white);
}
.hero .muted, .hero .eyebrow { color: var(--on-forest-muted); }
.hero .divider { border-color: var(--on-forest-line); }
.activity-card { position: relative; display: flex; flex-direction: column; gap: 12px; }
.activity-card__header { align-items: flex-start; }
.activity-card__date { color: var(--muted); padding-top: 2px; padding-bottom: 2px; }
/* M-16：活动标题由组织者自由输入（editor.wxml maxlength=100）。标题是必须读完的语义信息，
   所以策略是「断行」而不是 ellipsis 截断（与 .picker .picker-value 那种有展开兜底的场景不同）。
   featured 变体只覆盖 font-size/line-height/letter-spacing，按属性层叠不会把这句擦掉 —— §3 有专门一条验证。 */
.activity-card__title { font-size: var(--text-title); line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }
.activity-card__info { padding-top: 16px; border-top: 1px solid var(--line); }
.activity-card__affordance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--forest);
  font-size: var(--text-caption);
  font-weight: 600;
}
.activity-card--featured { gap: 16px; padding: 20px; }
.activity-card--featured .activity-card__title { font-size: 26px; line-height: 1.35; letter-spacing: -0.5px; }
.activity-card--featured .activity-card__date { color: var(--on-forest-muted); }
.badge.on-forest { color: var(--leaf); background: var(--leaf-on-forest); }
.activity-card--featured .activity-card__info { border-color: var(--on-forest-line); }
.activity-card--featured .activity-card__affordance { justify-content: space-between; }
.trail-art {
  position: absolute;
  width: 58%;
  height: 100%;
  right: -8%;
  top: 0;
  opacity: 0.22;
  pointer-events: none;
}
.hero > .hero-body { position: relative; }

/* ---------- 分段与指标 ---------- */
.segmented {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 4px;
  border-radius: var(--radius-button);
  background: var(--line);
}
.segmented .seg {
  flex: 1;
  /* M-06：这里曾是全站唯一把触控高度写死字面量（36px）的尺寸规则，与 page 上的 --touch-target 脱节，
     于是「规范 44px / 实现 36px」长期分叉，补救只落在 weather-chart 一页。取 token 而不写数，
     影子调 --touch-target 时这里必须跟着动（判据 tools/swx1-style-gates-test.js §1）。 */
  min-height: var(--touch-target);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 6px;
  border-radius: var(--radius-tag);
  /* M-06：未选中态原来是 --muted 压在 --line 轨道上（#5F6E66 / #DEE3DB = 4.12:1），
     12px 属正文、不适用大字放宽，未过仓库自家 4.5:1 门槛。改用正文主色 --ink（11.3:1），
     「选中」的区分线索由 .seg.on 的白底药丸 + --forest + 600 字重承担（不靠把未选中印淡）。 */
  color: var(--ink);
  font-size: var(--text-caption);
  line-height: 18px;
  text-align: center;
}
.segmented .seg.on { background: var(--surface); color: var(--forest); font-weight: 600; }
.metrics { display: flex; gap: 12px; }
.metric { flex: 1; min-width: 0; }
/* M-16：26px 大数字 + letter-spacing -0.6px，在 route 详情的四列布局下每列只有约 67px，
   四位以上的爬升米数会压到相邻列（`.metric` 的 min-width:0 允许列被压到内容宽以下 ⇒ 溢出不撑宽而是糊到邻格）。
   这里用 overflow-wrap: anywhere 而不是 ellipsis：指标数字是被读的事实，截成「125…」等于把数据藏起来；
   anywhere 只在真的放不下时才断，且会算进 min-content（break-word 不会，flex 子里等于不断）。
   列数/字号的取舍属视觉判读，见 out/SWX1/requests.md。 */
.metric .metric-value { display: block; color: var(--forest); font-size: 26px; line-height: 1.3; letter-spacing: -0.6px; font-weight: 600; overflow-wrap: anywhere; }
.metric .metric-unit { font-size: var(--text-caption); letter-spacing: 0; font-weight: 400; margin-left: 4px; }
.metric .metric-label { display: block; color: var(--muted); font-size: var(--text-caption); line-height: 18px; margin-top: 4px; }
.hero .metric .metric-value { color: var(--white); }
.hero .metric .metric-label { color: var(--on-forest-muted); }

/* ---------- 表单 ---------- */
.field { display: flex; flex-direction: column; gap: 8px; }
.field-label { font-size: 13px; line-height: 18px; font-weight: 400; color: var(--muted); }
.input, .textarea {
  width: 100%;
  min-height: var(--action-height);
  padding: 12px 0;
  border: none;
  border-bottom: 1px solid var(--control-line);
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: var(--text-input);
  line-height: 24px;
  box-sizing: border-box;
}
.input-placeholder, .textarea-placeholder { color: var(--muted); opacity: 1; }
.textarea {
  min-height: 120px;
  padding: 12px;
  border-bottom: none;
  border-radius: var(--radius-button);
  background: var(--paper);
}
.textarea.slim { min-height: 72px; }
.field-error { color: var(--danger); font-size: var(--text-caption); line-height: 18px; }
.field-hint { color: var(--muted); font-size: var(--text-caption); line-height: 18px; }
.field.invalid .input, .field.invalid .textarea { border-color: var(--danger); }
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--action-height);
  padding: 12px 0;
  border-bottom: 1px solid var(--control-line);
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  font-size: var(--text-input);
  box-sizing: border-box;
}
.picker .picker-value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker .picker-arrow { color: var(--muted); margin-left: 8px; }
.picker.placeholder .picker-value { color: var(--muted); }
.check-label {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-height: var(--touch-target);
  padding-top: 12px;
  padding-bottom: 12px;
}
.check-label checkbox, .check-label switch { flex: 0 0 auto; margin-top: 1px; }
/* 勾选框由 checkbox-group 承载 change 时，group 是 .check-label 的直接 flex 子元素，行为与裸 checkbox 一致 */
.check-label checkbox-group { flex: 0 0 auto; margin-top: 1px; }
.check-label .check-text { flex: 1; min-width: 0; }
.radio-label { display: flex; align-items: center; gap: 12px; min-height: var(--touch-target); }

/* ---------- 人员与运营列表：一人一行，不嵌套卡片 ---------- */
.person-list { display: block; }
.person-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.person-row:last-child { border-bottom: 0; }
.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--forest-soft);
  color: var(--forest);
  font-size: var(--text-input);
  font-weight: 600;
}
.person-row__body { flex: 1; min-width: 0; }
.person-row__heading { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
/* M-16：姓名由用户自由输入（me.wxml 的同行人/紧急联系人姓名 maxlength=80），一个无空格的拉丁长串
   在默认 word-break: normal 下不会在词内断，而 flex 项的 min-width:auto 取 min-content ——
   overflow-wrap: break-word 不改变 min-content，所以只有 anywhere 能真的把这一行收住（判据 §3）。
   中文姓名本来就逐字可断，加这一句不改变中文表现（对拍见 handoff，中文对照组零变化）。 */
.person-row__heading .person-name { font-weight: 600; margin-right: auto; overflow-wrap: anywhere; }
.person-row__body .person-subtitle { margin-top: 4px; }
.person-row__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 16px;
  padding-bottom: 16px;
  min-height: var(--action-height);
  width: 100%;
  border-bottom: 1px solid var(--line);
  text-align: left;
  box-sizing: border-box;
}
.list-row:last-child { border-bottom: 0; }
.list-row .list-main { flex: 1; min-width: 0; }
.list-row .list-sub { display: block; color: var(--muted); font-size: var(--text-caption); line-height: 18px; margin-top: 4px; }

/* 快捷估算 chips（编辑器时间估算等） */
.chip {
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--forest-soft);
  color: var(--forest);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 18px;
}

/* ---------- 路线地图 ---------- */
/* map 是原生组件：低版本基础库非同层渲染时圆角可能失效，属可接受降级（不做 cover-view 补偿） */
.map-card { height: 260px; border-radius: 14px; overflow: hidden; background: var(--forest-soft); }
.map-canvas { width: 100%; height: 100%; }

/* ---------- 时间轴 ---------- */
.timeline { padding-left: 20px; border-left: 1px solid var(--line); }
.timeline-item { position: relative; padding-bottom: 20px; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-item::before {
  content: "";
  position: absolute;
  left: -25px;
  top: 8px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--forest);
}
.timeline-item .timeline-time { color: var(--muted); font-size: var(--text-caption); }

/* ---------- 座位示意：2 + 过道 + 2 ---------- */
.seat-grid { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 16px; padding-bottom: 16px; }
.seat {
  width: calc((100% - 48px) / 4);
  min-height: var(--action-height);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 8px 4px;
  border: 1px solid var(--control-line);
  border-radius: var(--radius-button);
  background: var(--paper);
  color: var(--muted);
  font-size: var(--text-caption);
  line-height: 18px;
  text-align: center;
  box-sizing: border-box;
}
.seat.aisle { border: none; background: transparent; flex: 0 0 16px; width: 16px; padding: 0; }
.seat.occupied { background: var(--forest-soft); border-color: var(--forest); color: var(--forest); }
.seat.selected { background: var(--forest); border-color: var(--forest); color: var(--white); }

/* ---------- 边缘状态 ---------- */
.empty-state {
  padding: 32px 20px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-card);
  background: var(--surface);
}
.status-panel { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
.status-panel__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--action-height);
  height: var(--action-height);
  color: var(--forest);
  background: var(--forest-soft);
  border-radius: var(--radius-card);
}
.status-panel--error { border-style: solid; border-color: var(--danger); }
.status-panel--error .status-panel__icon { color: var(--danger); background: var(--danger-soft); }
.status-panel--denied .status-panel__icon, .status-panel--offline .status-panel__icon { color: var(--warning); background: var(--warning-soft); }
.status-skeleton { display: flex; flex-direction: column; gap: 8px; width: 100%; }
.status-skeleton .sk { height: 8px; background: var(--line); border-radius: var(--radius-tag); }
.status-skeleton .sk:nth-child(2) { width: 65%; }
.status-skeleton .sk:nth-child(3) { width: 82%; }

/* ---------- 自定义底部导航：这里不再定义 ----------
   E-12：这一段曾与 custom-tab-bar/index.wxss 各写一份同名的 tabbar / tab / tab.on（一份 var() 版、
   一份字面量版），而 index.js 声明了 styleIsolation: 'apply-shared' ⇒ app.wxss 会注入组件内部，
   于是「按规范写成自包含字面量」的那份被更高特异度的全局版压住 —— 与 platform-pitfalls §1 的例外条款
   （tabbar 必须完全自包含、颜色写字面量）正好相反。全仓 class 里带 tabbar 字样的只有 custom-tab-bar
   自己的根节点与 home 页的 with-tabbar（那是另一个类，不是这一族），所以全局这份只服务那一个组件
   ⇒ 真值源收敛回 index.wxss 一处。两边取值原本逐项相等（44px/#5F6E66/12px/8px/#FFFFFF/#DEE3DB/
   #163E35/#ECF0EF），删除不改变终值；判据 tools/swx1-style-gates-test.js §2 逐属性比「收敛后的终值
   集合 == 组件自包含那份」且「每个赢家声明的来源都是 index.wxss」，来源不对即红（值巧合相同也不算通过）。
   「tabbar-safe」（页面底部占位类，全仓 wxml/js 引用实测 0 次）随 B-14 一并删除：
   tab 页的底部留白一直写在各页 .page 的 padding-bottom 公式里，从来不靠这个类。 */

/* ---------- 其它 ---------- */
.progress { display: block; width: 100%; height: 4px; border-radius: var(--radius-tag); background: var(--line); overflow: hidden; }
.progress .progress-bar { display: block; height: 100%; background: var(--forest); }
.fieldset {
  min-width: 0;
  margin: 0;
  padding: 16px;
  border-radius: var(--radius-card);
  background: var(--surface);
}
.legend { padding: 0 8px; font-weight: 600; }
.code-text {
  font-family: Menlo, Consolas, monospace;
  font-size: var(--text-caption);
  background: var(--forest-soft);
  color: var(--forest);
  border-radius: var(--radius-tag);
  padding: 2px 6px;
}

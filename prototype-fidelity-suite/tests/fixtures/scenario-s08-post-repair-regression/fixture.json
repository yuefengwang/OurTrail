{
  "id": "s08-post-repair-regression",
  "class": "post-repair-regression",
  "adversarial": true,
  "purpose": "一次有界修复把已定位的漂移改回原型值后必须复验通过，且邻居区（r-value / r-note）前后都 PASS；反过来，两种“看起来能修好”的修法——锚点不唯一、以及修好目标却改坏邻居——都必须被拒绝或逐字节回滚，绝不能留下一个更绿的数。",
  "requires": [
    "playwright"
  ],
  "steps": [
    {
      "run": [
        "verify",
        "--project",
        ".",
        "--page",
        "s08-page",
        "--run",
        "base"
      ],
      "expectExit": 1,
      "captureStdout": "base.stdout.txt"
    },
    {
      "run": [
        "repair",
        "--project",
        ".",
        "--plan",
        "repair.json",
        "--page",
        "s08-page",
        "--state",
        "default",
        "--run",
        "repair"
      ],
      "expectExit": 0,
      "captureStdout": "repair.stdout.txt"
    },
    {
      "run": [
        "verify",
        "--project",
        ".",
        "--page",
        "s08-page",
        "--run",
        "after"
      ],
      "expectExit": 0,
      "captureStdout": "after.stdout.txt"
    },
    {
      "run": [
        "repair",
        "--project",
        ".",
        "--plan",
        "plan-ambiguous.json",
        "--page",
        "h-ambig",
        "--state",
        "default",
        "--run",
        "repair-ambig"
      ],
      "cwd": "harmful",
      "expectExit": 2,
      "captureStdout": "ambig.stdout.txt"
    },
    {
      "run": [
        "verify",
        "--project",
        ".",
        "--page",
        "h-ambig",
        "--run",
        "after-ambig"
      ],
      "cwd": "harmful",
      "expectExit": 1,
      "captureStdout": "ambig-verify.stdout.txt"
    },
    {
      "run": [
        "repair",
        "--project",
        ".",
        "--plan",
        "plan-shared.json",
        "--page",
        "h-broad",
        "--state",
        "default",
        "--run",
        "repair-broad"
      ],
      "cwd": "harmful",
      "expectExit": 1,
      "captureStdout": "broad.stdout.txt"
    },
    {
      "run": [
        "verify",
        "--project",
        ".",
        "--page",
        "h-broad",
        "--run",
        "after-broad"
      ],
      "cwd": "harmful",
      "expectExit": 1,
      "captureStdout": "broad-verify.stdout.txt"
    }
  ],

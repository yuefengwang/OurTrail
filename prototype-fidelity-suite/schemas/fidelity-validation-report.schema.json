{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ourtrail.local/prototype-fidelity/schemas/fidelity-validation-report.schema.json",
  "title": "fidelity-validation-report",
  "description": "The acceptance record: one verdict per dimension, the failures with their evidence, coverage, and the interaction result. There is no single similarity number; a critical failure cannot be offset by passing non-critical checks, and unmeasured dimensions make the verdict UNVERIFIED rather than PASS.",
  "type": "object",
  "required": ["schemaVersion", "kind", "pageId", "stateId", "generatedAt", "status", "reason", "scorecard", "interaction", "evidence", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
    "kind": { "const": "fidelity-validation-report" },
    "pageId": { "type": "string", "minLength": 1 },
    "stateId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "$ref": "#/definitions/status" },
    "reason": { "type": ["string", "null"] },
    "scorecard": { "$ref": "#/definitions/scorecard" },
    "interaction": {
      "type": "object",
      "required": ["checks", "fail", "unverified", "status"],
      "additionalProperties": false,
      "properties": {
        "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } },
        "fail": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/definitions/status" }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["PASS", "FAIL", "UNVERIFIED", "BLOCKED", "NOT_APPLICABLE"] },
    "counts": {
      "type": "object",
      "required": ["total", "pass", "fail"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["checks", "metrics", "verdict"],
      "additionalProperties": false,
      "properties": {
        "checks": { "$ref": "#/definitions/counts" },
        "metrics": { "type": "object" },
        "verdict": { "$ref": "#/definitions/status" }
      }
    },
    "failingStyle": {
      "type": "object",
      "required": ["prop", "a", "b"],
      "additionalProperties": false,
      "properties": {
        "prop": { "type": "string", "minLength": 1 },
        "a": {},
        "b": {},
        "delta": { "type": ["number", "null"] }
      }
    },
    "failure": {
      "type": "object",
      "required": ["pairId", "role", "criticality", "categories", "failingStyles", "notes"],
      "additionalProperties": false,
      "properties": {
        "pairId": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "criticality": { "enum": ["critical", "normal"] },
        "categories": { "type": "array", "items": { "type": "string" } },
        "geometry": { "type": ["object", "null"] },
        "failingStyles": { "type": "array", "items": { "$ref": "#/definitions/failingStyle" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "scorecard": {
      "type": "object",
      "required": ["schemaVersion", "generatedAt", "dimensions", "criticalFailures", "nonCriticalFailures", "budget", "coverage", "verdict"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "dimensions": {
          "type": "object",
          "required": ["geometry", "typography", "appearance"],
          "additionalProperties": false,
          "properties": {
            "geometry": { "$ref": "#/definitions/dimension" },
            "typography": { "$ref": "#/definitions/dimension" },
            "appearance": { "$ref": "#/definitions/dimension" },
            "state": { "$ref": "#/definitions/dimension" },
            "interaction": { "$ref": "#/definitions/dimension" },
            "provenance": { "$ref": "#/definitions/dimension" }
          }
        },
        "categories": {
          "type": "object",
          "description": "Per comparison category: which dimension owns it and how many records failed. A category absent here never appeared; a category with no owner would land in coverage.unownedCategories instead.",
          "additionalProperties": {
            "type": "object",
            "required": ["dimension", "fail"],
            "additionalProperties": false,
            "properties": {
              "dimension": { "enum": ["geometry", "typography", "appearance"] },
              "fail": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "criticalFailures": { "type": "array", "items": { "$ref": "#/definitions/failure" } },
        "nonCriticalFailures": { "type": "array", "items": { "$ref": "#/definitions/failure" } },
        "budget": {
          "type": "object",
          "required": ["criticalFailures", "nonCriticalFailures"],
          "additionalProperties": false,
          "properties": {
            "criticalFailures": { "type": "integer", "minimum": 0 },
            "nonCriticalFailures": { "type": "integer", "minimum": 0 }
          }
        },
        "coverage": {
          "type": "object",
          "required": ["pairsDeclared", "criticalPairs", "pairsMeasured", "pairsUnverified", "notApplicable", "missingOnTarget", "missingOnPrototype", "pixelsCompared"],
          "additionalProperties": false,
          "properties": {
            "pairsDeclared": { "type": "integer", "minimum": 0 },
            "criticalPairs": { "type": "integer", "minimum": 0 },
            "pairsMeasured": { "type": "integer", "minimum": 0 },
            "pairsUnverified": { "type": "integer", "minimum": 0 },
            "notApplicable": { "type": "integer", "minimum": 0 },
            "missingOnTarget": { "type": "integer", "minimum": 0 },
            "missingOnPrototype": { "type": "integer", "minimum": 0 },
            "pixelsCompared": { "type": "integer", "minimum": 0 },
            "unownedCategories": {
              "type": "array",
              "description": "Categories that reached the overall verdict but belong to no dimension. Honest coverage gap; the suite requires this to be empty.",
              "items": { "type": "string" }
            }
          }
        },
        "verdict": { "$ref": "#/definitions/status" }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "observed": { "type": ["string", "null"] }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ourtrail.local/prototype-fidelity/schemas/adapter.schema.json",
  "title": "adapter-descriptor",
  "description": "What a capture adapter can and cannot measure, and what it needs from outside the repository. Capability values are a closed vocabulary on purpose: a platform that reports a value this suite does not understand is a bug to fix, not a case to tolerate. Every entry in `limitations` must have a matching heading in the adapter's LIMITATIONS.md.",
  "type": "object",
  "required": [
    "schemaVersion", "id", "platform", "captureModule", "interactionDriver",
    "runtime", "endpoint", "capabilities", "coordinates", "selectors",
    "limitations", "limitationsDoc"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
    "id": { "$ref": "#/definitions/slug" },
    "platform": { "$ref": "#/definitions/slug" },
    "title": { "type": "string", "minLength": 1 },
    "captureModule": { "type": "string", "pattern": "^[a-z0-9._/-]+\\.js$" },
    "interactionDriver": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "required": ["name", "resolvedBy", "outsideRepo"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "versionTested": { "type": ["string", "null"] },
        "resolvedBy": { "type": "string", "pattern": "^env\\.detect[A-Z][A-Za-z]*$" },
        "outsideRepo": { "type": "boolean" },
        "installHint": { "type": "string", "minLength": 1 }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["url", "websocket", "none"] },
        "default": { "type": ["string", "null"] },
        "configKey": { "type": ["string", "null"] }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "nodeTree", "text", "lineCount", "computedStyles",
        "screenshot", "elementScreenshot", "screenshotScale", "injection"
      ],
      "additionalProperties": false,
      "properties": {
        "nodeTree": { "enum": ["dom-tree", "flat-per-selector"] },
        "text": { "enum": ["leaf-text", "concatenated"] },
        "lineCount": { "enum": ["measured", "inferred", "none"] },
        "computedStyles": { "enum": ["dom-cssom", "element-api", "none"] },
        "screenshot": { "enum": ["page", "element"] },
        "elementScreenshot": { "type": "boolean" },
        "screenshotScale": { "enum": ["one", "measured"] },
        "injection": { "enum": ["evaluate", "page.setData", "none"] }
      }
    },
    "coordinates": {
      "type": "object",
      "required": ["basis", "derivation"],
      "additionalProperties": false,
      "properties": {
        "basis": { "enum": ["viewport-css-px", "document-css-px"] },
        "derivation": { "type": "string", "minLength": 1 }
      }
    },
    "selectors": {
      "type": "object",
      "required": ["dialect", "hierarchyDiscovery"],
      "additionalProperties": false,
      "properties": {
        "dialect": { "enum": ["css", "automator"] },
        "hierarchyDiscovery": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/limitationId" }
    },
    "limitationsDoc": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.md$" }
  },
  "definitions": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "limitationId": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
    }
  }
}

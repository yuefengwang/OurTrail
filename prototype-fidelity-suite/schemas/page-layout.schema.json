{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ourtrail.local/prototype-fidelity/schemas/page-layout.schema.json",
  "title": "page-layout",
  "description": "Supporting artifact: ordered page sections with measured boxes and the inferred vertical rhythm between them. Gaps are inferred from two measured rects, so their provenance says so.",
  "type": "object",
  "required": ["schemaVersion", "kind", "pageId", "stateId", "generatedAt", "sections", "rhythm"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
    "kind": { "const": "page-layout" },
    "pageId": { "type": "string", "minLength": 1 },
    "stateId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sections": { "type": "array", "items": { "$ref": "#/definitions/section" } },
    "rhythm": { "type": "array", "items": { "$ref": "#/definitions/gap" } }
  },
  "definitions": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["PASS", "FAIL", "UNVERIFIED", "BLOCKED", "NOT_APPLICABLE"] },
    "source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": { "enum": ["measured", "inferred", "confirmed", "unknown"] },
        "captureNode": { "type": "string" }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "selector", "status", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "selector": { "type": "string", "minLength": 1 },
        "rect": { "$ref": "#/definitions/rect" },
        "text": { "type": "string" },
        "styles": { "type": "object", "additionalProperties": { "type": "string" } },
        "status": { "$ref": "#/definitions/status" },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "gap": {
      "type": "object",
      "required": ["from", "to", "gap", "source"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "gap": { "type": "number" },
        "source": {
          "type": "object",
          "required": ["kind", "from"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "inferred" },
            "from": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}

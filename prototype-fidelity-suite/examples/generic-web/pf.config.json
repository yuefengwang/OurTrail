{
  "schemaVersion": "1.0.0",
  "project": {
    "id": "generic-web",
    "name": "通用 Web 基样（示例 1 · 卡片页）"
  },
  "prototype": {
    "adapter": "web",
    "viewport": {
      "width": 390,
      "height": 844
    },
    "frameSelector": "#device"
  },
  "target": {
    "adapter": "web",
    "frameSelector": "#device"
  },
  "tolerances": {
    "position": 1.5,
    "size": 1.5,
    "gap": 1,
    "font": 1,
    "color": 6,
    "pixelRatio": 0.02,
    "criticalPixelRatio": 0.005
  },
  "pages": [
    {
      "id": "specimen",
      "prototype": {
        "url": "prototype/index.html"
      },
      "target": {
        "url": "target/index.html"
      },
      "selectors": [
        "#toggle",
        "#note"
      ],
      "components": [
        {
          "id": "cell",
          "role": "specimen cell",
          "criticality": "critical",
          "selectors": [
            ".cell"
          ],
          "styleProps": [
            "padding",
            "border-radius",
            "background-color",
            "border-top-color",
            "width",
            "height"
          ]
        },
        {
          "id": "caption",
          "role": "cell caption",
          "selectors": [
            ".cap"
          ]
        },
        {
          "id": "probe",
          "role": "text probe",
          "selectors": [
            ".probe",
            ".probe-lh"
          ]
        }
      ],
      "sections": [
        {
          "id": "device",
          "role": "captured frame",
          "selector": "#device"
        },
        {
          "id": "title",
          "role": "page title",
          "selector": "#title"
        },
        {
          "id": "row-1",
          "role": "specimen row 1",
          "selector": "#ctrl-1"
        }
      ],
      "mappings": [
        {
          "id": "ctrl-1",
          "role": "对照 1",
          "prototypeSelector": "#ctrl-1",
          "targetSelector": "#ctrl-1",
          "criticality": "critical"
        },
        {
          "id": "ctrl-2",
          "role": "对照 2",
          "prototypeSelector": "#ctrl-2",
          "targetSelector": "#ctrl-2",
          "criticality": "critical"
        },
        {
          "id": "ctrl-3",
          "role": "对照 3",
          "prototypeSelector": "#ctrl-3",
          "targetSelector": "#ctrl-3",
          "criticality": "critical"
        },
        {
          "id": "ctrl-4",
          "role": "对照 4",
          "prototypeSelector": "#ctrl-4",
          "targetSelector": "#ctrl-4",
          "criticality": "critical"
        },
        {
          "id": "pos-8",
          "role": "位置 8px",
          "prototypeSelector": "#pos-8",
          "targetSelector": "#pos-8",
          "criticality": "normal"
        },
        {
          "id": "gap-4",
          "role": "间距 4px",
          "prototypeSelector": "#gap-4",
          "targetSelector": "#gap-4",
          "criticality": "normal"
        },
        {
          "id": "font-size",
          "role": "字号",
          "prototypeSelector": "#fs-label",
          "targetSelector": "#fs-label",
          "criticality": "normal"
        },
        {
          "id": "line-height",
          "role": "行高",
          "prototypeSelector": "#lh-label",
          "targetSelector": "#lh-label",
          "criticality": "normal"
        },
        {
          "id": "radius",
          "role": "圆角",
          "prototypeSelector": "#radius-box",
          "targetSelector": "#radius-box",
          "criticality": "normal"
        },
        {
          "id": "color",
          "role": "文字颜色",
          "prototypeSelector": "#color-label",
          "targetSelector": "#color-label",
          "criticality": "normal"
        },
        {
          "id": "crop",
          "role": "图片裁切",
          "prototypeSelector": "#crop-img",
          "targetSelector": "#crop-img",
          "criticality": "normal"
        },
        {
          "id": "wrap",
          "role": "换行",
          "prototypeSelector": "#wrap-text",
          "targetSelector": "#wrap-text",
          "criticality": "normal"
        }
      ],
      "states": [
        {
          "id": "default"
        }
      ],
      "interactions": [
        {
          "id": "toggle-note",
          "title": "点按钮后说明展开",
          "do": [
            {
              "tap": {
                "selector": "#toggle"
              }
            },
            {
              "wait": 150
            }
          ],
          "expect": {
            "textIncludes": {
              "selector": "#note",
              "text": "已展开"
            }
          },
          "screenshot": false
        }
      ],
      "acceptedDifferences": []
    },
